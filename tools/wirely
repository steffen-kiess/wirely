#!/usr/bin/env python3

import os
import sys
from pathlib import Path


def main():
    repository_root = Path(__file__).resolve().parent.parent
    venv_python = repository_root / 'venv' / 'bin' / 'python'
    if venv_python.is_file():
        python = str(venv_python)
    else:
        print('Warning: venv not found; run tools/setup-venv to install dependencies.',
              file=sys.stderr)
        python = sys.executable

    environment = os.environ.copy()
    python_path = environment.get('PYTHONPATH')
    environment['PYTHONPATH'] = str(repository_root)
    if python_path:
        environment['PYTHONPATH'] += os.pathsep + python_path
    os.execve(python, [python, '-m', 'wirely.__main__', *sys.argv[1:]], environment)


if __name__ == '__main__':
    main()
