// TODO: Don't depend on the ordering of Server / Provider
node Server : MQTT.Connection(URI="mqtt://localhost");

node ProviderInput : Std.DebugValueSource(Type = boolean);

node Provider : MQTT.ValueProvider(Topic = "test/t1", Type = boolean);
connect ProviderInput -> Provider;

// TODO: Allow this line to be above the declaration for Server and Provider and add tests for that
connect Server -> Provider.Broker;


node TemplateProviderInput : Std.DebugValueSource(Type = boolean);

node TemplateProvider : MQTT.ValueProvider(Topic = r"test/t1t", Type = boolean, Template = r#"{"value": %s, "other": "%s"}"#);
connect TemplateProviderInput -> TemplateProvider;

connect Server -> TemplateProvider.Broker;


node OptionProviderInput : Std.DebugValueSource(Type = Option[boolean]);

node OptionProvider : MQTT.ValueOptionProvider(Topic = "test/t2", Type = boolean);
connect OptionProviderInput -> OptionProvider;

connect Server -> OptionProvider.Broker;


node EventSource : Std.DebugEventSource(Type = boolean);

node EventEmitter : MQTT.EventEmitter(Topic = "test/t3", Type = boolean);
connect EventSource -> EventEmitter;

connect Server -> EventEmitter.Broker;


node StringEventSource : Std.DebugEventSource(Type = String);

node StringEventEmitter : MQTT.EventEmitter(Topic = "test/t4", Type = String);
connect StringEventSource -> StringEventEmitter;

connect Server -> StringEventEmitter.Broker;


node EnumEventSource : Std.DebugEventSource(Type = ThermostatSystemModeEnum);

node EnumEventEmitter : MQTT.EventEmitter(Topic = "test/t5", Type = ThermostatSystemModeEnum, Format = "SnakeCase");
connect EnumEventSource -> EnumEventEmitter;

connect Server -> EnumEventEmitter.Broker;


node TemplateEventSource : Std.DebugEventSource(Type = ThermostatSystemModeEnum);

node TemplateEventEmitter : MQTT.EventEmitter(Topic = "test/t5", Type = ThermostatSystemModeEnum, Format = "SnakeCase", Template = "{\"value\": %s, \"other\": \"%s\"}");
connect TemplateEventSource -> TemplateEventEmitter;

connect Server -> TemplateEventEmitter.Broker;


node EventReceiver : MQTT.EventReceiver(Topic = "test/t6", Type = boolean);
connect Server -> EventReceiver.Broker;

node EventReceiverPrnt : Std.DebugEventPrinter(Type = boolean);
connect EventReceiver -> EventReceiverPrnt;


// TODO: Actually use template here
node TemplateEventReceiver : MQTT.EventReceiver(Topic = "test/t7", Type = boolean);
connect Server -> TemplateEventReceiver.Broker;

node TemplateEventReceiverPrnt : Std.DebugEventPrinter(Type = boolean);
connect TemplateEventReceiver -> TemplateEventReceiverPrnt;
