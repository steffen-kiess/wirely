namespace ResourceFixture.Deep {
  node type Source {
    implicit output: resource Handle;
  }

  node type Sink {
    input Service: resource Handle;
  }

  node type Relay {
    input Service: resource Handle;
    implicit output: resource Handle;
    connect Service -> implicit output;

    node client: Sink;
    connect Service -> client.Service;
  }

  node type Factory {
    implicit output: resource Handle;
    node source: Source;
    connect source -> implicit output;
  }

  node type Many {
    input Services: list resource Handle;
  }

  singleton node type Shared {
    implicit output: resource Handle;
  }
}

namespace ResourceFixture {
  namespace Deep {
    resource type Handle;
  }

  node type OuterSink {
    input Service: resource Deep.Handle;
  }
}

namespace OtherResourceFixture {
  resource type Handle;
}

resource type RootHandle;

node type RootSource {
  implicit output: resource RootHandle;
}

node type RootSink {
  implicit input: resource RootHandle;
}
node root_source: RootSource;
node root_sink: RootSink;
connect root_source -> root_sink;

node source: ResourceFixture.Deep.Source;
node relay: ResourceFixture.Deep.Relay;
node sink: ResourceFixture.Deep.Sink;
connect source -> relay.Service;
connect relay -> sink.Service;

node factory: ResourceFixture.Deep.Factory;
node second_relay: ResourceFixture.Deep.Relay;
node second_sink: ResourceFixture.Deep.Sink;
connect factory -> second_relay.Service;
connect second_relay -> second_sink.Service;

node many: ResourceFixture.Deep.Many;
connect source, factory, relay -> many.Services;
node outer: ResourceFixture.OuterSink;
connect relay -> outer.Service;

node shared: ResourceFixture.Deep.Shared;
node shared_sink: ResourceFixture.Deep.Sink;
connect shared -> shared_sink.Service;
