node type Paths {
  parameter Joined: String = Path.Join("base", "child");
  parameter Relative: String = Path.Join("base", "../child");
  parameter EmptyBase: String = Path.Join("", "child");
  parameter EmptyPath: String = Path.Join("base", "");
  parameter BothEmpty: String = Path.Join("", "");
  parameter BareParent: String = Path.Parent("file.txt");
  parameter RelativeParent: String = Path.Parent("base/../child");
  parameter EmptyParent: String = Path.Parent("");
  parameter TrailingParent: String = Path.Parent("base/child/");
  parameter MissingParent: String = Path.Parent("nonexistent/directory/file");
  parameter Source: String = Path.SourceFile();
}
node paths: Paths {}
