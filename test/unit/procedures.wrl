namespace ProcedureTests {
  enum type Mode: uint8 { Off = 0, On = 1 }
  struct type Pair { enabled: boolean, number: uint8 }
  struct type Presence { value: Option[boolean] }

  node type OptionalConstant {
    optional parameter Enabled: boolean;
    default output: value Option[boolean];
    output Wrapped: value Presence;
    procedure run produces default output as output, Wrapped {
      output = parameter_option(Enabled);
      Wrapped = Presence { value: parameter_option(Enabled) };
    }
  }

  node type ConstantBlocks {
    parameter Text: String = "hello";
    default input: value boolean;
    default output: value boolean;
    output Number: value uint8;
    output Shifted: value uint8;
    output Saved: value uint8;
    output ReadBack: value uint8;
    output Matched: value uint8;
    output Selected: value uint8;

    procedure run
      depends on default input as input
      produces default output as output, Number, Shifted, Saved, ReadBack,
        Matched, Selected
    {
      "discarded";
      { let items: List[String] = ["discarded"]; }
      output = if input {
        let mut text: String = "before";
        { text = Text; }
        let text = text;
        text == "hello" && Path.Parent("folder/file") == "folder"
      } else {
        let items: List[uint8] = [1, 2];
        items == [2, 1]
      };
      Number = if input { 1 + 2 } else { 4 + 5 };
      let mut value: uint8 = Number;
      let saved = value;
      value = 10;
      Saved = saved;
      ReadBack = Number;
      Shifted = saved << { let count: uint8 = 1; count + 1 };
      Matched = if let Some(number) = Some(uint8.From(2)) {
        uint8.WrappingAdd(number, saved)
      } else { 0 };
      Selected = if true { uint8.CheckedFrom(3).Unwrap() } else { 1 / 0 };
    }
  }

  node type Select {
    parameter Enabled: boolean = true;
    parameter Fallback: boolean = false;

    default input: value boolean;
    default output: value boolean;

    procedure run
      depends on default input as input
      produces default output as output
    {
      let selected = input;
      let selected = if Enabled {
        let inverted = !selected;
        !inverted
      } else {
        Fallback
      };
      output = selected && !false || false;
    }
  }

  node type Delay {
    default input: value boolean;
    default output: value boolean;
    output Current: value boolean;
    state saved: boolean = false;

    procedure write depends on default input as input produces saved {
      saved = input;
    }
    procedure read
      depends on saved.old as previous
      produces default output as output
    {
      output = previous;
    }
    procedure read_new depends on saved.new as current produces Current {
      Current = current;
    }
  }

  node type Constants {
    parameter Enabled: boolean = true;
    parameter Number: uint8 = if Enabled { 7 } else { 0 };
    parameter Time: TimeOfDay = if Enabled { "08:00" } else { "09:00" };
    parameter ModeValue: Mode = Mode.On;
    parameter PairValue: Pair = Pair { enabled: true, number: 7 };

    default output: value boolean;
    output TimeValue: value TimeOfDay;
    output ModeEqual: value boolean;
    output UnitEqual: value boolean;
    output PairCopy: value Pair;

    procedure run
      produces default output as output, TimeValue, ModeEqual,
        UnitEqual, PairCopy
    {
      let number: uint8 = 7;
      let time: TimeOfDay = "08:00";
      let mode = Mode.On;
      let unit = ();
      output = 7 == number && Number != 0;
      TimeValue = if Enabled { time } else { Time };
      ModeEqual = mode == ModeValue;
      UnitEqual = unit == ();
      PairCopy = PairValue;
    }
  }

  node type Forward {
    parameter Type: ValueType;
    default input: value Type;
    default output: value Type;
    node inner: Std.TwoStageValueForward { Type: Type }
    connect default input -> inner;
    connect inner -> default output;
  }

  singleton node type Shared {
    default output: value boolean;
    procedure run produces default output as output { output = true; }
  }
}

node source: Std.DebugValueSource { Type: boolean }
node selected: ProcedureTests.Select {}
node fallback: ProcedureTests.Select { Enabled: false, Fallback: true }
node delayed: ProcedureTests.Delay {}
node constants: ProcedureTests.Constants {}
node constant_blocks: ProcedureTests.ConstantBlocks {}
node constant_source: Std.DebugValueSource { Type: boolean }
connect constant_source -> constant_blocks;
node optional_absent: ProcedureTests.OptionalConstant {}
node optional_present: ProcedureTests.OptionalConstant { Enabled: true }
node forwarded: ProcedureTests.Forward { Type: boolean }
node shared: ProcedureTests.Shared {}
node shared_again: ProcedureTests.Shared {}
connect source -> selected;
connect source -> fallback;
connect source -> delayed;
connect source -> forwarded;

node type Presence {
  parameter Type: ValueType;
  parameter Default: Type;
  default input: value Option[Type];
  output Present: value boolean;
  output Absent: value boolean;
  output Copy: value Option[Type];
  output Unwrapped: value Type;
  output Matched: value Type;
  output Ignored: value boolean;

  procedure run depends on default input as input
    produces Present, Absent, Copy, Unwrapped, Matched, Ignored
  {
    let value = input;
    let absent: Option[Type] = None;
    Present = { let copy = value; copy }.IsSome;
    Absent = (value).IsNone;
    Copy = if input.IsSome { value } else { absent };
    Unwrapped = input.UnwrapOr(Default);
    Matched = if let Some(value) = input { value } else { Default };
    Ignored = if let Some(_) = input { true } else { false };
  }
}

node option_source: Std.DebugValueSource { Type: Option[boolean] }
node nested_source: Std.DebugValueSource { Type: Option[Option[boolean]] }
node presence: Presence { Type: boolean, Default: true }
node nested_presence: Presence { Type: Option[boolean], Default: Some(true) }
connect option_source -> presence;
connect nested_source -> nested_presence;

node type Ordering {
  parameter Type: ValueType;
  parameter Limit: Type;
  default input: value Type;
  output Less: value boolean;
  output LessEqual: value boolean;
  output Greater: value boolean;
  output GreaterEqual: value boolean;

  procedure run depends on default input as input
    produces Less, LessEqual, Greater, GreaterEqual
  {
    Less = input < Limit;
    LessEqual = input <= Limit;
    Greater = input > Limit;
    GreaterEqual = if input >= Limit { true } else { false };
  }
}

node int_source: Std.DebugValueSource { Type: int16 }
node duration_source: Std.DebugValueSource { Type: Duration }
node time_source: Std.DebugValueSource { Type: TimeOfDay }
node int_ordering: Ordering { Type: int16, Limit: -1 }
node duration_ordering: Ordering { Type: Duration, Limit: "PT1S" }
node time_ordering: Ordering { Type: TimeOfDay, Limit: "08:00" }
connect int_source -> int_ordering;
connect duration_source -> duration_ordering;
connect time_source -> time_ordering;

node type Arithmetic {
  parameter Type: ValueType;
  parameter Step: Type;
  default input: value Type;
  output Wrapped: value Type;
  output Saturated: value Type;
  output Checked: value Option[Type];
  output Quotient: value Option[Type];
  output Fallback: value Type;

  procedure run depends on default input as input
    produces Wrapped, Saturated, Checked, Quotient, Fallback
  {
    let step = Step;
    Wrapped = Type.WrappingAdd(input, step);
    Saturated = Type.SaturatingSub(0, input);
    Checked = Type.CheckedMul(input, 2);
    Quotient = Type.CheckedDiv(100, input);
    Fallback = Type.CheckedMul(input, 2).UnwrapOr(Step);
  }
}

node int8_source: Std.DebugValueSource { Type: int8 }
node uint8_source: Std.DebugValueSource { Type: uint8 }
node int8_arithmetic: Arithmetic { Type: int8, Step: 1 }
node uint8_arithmetic: Arithmetic { Type: uint8, Step: 1 }
connect int8_source -> int8_arithmetic;
connect uint8_source -> uint8_arithmetic;

node type PendingOption {
  parameter Type: ValueType;
  parameter Default: Type;
  default input: value Option[Type];
  default output: value Type;
  temporary pending: Option[Type];

  procedure store depends on default input as input produces pending {
    pending = input;
  }
  procedure read depends on pending produces default output as output {
    output = pending.UnwrapOr(Default);
  }
}

node pending: PendingOption { Type: boolean, Default: true }
connect option_source -> pending;

node type PairFields {
  default input: value ProcedureTests.Pair;
  output Enabled: value boolean;
  output Next: value uint8;
  output Built: value ProcedureTests.Pair;
  output Wrapped: value Option[ProcedureTests.Pair];
  output Nested: value Option[Option[boolean]];

  procedure run depends on default input as input
    produces Enabled, Next, Built, Wrapped, Nested
  {
    Enabled = input.enabled;
    Next = uint8.SaturatingAdd(input.number, 1);
    let maybe = if input.enabled { Some(input.number) } else { None };
    Built = ProcedureTests.Pair { number: maybe.UnwrapOr(0), enabled: !input.enabled };
    Wrapped = Some(input);
    Nested = if input.number == 0 { None } else { Some(Some(input.enabled)) };
  }
}

node pair_source: Std.DebugValueSource { Type: ProcedureTests.Pair }
node pair_fields: PairFields {}
connect pair_source -> pair_fields;

node type Conversions {
  default input: value int16;
  output Wrapped: value int8;
  output Saturated: value int8;
  output Checked: value Option[int8];
  output Wide: value int32;
  output Level: value uint8;

  procedure run depends on default input as input
    produces Wrapped, Saturated, Checked, Wide, Level
  {
    Wrapped = int8.WrappingFrom(input);
    Saturated = int8.SaturatingFrom(input);
    Checked = int8.CheckedFrom(input);
    Wide = int32.From(input);
    let mode = if input > 0 { ProcedureTests.Mode.On } else { ProcedureTests.Mode.Off };
    Level = uint8.From(mode);
  }
}

node conversions: Conversions {}
connect int_source -> conversions;

node type DurationMath {
  default input: value Duration;
  input Factor: value uint32;
  output Sum: value Duration;
  output Difference: value Duration;
  output Scaled: value Option[Duration];
  output Divided: value Option[Duration];
  output FactorSecs: value Duration;
  output Millis: value uint64;

  procedure run depends on default input as span, Factor as factor
    produces Sum, Difference, Scaled, Divided, FactorSecs, Millis
  {
    Sum = Duration.SaturatingAdd(span, "PT1S");
    Difference = Duration.SaturatingSub(span, "PT1S");
    Scaled = Duration.CheckedMul(span, factor);
    Divided = Duration.CheckedDiv(span, factor);
    FactorSecs = Duration.FromSecs(factor);
    Millis = Duration.AsMillis(span);
  }
}

node span_source: Std.DebugValueSource { Type: Duration }
node factor_source: Std.DebugValueSource { Type: uint32 }
node duration_math: DurationMath {}
connect span_source -> duration_math;
connect factor_source -> duration_math.Factor;

node type TimeMath {
  default input: value TimeOfDay;
  output Later: value TimeOfDay;
  output Earlier: value TimeOfDay;
  output UntilEnd: value Duration;

  procedure run depends on default input as time produces Later, Earlier, UntilEnd {
    Later = TimeOfDay.WrappingAdd(time, "PT2H");
    Earlier = TimeOfDay.WrappingSub(time, "PT2H");
    UntilEnd = TimeOfDay.DurationUntil(time, "24:00");
  }
}

node time_math: TimeMath {}
connect time_source -> time_math;

node type MonotonicMath {
  default input: value MonotonicTime;
  input Other: value MonotonicTime;
  input Span: value Duration;
  output Later: value MonotonicTime;
  output Earlier: value MonotonicTime;
  output CheckedLater: value Option[MonotonicTime];
  output CheckedEarlier: value Option[MonotonicTime];
  output Elapsed: value Option[Duration];
  output Less: value Option[boolean];

  procedure run depends on default input as time, Other as other, Span as span
    produces Later, Earlier, CheckedLater, CheckedEarlier, Elapsed, Less
  {
    Later = MonotonicTime.SaturatingAdd(time, span);
    Earlier = MonotonicTime.SaturatingSub(time, span);
    CheckedLater = MonotonicTime.CheckedAdd(time, span);
    CheckedEarlier = MonotonicTime.CheckedSub(time, span);
    Elapsed = MonotonicTime.CheckedDurationSince(time, other);
    Less = MonotonicTime.CheckedLess(time, other);
  }
}

node monotonic_source: Std.DebugValueSource { Type: MonotonicTime }
node monotonic_other: Std.DebugValueSource { Type: MonotonicTime }
node monotonic_span: Std.DebugValueSource { Type: Duration }
node monotonic_math: MonotonicMath {}
connect monotonic_source -> monotonic_math;
connect monotonic_other -> monotonic_math.Other;
connect monotonic_span -> monotonic_math.Span;

namespace ProcedureTests {
  node type Mutation {
    default input: value boolean;
    output Saved: value boolean;
    output Changed: value boolean;
    output Shadowed: value boolean;
    output Chosen: value boolean;
    output ReadOutput: value boolean;
    output ShortCircuit: value boolean;
    output Pattern: value boolean;
    output Difference: value uint8;
    output SelfUpdate: value uint8;
    output Snapshot: value boolean;
    output Fields: value Pair;
    output Fallback: value boolean;
    output FallbackRan: value boolean;
    output Unit: value unit;

    procedure run
      depends on default input as input
      produces Saved, Changed, Shadowed, Chosen, ReadOutput, ShortCircuit,
        Pattern, Difference, SelfUpdate, Snapshot, Fields, Fallback,
        FallbackRan, Unit
    {
      let mut value: boolean;
      value = input;
      let saved = value;
      { value = !value; }
      Saved = saved;
      Changed = value;
      {
        let value = value;
        let mut value = value;
        value = !value;
      }
      let value = value;
      Shadowed = value;

      let chosen: boolean;
      if input {
        chosen = true;
        Chosen = chosen;
      } else {
        chosen = false;
        Chosen = chosen;
      }
      ReadOutput = !Chosen;

      let mut visited = false;
      input && { visited = true; true };
      !input || { visited = true; false };
      if input { visited = true; }
      ShortCircuit = visited;

      let pattern: boolean;
      let mut option: Option[boolean] = if input { Some(true) } else { None };
      if let Some(inner) = option {
        option = None;
        pattern = inner;
      } else {
        pattern = false;
      }
      if let Some(inner) = option { pattern; }
      Pattern = pattern;

      let mut number: uint8 = 10;
      Difference = uint8.WrappingSub(number, { number = 2; number });
      number = 10;
      number = uint8.WrappingSub(number, { number = 2; number });
      SelfUpdate = number;
      let mut flag = true;
      Snapshot = flag == { flag = false; true };
      flag = true;
      Fields = Pair {
        enabled: flag,
        number: if { flag = false; flag } { 1 } else { 2 },
      };

      let mut fallback_ran = false;
      let option_value: Option[boolean] = if input { Some(true) } else { None };
      Fallback = option_value.UnwrapOr({ fallback_ran = true; false });
      FallbackRan = fallback_ran;
      let first: unit;
      let second: unit;
      first = second = ();
      Unit = { true; first };
    }
  }
}
node mutation: ProcedureTests.Mutation {}
connect source -> mutation;
