node signed : Std.Constant(Type = Signed, Value = Signed.Min);
node root : Std.Constant(Type = Example.Mode, Value = Example.Mode.On);
node forwarded : Example.Settings;
node nested : Example.Inner.Settings;
node other : Std.Constant(Type = Other.Mode, Value = Other.Mode.On);
node type LiteralParameter {
  parameter Type : ValueType;
  parameter Value : Type;
}
node wrapped_modes : LiteralParameter(
  Type = List[Option[Example.Mode]],
  Value = [Some(Example.Mode.On), None]
);

// Signed numbers, bases, escaped identifiers, and a trailing comma.
enum type Signed : int8 {
  Min = -128,
  Zero = 0,
  /* Hexadecimal /* with a nested comment */ value. */
  Hex = +0x2a,
  Octal = 0o77,
  r#enum = 127,
}
enum type Empty : uint64 {}

namespace Example {
  node type Settings {
    parameter ModeType : ValueType = Mode;
    parameter Initial : ModeType = Mode.On;
    implicit output : value ModeType;
    node value : Std.Constant(Type = ModeType, Value = Initial);
    connect value -> implicit output;
  }
}

namespace Example {
  enum type Mode : uint8 { Off = 0, On = 1 }
}

namespace Example.Inner {
  node type Settings {
    implicit output : value Mode;
    node value : Std.Constant(Type = Mode, Value = Mode.On);
    connect value -> implicit output;
  }
}

namespace Other {
  enum type Mode : uint8 { On = 1 }
}

enum type r#enum : uint8 {
  r#node = 1,
}
node escaped : Std.Constant(Type = r#enum, Value = r#enum.r#node);
