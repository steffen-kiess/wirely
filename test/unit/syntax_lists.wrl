node type Settings {
  parameter Values: List[Option[uint8]];
  parameter Empty: List[uint8] = [];
}

node settings: Settings {
  Values: [Some(1,), None, Some(2,),],
}
node first: Std.Constant { Type: boolean, Value: false, }
node second: Std.Constant { Type: boolean, Value: true, }
node sink: Std.And {}
connect first, second, -> sink;
