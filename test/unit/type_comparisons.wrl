namespace Types {
  struct type First {
    value: int16,
  }

  struct type Second {
    value: int16,
  }

  enum type FirstMode: uint8 {
    On = 1,
  }

  enum type SecondMode: uint8 {
    On = 1,
  }
}

assert int16 == int16;
assert int16 != uint16;
assert boolean != unit;
assert ValueType == ValueType;
assert Option[int16] == Option[int16];
assert Option[List[Option[int16]]] == Option[List[Option[int16]]];
assert Option[List[int16]] != Option[List[uint16]];
assert Option[int16] != List[int16];
assert Types.First == Types.First;
assert Types.First != Types.Second;
assert Types.FirstMode == Types.FirstMode;
assert Types.FirstMode != Types.SecondMode;
assert Types.First != Types.FirstMode;
assert Types.FirstMode.On == Types.FirstMode.On;
assert true == true && false != true && 1 == 1 && 1 != 2 && () == ();

constant Same: boolean = Later == int16;
constant Reverse: boolean = int16 == Later;
constant Later: ValueType = int16;
assert Same && Reverse;

node type Compare {
  parameter Type: ValueType;
  parameter Same: boolean = Type == unit;
  parameter Reverse: boolean = unit == Type;
  constant Alias: ValueType = Type;
  constant Nested: boolean = Option[List[Alias]] == Option[List[unit]];
  constant Selected: ValueType = if Type == unit { uint8 } else { int16 };
  assert Same == Reverse;
  assert Nested == Same;
  assert Alias == Type;
  assert (Selected == uint8) == Same;
  default output: value boolean;
  procedure run produces default output as output {
    output = Same && Reverse && Nested;
  }
}

node empty: Compare { Type: unit }
node number: Compare { Type: int16 }

node type OptionalOutput {
  parameter OutputType: ValueType = unit;
  optional parameter OutputValue: OutputType;
  assert OutputType == unit || parameter_option(OutputValue).IsSome,
    "OutputValue is required when OutputType is not unit";
}

node omitted: OptionalOutput {}
node supplied: OptionalOutput { OutputType: int16, OutputValue: 7 }

node type ValueNames {
  parameter int16: boolean = true;
  constant unit: boolean = false;
  assert int16 == true && unit == false;
}

node value_names: ValueNames {}
