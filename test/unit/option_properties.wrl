namespace IsSome {
  enum type IsNone: uint8 {
    IsSome = 1,
    IsNone = 2,
  }

  node type IsSome {
    output IsNone: value boolean;
    state saved: boolean = false;
    procedure write produces saved { saved = true; }
    procedure read depends on saved.old as previous produces IsNone {
      IsNone = previous == false;
    }
  }
}

node type Presence {
  parameter Type: ValueType;
  parameter Value: Option[Type];
  parameter Nested: Option[Option[Type]];
  optional parameter Optional: Option[Type];
  parameter Expected: boolean;
  parameter ExpectedOptional: boolean = false;

  constant IsSome: Option[Type] = Value;
  constant IsNone: Option[Option[Type]] = Nested;
  constant CtPresent: boolean = Value.IsSome;
  constant CtAbsent: boolean = Value.IsNone;
  constant CtNestedPresent: boolean = Nested.IsSome;
  constant CtNestedAbsent: boolean = Nested.IsNone;
  constant CtOptionalPresent: boolean = parameter_option(Optional).IsSome;
  constant CtOptionalAbsent: boolean = parameter_option(Optional).IsNone;
  constant CtBlockPresent: boolean = {
    let value: Option[Option[Type]] = Some(None);
    value
  }.IsSome;
  constant CtLocalAbsent: boolean = {
    let value: Option[Type] = None;
    value.IsNone
  };
  constant CtLocalPresent: boolean = {
    let value: Option[Option[Type]] = Some(None);
    (value).IsSome
  };
  constant CtIfPresent: boolean = if (Value).IsSome { true } else { false };
  constant CtIfAbsent: boolean = if { Value }.IsNone {
    true
  } else {
    false
  };
  constant CtOptionalIf: boolean = if parameter_option(Optional).IsSome {
    true
  } else {
    false
  };

  assert CtPresent == Expected && CtNestedPresent == Expected;
  assert CtAbsent == !Expected && CtNestedAbsent == !Expected;
  assert CtIfPresent == Expected && CtIfAbsent == !Expected;
  assert CtOptionalPresent == ExpectedOptional;
  assert CtOptionalAbsent == !ExpectedOptional;
  assert CtOptionalIf == ExpectedOptional;
  assert CtBlockPresent && CtLocalAbsent && CtLocalPresent;

  default input: value Option[Type];
  output Present: value boolean;
  output Absent: value boolean;
  output NestedPresent: value boolean;
  output NestedAbsent: value boolean;
  output OptionalPresent: value boolean;
  output OptionalAbsent: value boolean;
  output ParameterPresent: value boolean;
  output ParameterAbsent: value boolean;
  output ConstantPresent: value boolean;
  output ConstantAbsent: value boolean;
  output BlockPresent: value boolean;
  output BlockAbsent: value boolean;
  output LocalAbsent: value boolean;
  output LocalPresent: value boolean;
  output IfPresent: value boolean;
  output IfAbsent: value boolean;
  output Copy: value Option[Type];

  procedure run
    depends on default input as input
    produces Present, Absent, NestedPresent, NestedAbsent,
      OptionalPresent, OptionalAbsent, ParameterPresent, ParameterAbsent,
      ConstantPresent, ConstantAbsent, BlockPresent, BlockAbsent,
      LocalAbsent, LocalPresent, IfPresent, IfAbsent, Copy
  {
    let value = input;
    let absent: Option[Type] = None;
    Present = value.IsSome;
    Absent = (input).IsNone;
    NestedPresent = Nested.IsSome;
    NestedAbsent = Nested.IsNone;
    OptionalPresent = CtOptionalPresent;
    OptionalAbsent = CtOptionalAbsent;
    ParameterPresent = Value.IsSome;
    ParameterAbsent = Value.IsNone;
    ConstantPresent = IsSome.IsSome;
    ConstantAbsent = IsSome.IsNone;
    BlockPresent = { let copy = input; copy }.IsSome;
    BlockAbsent = { input }.IsNone;
    LocalAbsent = absent.IsNone;
    LocalPresent = IsNone.IsSome;
    IfPresent = if input.IsSome { true } else { false };
    IfAbsent = if { value }.IsNone { true } else { false };
    Copy = if input.IsSome { input } else { absent };
  }
}

node source: Std.DebugValueSource { Type: Option[boolean] }
node nested_source: Std.DebugValueSource { Type: Option[Option[boolean]] }
node present: Presence {
  Type: boolean,
  Value: Some(false),
  Nested: Some(None),
  Optional: None,
  Expected: true,
  ExpectedOptional: true,
}
node absent: Presence {
  Type: boolean,
  Value: None,
  Nested: None,
  Expected: false,
}
node nested: Presence {
  Type: Option[boolean],
  Value: Some(None),
  Nested: Some(Some(None)),
  Expected: true,
}
connect source -> present;
connect source -> absent;
connect nested_source -> nested;

node type Generic {
  parameter Type: ValueType;
  parameter Value: Type;
  constant CtPresent: boolean = Value.IsSome;
  constant CtAbsent: boolean = Value.IsNone;
  default output: value boolean;
  procedure run produces default output as output {
    output = Value.IsSome && CtPresent && !CtAbsent;
  }
}
node generic: Generic { Type: Option[boolean], Value: Some(false) }

constant EnumSome: IsSome.IsNone = IsSome.IsNone.IsSome;
constant EnumNone: IsSome.IsNone = IsSome.IsNone.IsNone;
assert EnumSome != EnumNone;
node IsNone: IsSome.IsSome {}
temporary qualified: boolean;
procedure qualified_read depends on IsNone.IsNone as input produces qualified {
  qualified = input && IsSome.IsNone.IsSome != IsSome.IsNone.IsNone;
}
