node in : Std.DebugEventSource(Type = boolean);
node feedback : Std.DebugInput(Type = Option[boolean]);

node trigger : Memory.ToggleFlipFlopTrigger ();
connect in -> trigger;
connect feedback -> trigger.Feedback;

node DebugPrinter : Std.DebugEventPrinter(Type = unit);
connect trigger -> DebugPrinter;
