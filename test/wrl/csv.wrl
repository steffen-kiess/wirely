node test_input: Std.DebugValueSource { Type: boolean }

node test_value_writer: CSV.ValueWriter {
  Filename: Test.ReplaceOutputPath("foo.csv"),
  Type: boolean,
}
connect test_input -> test_value_writer;

node test_option_input: Std.DebugValueSource { Type: Option[boolean] }

node test_option_value_writer: CSV.ValueWriter {
  Filename: Test.ReplaceOutputPath("foo2.csv"),
  Type: Option[boolean],
}
connect test_option_input -> test_option_value_writer;
