node inp: Std.DebugValueSource { Type: boolean }
node prnt0: Std.DebugValuePrinter { Type: boolean }
connect inp -> prnt0;

node delay1: Std.DelayOneStep { Type: boolean, InitialValue: false }
connect inp -> delay1;
node prnt1: Std.DebugValuePrinter { Type: boolean }
connect delay1 -> prnt1;

node delay2: Std.DelayOneStep { Type: boolean, InitialValue: false }
connect delay1 -> delay2;
node prnt2: Std.DebugValuePrinter { Type: boolean }
connect delay2 -> prnt2;
