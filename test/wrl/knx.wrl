// TODO: Don't depend on the ordering of bus / Light
node bus: KNX.Connection {
  Protocol: KNX.Protocol.Unix,
  UnixPath: Test.ReplaceKNXPath("/run/knxnet"),
}

node receiver: KNX.ValueReceiver { GroupAddress: "0/4/5", Type: boolean }

// TODO: Allow this line to be above the declaration for bus and receiver and
// add tests for that
connect bus -> receiver.Bus;

node receiver_prnt: Std.DebugValuePrinter { Type: Option[boolean] }
connect receiver -> receiver_prnt;

node receiver_value: Std.OptionUnwrapOr {
  InnerType: boolean,
  Default: false,
}
connect receiver -> receiver_value;
node receiver_value2: Std.OptionUnwrapOr {
  InnerType: boolean,
  Default: true,
}
connect receiver -> receiver_value2;

node provider_input: Std.DebugValueSource { Type: boolean }

node provider: KNX.ValueProvider { GroupAddress: "0/6/7", Type: boolean }
connect bus -> provider.Bus;
connect provider_input -> provider;

node jra_status: KNX.ValueReceiver { GroupAddress: "0/7/10", Type: uint16 }
connect bus -> jra_status.Bus;

node status: ABB.JRA.InterpretStatusInformationOption {}
connect jra_status -> status;

node jra_status_non_option: Std.OptionUnwrapOr {
  InnerType: uint16,
  Default: 0,
}
connect jra_status -> jra_status_non_option;

node status_non_option: ABB.JRA.InterpretStatusInformation {}
connect jra_status_non_option -> status_non_option;

node status_provider: KNX.ValueOptionProvider {
  GroupAddress: "0/7/11",
  Type: uint16,
}
connect bus -> status_provider.Bus;
connect jra_status -> status_provider;

node status_provider_non_option: KNX.ValueProvider {
  GroupAddress: "0/7/12",
  Type: uint16,
}
connect bus -> status_provider_non_option.Bus;
connect jra_status_non_option -> status_provider_non_option;

node motion_provider: KNX.ValueOptionProvider {
  GroupAddress: "0/7/13",
  Type: boolean,
}
connect bus -> motion_provider.Bus;
connect status.DriveInMotion -> motion_provider;

node motion_provider_non_option: KNX.ValueProvider {
  GroupAddress: "0/7/14",
  Type: boolean,
}
connect bus -> motion_provider_non_option.Bus;
connect status_non_option.DriveInMotion -> motion_provider_non_option;

node event_sender_input: Std.DebugEventSource { Type: boolean }

node event_sender: KNX.EventSender { GroupAddress: "0/3/1", Type: boolean }
connect bus -> event_sender.Bus;
connect event_sender_input -> event_sender;

node int_event_sender_input: Std.DebugEventSource { Type: int16 }

node int_event_sender: KNX.EventSender {
  GroupAddress: "0/3/2",
  Type: int16,
}
connect bus -> int_event_sender.Bus;
connect int_event_sender_input -> int_event_sender;

node event_receiver: KNX.EventReceiver {
  GroupAddress: "0/3/3",
  Type: boolean,
}
connect bus -> event_receiver.Bus;

node event_receiver_prnt: Std.DebugEventPrinter { Type: boolean }
connect event_receiver -> event_receiver_prnt;

node int_event_receiver: KNX.EventReceiver {
  GroupAddress: "0/3/4",
  Type: int32,
}
connect bus -> int_event_receiver.Bus;

node int_event_receiver_prnt: Std.DebugEventPrinter { Type: int32 }
connect int_event_receiver -> int_event_receiver_prnt;

// Exercise each native node with every supported datapoint type.
node type KNXConversionCase {
  parameter Type: ValueType;
  parameter ValueReceiveAddress: String;
  parameter ValueSendAddress: String;
  parameter EventReceiveAddress: String;
  parameter EventSendAddress: String;
  input Bus: resource KNX.Bus;

  node value_receiver: KNX.ValueReceiver {
    Type: Type,
    GroupAddress: ValueReceiveAddress,
  }
  connect Bus -> value_receiver.Bus;

  node value_input: Std.DebugValueSource { Type: Option[Type] }
  node value_sender: KNX.ValueOptionProvider {
    Type: Type,
    GroupAddress: ValueSendAddress,
  }
  connect Bus -> value_sender.Bus;
  connect value_input -> value_sender;

  node event_receiver: KNX.EventReceiver {
    Type: Type,
    GroupAddress: EventReceiveAddress,
  }
  connect Bus -> event_receiver.Bus;

  node event_input: Std.DebugEventSource { Type: Type }
  node event_sender: KNX.EventSender {
    Type: Type,
    GroupAddress: EventSendAddress,
  }
  connect Bus -> event_sender.Bus;
  connect event_input -> event_sender;
}

node case_boolean: KNXConversionCase {
  Type: boolean,
  ValueReceiveAddress: "1/0/1",
  ValueSendAddress: "1/0/2",
  EventReceiveAddress: "1/0/3",
  EventSendAddress: "1/0/4",
}
connect bus -> case_boolean.Bus;

node case_int16: KNXConversionCase {
  Type: int16,
  ValueReceiveAddress: "1/1/1",
  ValueSendAddress: "1/1/2",
  EventReceiveAddress: "1/1/3",
  EventSendAddress: "1/1/4",
}
connect bus -> case_int16.Bus;

node case_uint16: KNXConversionCase {
  Type: uint16,
  ValueReceiveAddress: "1/2/1",
  ValueSendAddress: "1/2/2",
  EventReceiveAddress: "1/2/3",
  EventSendAddress: "1/2/4",
}
connect bus -> case_uint16.Bus;

node case_int32: KNXConversionCase {
  Type: int32,
  ValueReceiveAddress: "1/3/1",
  ValueSendAddress: "1/3/2",
  EventReceiveAddress: "1/3/3",
  EventSendAddress: "1/3/4",
}
connect bus -> case_int32.Bus;

node case_uint32: KNXConversionCase {
  Type: uint32,
  ValueReceiveAddress: "1/4/1",
  ValueSendAddress: "1/4/2",
  EventReceiveAddress: "1/4/3",
  EventSendAddress: "1/4/4",
}
connect bus -> case_uint32.Bus;
