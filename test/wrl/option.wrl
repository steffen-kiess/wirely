node inp0: Std.DebugValueSource { Type: boolean }
node inp1: Std.DebugValueSource { Type: boolean }
node inp2: Std.DebugValueSource { Type: boolean }
node number_inp: Std.DebugValueSource { Type: uint16 }

node val0: Std.OptionNone { InnerType: boolean }
node is_some0: Std.OptionIsSome { InnerType: boolean }
connect val0 -> is_some0;

node val1: Std.OptionSome { InnerType: boolean }
connect inp0 -> val1;
node is_some1: Std.OptionIsSome { InnerType: boolean }
connect val1 -> is_some1;

node val2: Std.OptionCreate { InnerType: boolean }
connect inp1 -> val2.HasValue;
connect inp2 -> val2.Value;
node is_some2: Std.OptionIsSome { InnerType: boolean }
connect val2 -> is_some2;

node val3: Std.OptionCreate { InnerType: uint16 }
connect inp1 -> val3.HasValue;
connect number_inp -> val3.Value;
node is_some3: Std.OptionIsSome { InnerType: uint16 }
connect val3 -> is_some3;

node unwrapped: Std.OptionUnwrapOr { InnerType: uint16, Default: 77 }
connect val3 -> unwrapped;

node nested_input: Std.DebugValueSource { Type: Option[boolean] }
node nested_some: Std.OptionSome { InnerType: Option[boolean] }
connect nested_input -> nested_some;
node nested_created: Std.OptionCreate { InnerType: Option[boolean] }
connect inp1 -> nested_created.HasValue;
connect nested_input -> nested_created.Value;
node nested_is_some: Std.OptionIsSome { InnerType: Option[boolean] }
connect nested_created -> nested_is_some;
node nested_unwrapped: Std.OptionUnwrapOr {
  InnerType: Option[boolean],
  Default: Some(true),
}
connect nested_created -> nested_unwrapped;
