node inp : Std.DebugInput(type = boolean);
node prnt0 : Std.DebugPrinter(type = boolean);
connect inp -> prnt0;

node delay1 : Std.Delay(type = boolean, initialValue = false);
connect inp -> delay1;
node prnt1 : Std.DebugPrinter(type = boolean);
connect delay1 -> prnt1;

node delay2 : Std.Delay(type = boolean, initialValue = false);
connect delay1 -> delay2;
node prnt2 : Std.DebugPrinter(type = boolean);
connect delay2 -> prnt2;
