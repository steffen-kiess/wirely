constant Second: Duration = "PT1S";
constant Max: Duration = "PT18446744073.709551615S";

// Saturating functions clamp to zero and the maximum.
assert Duration.SaturatingAdd(Second, "PT2S") == "PT3S";
assert Duration.SaturatingAdd(Max, Second) == Max;
assert Duration.SaturatingSub("PT3S", Second) == "PT2S";
assert Duration.SaturatingSub(Second, "PT3S") == "PT0S";
assert Duration.SaturatingMul(Second, 60) == "PT1M";
assert Duration.SaturatingMul(Max, 2) == Max && Duration.SaturatingMul(Max, 0) == "PT0S";

// Checked functions give None outside 0 to the maximum, or for divisor 0.
assert Duration.CheckedAdd(Second, Second) == Some("PT2S");
assert Duration.CheckedAdd(Max, "PT0.000000001S") == None;
assert Duration.CheckedSub(Second, Second) == Some("PT0S");
assert Duration.CheckedSub(Second, "PT1.000000001S") == None;
assert Duration.CheckedMul("PT1H", 24) == Some("P1D") && Duration.CheckedMul(Max, 2) == None;
assert Duration.CheckedDiv(Second, 3) == Some("PT0.333333333S");
assert Duration.CheckedDiv(Second, 0) == None;
assert Duration.CheckedDiv(Max, 4294967295) == Some("PT4.294967297S");

// Compile-time operators.
constant Total: Duration = Second + "PT2S" - "PT0.5S";
assert Total == "PT2.5S" && Max - Max == "PT0S";
assert Second + Second > Second && "PT1M" - Second == "PT59S";

// Conversions from integer counts never overflow; extraction rounds down.
assert Duration.FromSecs(90) == "PT1M30S" && Duration.FromMillis(1500) == "PT1.5S";
assert Duration.FromMicros(1) == "PT0.000001S" && Duration.FromNanos(1) == "PT0.000000001S";
assert Duration.FromSecs(4294967295) == "PT4294967295S";
assert Duration.FromMillis(4294967295) == "PT4294967.295S";
assert Duration.FromMicros(4294967295) == "PT4294.967295S";
assert Duration.FromNanos(18446744073709551615) == Max;
constant Almost: Duration = "PT1.999999999S";
assert Duration.AsSecs(Almost) == 1 && Duration.AsMillis(Almost) == 1999;
assert Duration.AsMicros(Almost) == 1999999 && Duration.AsNanos(Almost) == 1999999999;
assert Duration.AsNanos(Max) == 18446744073709551615 && Duration.AsSecs(Max) == 18446744073;
assert Duration.AsSecs(Duration.FromSecs(4294967295)) == 4294967295;
