assert KNX.ParseGroupAddress("0") == 0;
assert KNX.ParseGroupAddress("65535") == 65535;
assert KNX.ParseGroupAddress("00001") == 1;
assert KNX.ParseGroupAddress("0/0") == 0;
assert KNX.ParseGroupAddress("31/2047") == 65535;
assert KNX.ParseGroupAddress("0/0/0") == 0;
assert KNX.ParseGroupAddress("31/7/255") == 65535;
assert KNX.ParseGroupAddress("1/2/3") == 2563;
assert KNX.ParseGroupAddress("1/515") == 2563;
assert KNX.ParseGroupAddress("2563") == 2563;
assert KNX.ParseGroupAddress("01/02/0003") == 2563;

assert KNX.ValueTypeName(boolean) == "binary";
assert KNX.ValueTypeName(int16) == "2byte_signed";
assert KNX.ValueTypeName(uint16) == "2byte_unsigned";
assert KNX.ValueTypeName(int32) == "4byte_signed";
assert KNX.ValueTypeName(uint32) == "4byte_unsigned";

assert KNX.SupportsValueType(boolean);
assert KNX.SupportsValueType(int16);
assert KNX.SupportsValueType(uint16);
assert KNX.SupportsValueType(int32);
assert KNX.SupportsValueType(uint32);
assert !KNX.SupportsValueType(String);
assert !KNX.SupportsValueType(int8);
assert !KNX.SupportsValueType(uint64);
