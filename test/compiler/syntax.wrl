node type Arguments {
  parameter A: uint8 = 1;
  parameter B: uint8 = 2;
  assert A == 1 && B == 2;
}
node empty: Arguments {}
node single: Arguments { A: 1 }
node trailing: Arguments { A: 1, }
node multiple: Arguments { A: 1, B: 2, /* final argument */ }
constant Empty: List[Option[uint8]] = [];
constant Single: List[Option[uint8]] = [Some(1,),];
constant Multiple: List[Option[uint8]] = [Some(1 /* value */,), None,];
assert (Empty == [])
  && (Single == [Some(1)])
  && (Multiple == [Some(1), None]);
constant At: TimeOfDay = TimeOfDay.WrappingAdd("23:30", "PT1H",);
constant ExpectedAt: TimeOfDay = "00:30";
assert At == ExpectedAt;

node forward: Later { Value: 1 }
node type Later {
  parameter Value: uint8;
  assert Value == 1;
}
node native_forward: TestLibrary.TestBlock {}

node type WeakNames {
  parameter constant: boolean;
  parameter default: boolean;
  parameter event: boolean;
  parameter input: boolean;
  parameter multi: boolean;
  parameter on: boolean;
  parameter output: boolean;
  parameter resource: boolean;
  parameter stage: boolean;
  parameter state: boolean;
  parameter type: boolean;
  parameter value: boolean;
  assert constant && default && event && input && multi && on
    && output && resource && stage && state && type && value;
}

struct type WeakFields {
  constant: boolean,
  default: boolean,
  event: boolean,
  input: boolean,
  multi: boolean,
  on: boolean,
  output: boolean,
  resource: boolean,
  stage: boolean,
  state: boolean,
  type: boolean,
  value: boolean,
}

enum type WeakMembers: uint8 {
  constant = 0,
  default = 1,
  event = 2,
  input = 3,
  multi = 4,
  on = 5,
  output = 6,
  resource = 7,
  stage = 8,
  state = 9,
  type = 10,
  value = 11,
}

node plain: WeakNames {
  constant: true,
  default: true,
  event: true,
  input: true,
  multi: true,
  on: true,
  output: true,
  resource: true,
  stage: true,
  state: true,
  type: true,
  value: true,
}
node escaped: WeakNames {
  r#constant: true,
  r#default: true,
  r#event: true,
  r#input: true,
  r#multi: true,
  r#on: true,
  r#output: true,
  r#resource: true,
  r#stage: true,
  r#state: true,
  r#type: true,
  r#value: true,
}
constant Fields: WeakFields = WeakFields {
  constant: true,
  default: true,
  event: true,
  input: true,
  multi: true,
  on: true,
  output: true,
  resource: true,
  stage: true,
  state: true,
  type: true,
  value: true,
};
assert Fields == WeakFields {
  r#constant: true,
  r#default: true,
  r#event: true,
  r#input: true,
  r#multi: true,
  r#on: true,
  r#output: true,
  r#resource: true,
  r#stage: true,
  r#state: true,
  r#type: true,
  r#value: true,
};
assert WeakMembers.constant == WeakMembers.r#constant;
assert WeakMembers.default == WeakMembers.r#default;
assert WeakMembers.event == WeakMembers.r#event;
assert WeakMembers.input == WeakMembers.r#input;
assert WeakMembers.multi == WeakMembers.r#multi;
assert WeakMembers.on == WeakMembers.r#on;
assert WeakMembers.output == WeakMembers.r#output;
assert WeakMembers.resource == WeakMembers.r#resource;
assert WeakMembers.stage == WeakMembers.r#stage;
assert WeakMembers.state == WeakMembers.r#state;
assert WeakMembers.type == WeakMembers.r#type;
assert WeakMembers.value == WeakMembers.r#value;

node r#as: Arguments {}
node r#assert: Arguments {}
node r#connect: Arguments {}
node r#depends: Arguments {}
node r#enum: Arguments {}
node r#initializer: Arguments {}
node r#namespace: Arguments {}
node r#function: Arguments {}
node r#native: Arguments {}
node r#node: Arguments {}
node r#optional: Arguments {}
node r#parameter: Arguments {}
node r#procedure: Arguments {}
node r#produces: Arguments {}
node r#singleton: Arguments {}
node r#struct: Arguments {}
node r#temporary: Arguments {}
node r#uses: Arguments {}

node source: Std.Constant { Type: boolean, Value: true }
node sink: Std.And {}
connect source, -> sink;
namespace TestLibrary {
  native node type Probe {
    native procedure omitted;
    native procedure empty depends on produces uses;
    native initializer depends on uses;
  }
}

namespace TestLibrary {
  node type TestBlock {
    native procedure test_procedure;
  }
}


constant IsOption: boolean = if Option[uint8] == Option[uint8] { true } else { false };
assert IsOption;

struct type PortStruct { flag: boolean }
node type TypedPorts {
  default input: value boolean;
  default output: value boolean;
  constant Made: PortStruct = PortStruct { flag: true };
  node none: Std.OptionNone { InnerType: uint8 }

  procedure run
    depends on input: value boolean, value: value Option[uint8], on: value PortStruct,
    produces output: value boolean, stage: value PortStruct,
  {
    output = input;
    stage = on;
  }
  procedure make produces made: value PortStruct { made = Made; }
  procedure copy depends on fields: value PortStruct produces copied: value PortStruct {
    copied = fields;
  }
  connect default input -> run.input;
  connect none -> run.value;
  connect make.made -> run.on;
  connect run.stage -> copy.fields;
  connect run.output -> default output;
}
node typed_ports: TypedPorts {}
connect source -> typed_ports;
