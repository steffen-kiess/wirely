// Event dependencies in procedure bodies.
node type Events {
  parameter Type: ValueType = uint8;
  input Press: event unit;
  input Values: multi event Type;
  input Changed: event Type;
  default output: value Type;
  procedure run
    depends on Press as on, Values, empty: multi event Type,
      changed: event Type
    produces default output as output
  {
    let mut result: Type = 0;
    // Weak keywords name events and locals.
    on on {}
    on changed, on, { result = 2; }
    on changed {
      let event: Type = changed;
      result = event;
      #[Allow(RedundantOn)]
      on changed { result = changed; }
    }
    on changed, on {
      on changed { result = changed; }
    }
    let unit_value = on on {};
    on Values {}
    on empty { result = 1; }
    for item in Values {
      on item { result = Type.WrappingAdd(result, item); }
    }
    assert Values.Length == 2;
    output = result;
  }
  connect Changed -> run.changed;
}
node press: Std.DebugEventSource { Type: unit }
node value: Std.DebugEventSource { Type: uint8 }
node events: Events {}
connect press -> events.Press;
connect value, value -> events.Values;
connect value -> events.Changed;

// optional(e) reads an event as an option anywhere in a body.
node type Optionals {
  input A: event uint8;
  input B: event uint8;
  input Nested: event Option[uint8];
  input Values: multi event uint8;
  default output: value Option[uint8];
  procedure run
    depends on A as a, B as b, Nested as nested, Values as values
    produces default output as output
  {
    let mut result: Option[uint8] = optional(a);
    on a, b {
      if let Some(value) = optional(b) { result = Some(value); }
    }
    on a {
      let same: Option[uint8] = optional(a);
      result = same;
    }
    for item in values {
      let item_value: Option[uint8] = optional(item);
      if item_value.IsSome { result = item_value; }
    }
    let twice: Option[Option[uint8]] = optional(nested);
    if let Some(inner) = twice { result = inner; }
    output = result;
  }
}
node nested: Std.DebugEventSource { Type: Option[uint8] }
node optionals: Optionals {}
connect value -> optionals.A;
connect value -> optionals.B;
connect nested -> optionals.Nested;
connect value, value -> optionals.Values;
