namespace Types {
  struct type First {
    value: int16,
  }

  struct type Second {
    value: int16,
  }

  enum type FirstMode: uint8 {
    On = 1,
  }

  enum type SecondMode: uint8 {
    On = 1,
  }
}

assert int16 == int16;
assert int16 != uint16;
assert boolean != unit;
assert ValueType == ValueType;
assert Option[int16] == Option[int16];
assert Option[List[Option[int16]]] == Option[List[Option[int16]]];
assert Option[List[int16]] != Option[List[uint16]];
assert Option[int16] != List[int16];
assert Types.First == Types.First;
assert Types.First != Types.Second;
assert Types.FirstMode == Types.FirstMode;
assert Types.FirstMode != Types.SecondMode;
assert Types.First != Types.FirstMode;
assert Types.FirstMode.On == Types.FirstMode.On;
assert true == true && false != true && 1 == 1 && 1 != 2 && () == ();

constant Same: boolean = Later == int16;
constant Reverse: boolean = int16 == Later;
constant Later: ValueType = int16;
assert Same && Reverse;

node type Compare {
  parameter Type: ValueType;
  parameter Same: boolean = Type == unit;
  parameter Reverse: boolean = unit == Type;
  constant Alias: ValueType = Type;
  constant Nested: boolean = Option[List[Alias]] == Option[List[unit]];
  constant Selected: ValueType = if Type == unit { uint8 } else { int16 };
  parameter Expected: boolean;
  assert Same == Expected;
  assert Reverse == Expected;
  assert Nested == Same;
  assert Alias == Type;
  assert (Selected == uint8) == Same;
}

node empty: Compare { Type: unit, Expected: true }
node number: Compare { Type: int16, Expected: false }

node type OptionalOutput {
  parameter OutputType: ValueType = unit;
  optional parameter OutputValue: OutputType;
  assert OutputType == unit || parameter_option(OutputValue).IsSome,
    "OutputValue is required when OutputType is not unit";
}

node omitted: OptionalOutput {}
node supplied: OptionalOutput { OutputType: int16, OutputValue: 7 }

node type ValueNames {
  parameter int16: boolean = true;
  constant unit: boolean = false;
  assert int16 == true && unit == false;
}

node value_names: ValueNames {}

enum type Boundaryint8: int8 {
  Minimum = -128,
  Maximum = 127,
}

enum type Boundaryint16: int16 {
  Minimum = -32768,
  Maximum = 32767,
}

enum type Boundaryint32: int32 {
  Minimum = -2147483648,
  Maximum = 2147483647,
}

enum type Boundaryint64: int64 {
  Minimum = -9223372036854775808,
  Maximum = 9223372036854775807,
}

enum type Boundaryuint8: uint8 {
  Minimum = 0,
  Maximum = 255,
}

enum type Boundaryuint16: uint16 {
  Minimum = 0,
  Maximum = 65535,
}

enum type Boundaryuint32: uint32 {
  Minimum = 0,
  Maximum = 4294967295,
}

enum type Boundaryuint64: uint64 {
  Minimum = 0,
  Maximum = 18446744073709551615,
}


enum type Signed: int8 {
  Min = -128,
  Zero = 0,
  /* Hexadecimal /* nested comment */ value. */
  Hex = +0x2a,
  Octal = 0o77,
  r#enum = 127,
}
enum type Empty: uint64 {}
enum type r#enum: uint8 { r#node = 1, }
assert Signed.Hex != Signed.Octal;
constant Escaped: r#enum = r#enum.r#node;
assert Escaped == r#enum.r#node;

namespace Example {
  node type Settings {
    parameter ModeType: ValueType = Mode;
    parameter Initial: ModeType = Mode.On;
    assert ModeType == Mode;
    assert Initial == Mode.On;
  }
}
namespace Example {
  enum type Mode: uint8 { Off = 0, On = 1, }
}
namespace Example.Inner {
  node type Settings {
    parameter Initial: Mode = Mode.On;
    assert Initial == Mode.On;
  }
}
node forwarded: Example.Settings {}
node nested: Example.Inner.Settings {}

struct type Packet {
  number: uint16,
  mode: Example.Mode,
  flag: boolean,
}
struct type Settings {
  text: String,
  items: List[Option[Packet]],
  type: ValueType,
}
struct type EscapedFields {
  r#struct: unit,
  r#class: uint8,
}
struct type EmptyStruct {}
node type Structs {
  parameter Type: ValueType = Settings;
  parameter Value: Type = Settings {
    text: "hello",
    items: [Some(Packet { number: 513, mode: Example.Mode.On, flag: true }), None],
    type: uint8,
  };
  assert Value == Settings {
    type: uint8,
    items: [Some(Packet { flag: true, mode: Example.Mode.On, number: 513 }), None],
    text: "hello",
  };
  assert EscapedFields { r#class: 5, r#struct: () } == EscapedFields { r#struct: (), r#class: 5 };
  assert EmptyStruct {} == EmptyStruct {};
}
node structs: Structs {}
