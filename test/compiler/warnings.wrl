// Warnings and their suppression with Allow.

node a: Std.DebugEventSource { Type: boolean }
node b: Std.DebugEventSource { Type: boolean }
node c: Std.DebugEventSource { Type: boolean }
node d: Std.DebugEventSource { Type: boolean }

// A nested on block warns when it always runs because an enclosing block
// guarantees one of its triggers, or when none of its triggers relates to
// the nearest enclosing block.
state nested: boolean = false;
procedure nest depends on a, b, c, inputs: multi event boolean produces nested {
  let mut value = false;
  on a {
    on b { value = b; } // W: Block runs only if 'b' occurs in the same step as 'a'
    on b, c {} // W: Block runs only if 'b' or 'c' occurs
    if value {
      on c {} // W: Block runs only if 'c'
    }
    on a {} // W: Block always runs, since 'a' holds here
    on a, b {} // W: Block always runs, since 'a' holds here
    on b {
      // ^W: Block runs only if 'b'
      on a {} // W: Block always runs, since 'a' holds here
    }
    for item in inputs {
      on item {} // W: Block runs only if 'item'
    }
  }
  on a, b {
    on a { value = a; }
    on a, b {} // W: Block always runs, since 'a' or 'b' holds here
  }
  on inputs {
    for item in inputs {
      on item {
        on inputs {} // W: Block always runs, since 'inputs' holds here
        on item {} // W: Block always runs, since 'item' holds here
      }
    }
  }
  for item in inputs {
    on item {
      on inputs {} // W: Block always runs, since 'item' holds here
    }
  }
  nested = value;
}
connect c, d -> nest.inputs;

// Allow covers the attributed item and everything inside it.
state allowed: boolean = false;
procedure allow_statements depends on a, b, c produces allowed {
  on a {
    #[Allow(CoincidentTriggers)]
    on b {}
    #[Allow(CoincidentTriggers)]
    if true {
      on b {}
    }
  }
  #[Allow(CoincidentTriggers)]
  on a {
    on b {
      on c {}
    }
  }
  allowed = false;
}

#[Allow(CoincidentTriggers)]
procedure allow_procedure depends on a, b {
  on a { on b {} }
}

#[Allow(NativeFunction, CoincidentTriggers)]
node type AllowedType {
  default input: event boolean;
  input Other: event boolean;
  procedure run depends on default input as input, Other {
    on input { on Other {} }
  }
}
node allowed_type: AllowedType {}
connect a -> allowed_type;
connect b -> allowed_type.Other;

// Temporaries and resources need a reader in their node type; an output of
// the node type counts even if no instance uses it. States are not checked.
binding unread: value boolean; // W: Binding 'unread' is never read
procedure write_unread produces unread { unread = true; }

state unread_state: boolean = false;
procedure write_state produces unread_state { unread_state = true; }

namespace TestLibrary {
  native node type Resources {
    input Service: resource Std.DebugEventSourceState;
    binding read_by_initializer: resource Std.DebugEventSourceState;
    connect Service -> read_by_initializer;
    binding read_by_procedure: resource Std.DebugEventSourceState;
    binding unread_resource: resource Std.DebugEventSourceState; // W: Binding 'unread_resource' is never read
    native initializer depends on read_by_initializer
      produces read_by_procedure, unread_resource;
    native procedure run depends on read_by_procedure;
  }
}

node type Readers {
  default output: value boolean;
  input Value: value boolean;
  binding connected: value boolean;
  binding referenced: value boolean;
  binding forwarded: value boolean;
  binding checked: value boolean;
  connect Value -> connected;
  connect connected -> referenced;
  procedure check depends on referenced produces checked { checked = referenced; }
  connect checked -> forwarded;
  connect forwarded -> default output;
  binding unread: value boolean; // W: Binding 'unread' is never read
  connect Value -> unread;
}
node readers: Readers {}
connect a_value -> readers.Value;
node a_value: Std.DebugValueSource { Type: boolean }

node type EmitWarnings {
  input Input: event boolean;
  output A: event boolean;
  output B: event boolean;
  output C: event boolean;
  output D: event boolean;
  output E: event boolean;
  procedure run
    depends on Input as input
    produces A as a, B as b, C as c, D as d, E as e
  {
    emit a(true); // W: [UnguardedEvent]
    emit? b(None); // W: [UnguardedEvent]
    if optional(input).IsSome {
      emit c(false); // W: [UnguardedEvent]
    }
    #[Allow(UnguardedEvent)]
    emit d(true);
    #[Allow(UnguardedEvent)]
    if true { emit? e(Some(false)); }
  }
  #[Allow(UnguardedEvent)]
  procedure allowed produces result: event unit { emit result; }
}
node emit_warnings: EmitWarnings {}
connect a -> emit_warnings.Input;

// State-change aliases share trigger identity; events and changes are distinct.
state trigger_a: boolean = false;
state trigger_b: boolean = false;
procedure write_triggers produces trigger_a, trigger_b {
  trigger_a = true;
  trigger_b = false;
}
procedure state_nesting
  depends on trigger_a.new as first, trigger_a.new as alias,
    trigger_b.new as second, a as event
{
  on changed first {
    on changed alias {} // W: Block always runs, since changed 'first' holds here
    on changed second {} // W: [CoincidentTriggers]
    on event {} // W: [CoincidentTriggers]
  }
  on event {
    on changed first {} // W: [CoincidentTriggers]
  }
  on event, changed first {
    on changed alias {}
  }
  #[Allow(CoincidentTriggers)]
  on event { on changed first {} }
}

// Suggestions include state inputs and only definitely assigned state outputs.
state suggested: boolean = false;
procedure suggest
  depends on trigger_a.new as current
  produces suggested as next, before: event unit, after: event unit
{
  emit before; // W: available state triggers: on changed current
  next = true;
  emit after; // W: available state triggers: on changed current, on changed next
}

// Event bindings share unused and guard warnings with the other event outputs.
binding unread_event: event unit; // W: Binding 'unread_event' is never read
procedure emit_unread produces unread_event {
  emit unread_event; // W: [UnguardedEvent]
}
#[Allow(Unused)]
binding allowed_event: event unit;
#[Allow(UnguardedEvent)]
procedure emit_allowed produces allowed_event { emit allowed_event; }
