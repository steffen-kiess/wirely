// TEST: missing parameter value
node type Probe {
  parameter Value: boolean; // H: Parameter was declared here
}
node probe: Probe {} // E: Missing value for parameter 'Value' of node 'probe'

// TEST: duplicate node
// SH: Previous node was here
// SE: Duplicate node name 'probe'
node type Probe {}
node probe: Probe {} // H: Previous node was here
node probe: Probe {} // E: Duplicate node name 'probe'

// TEST: duplicate node in a node type
// SH: Previous node was here
// SE: Duplicate node name 'inner'
node type Inner {}
node type Outer {
  node inner: Inner {} // H: Previous node was here
  node inner: Inner {} // E: Duplicate node name 'inner'
}

// TEST: duplicate input
// SH: Previous input was here
// SE: Duplicate input 'Value'
node type Probe {
  input Value: value boolean; // H: Previous input was here
  input Value: value boolean; // E: Duplicate input 'Value'
}

// TEST: duplicate output
// SH: Previous output was here
// SE: Duplicate output 'Value'
node type Probe {
  output Value: value boolean; // H: Previous output was here
  output Value: value boolean; // E: Duplicate output 'Value'
}

// TEST: duplicate default output
// SH: Previous output was here
// SE: Duplicate output 'default output'
node type Probe {
  default output: value boolean; // H: Previous output was here
  default output: value boolean; // E: Duplicate output 'default output'
}

// TEST: node and procedure share a name
// SH: Previous declaration was here
// SE: Duplicate name 'value'
node type Inner {}
node type Probe {
  node value: Inner {} // H: Previous declaration was here
  native procedure value; // E: Duplicate name 'value'
}

// TEST: procedure and state share a name
// SH: Previous declaration was here
// SE: Duplicate name 'value'
node type Probe {
  native procedure value; // H: Previous declaration was here
  state value: boolean = false; // E: Duplicate name 'value'
}

// TEST: temporary and node share a name
// SH: Previous declaration was here
// SE: Duplicate name 'value'
node type Inner {}
node type Probe {
  temporary value: boolean; // H: Previous declaration was here
  node value: Inner {} // E: Duplicate name 'value'
}

// TEST: input and temporary share a name
// SH: Previous declaration was here
// SE: Duplicate name 'Value'
node type Probe {
  input Value: value boolean; // H: Previous declaration was here
  temporary Value: boolean; // E: Duplicate name 'Value'
}

// TEST: input and output share a name
// SH: Previous declaration was here
// SE: Duplicate name 'Value'
node type Probe {
  input Value: value boolean; // H: Previous declaration was here
  output Value: value boolean; // E: Duplicate name 'Value'
}

// TEST: literal of the wrong type
node type Probe {
  parameter Flag: boolean;
}
node probe: Probe { Flag: 5 } // E: Invalid boolean value 5

// TEST: literal as a type
node type Probe {
  parameter Type: ValueType;
}
node probe: Probe { Type: 5 } // E: Expected Reference or BracketOperator as type name, got 5

// TEST: direct recursive instantiation
node type Recursive {
  node child: Recursive {} // E: Recursive node type instantiation of 'Recursive'
}

// TEST: indirect recursive instantiation
// SE: Recursive node type instantiation of
// SH: Instantiation continues here
node type First {
  node type Second {
    node child: First {} // E: Recursive node type instantiation of 'First'
  }
  node child: Second {} // H: Instantiation continues here
}

// TEST: parameterized recursive instantiation
node type Recursive {
  parameter P: uint8 = 1;
  node child: Recursive { P: P } // E: Recursive node type instantiation of 'Recursive'
}
node root: Recursive {}

// TEST: parameterized indirect instantiation cycle
// SE: Recursive node type instantiation of
// SH: Instantiation continues here
node type First {
  parameter Count: uint8 = 1;
  node child: Second { Count: Count } // H: Instantiation continues here
}
node type Second {
  parameter Count: uint8;
  node child: First { Count: Count } // E: Recursive node type instantiation of 'First'
}

// TEST: instantiation cycle in reopened namespace
// SE: Recursive node type instantiation of 'Cycle.
// SH: Instantiation continues here
namespace Cycle {
  node type First {
    node child: Second {} // H: Instantiation continues here
  }
}
namespace Cycle {
  node type Second {
    node child: First {} // E: Recursive node type instantiation of 'Cycle.First'
  }
}

// TEST: unused nested type is validated
node type Outer {
  node type Unused {
    temporary value: boolean; // E: Temporary 'value' has no source
  }
}
