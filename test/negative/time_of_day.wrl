// LIBRARIES: std

// TEST: after the end of the day
constant Value: TimeOfDay = "24:01"; // E: Invalid TimeOfDay value '24:01'

// TEST: fraction after the end of the day
constant Value: TimeOfDay = "24:00:00.1"; // E: Invalid TimeOfDay value

// TEST: hour out of range
constant Value: TimeOfDay = "25:00"; // E: Invalid TimeOfDay value

// TEST: minute out of range
constant Value: TimeOfDay = "08:60"; // E: Invalid TimeOfDay value

// TEST: below nanosecond resolution
constant Value: TimeOfDay = "08:00:00.0000000001"; // E: Invalid TimeOfDay value

// TEST: removed AddWrap
constant Value: TimeOfDay = TimeOfDay.AddWrap("08:00", "01:00"); // E: Type TimeOfDay has no member 'AddWrap'

// TEST: adding times
constant Value: TimeOfDay = "08:00" + "01:00"; // E: Integer arithmetic requires an integer value, got TimeOfDay

// TEST: duration argument
constant Value: TimeOfDay = TimeOfDay.WrappingAdd("08:00", "01:00"); // E: Invalid Duration value '01:00'
