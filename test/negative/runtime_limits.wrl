// TEST: procedure_operand
struct type Wide2 {
  First: uint64,
  Second: uint64,
}

struct type Wide4 {
  First: Wide2,
  Second: Wide2,
}

struct type Wide8 {
  First: Wide4,
  Second: Wide4,
}

struct type Wide16 {
  First: Wide8,
  Second: Wide8,
}


constant Large: Option[Wide16] = None;
temporary result: boolean;
procedure run produces result {
  result = Large == Large; // E: storage size 136 bytes exceeds 128 bytes
}
