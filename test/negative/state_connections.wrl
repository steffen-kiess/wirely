// TEST: missing_state_phase
resource type Handle;
node type Sink {
  implicit input : value uint8;
}
node type EventSink {
  implicit input : event boolean;
}
node type ResourceSink {
  implicit input : resource Handle;
}
node type Invalid {
  state saved : boolean = false;
  temporary temporary_value : boolean;
  implicit output : value boolean;
  node sink : Sink;
  node event_sink : EventSink;
  node resource_sink : ResourceSink;
  node source : Std.Constant(Type = boolean, Value = true);
  connect saved -> implicit output; // E: explicitly reference .old or .new
}

// TEST: unproduced_new_state
resource type Handle;
node type Sink {
  implicit input : value uint8;
}
node type EventSink {
  implicit input : event boolean;
}
node type ResourceSink {
  implicit input : resource Handle;
}
node type Invalid {
  state saved : boolean = false;
  temporary temporary_value : boolean;
  implicit output : value boolean;
  node sink : Sink;
  node event_sink : EventSink;
  node resource_sink : ResourceSink;
  node source : Std.Constant(Type = boolean, Value = true);
  connect saved.new -> implicit output; // E: requires a producing procedure
}

// TEST: wrong_value_type
resource type Handle;
node type Sink {
  implicit input : value uint8; // H: Target was declared here
}
node type EventSink {
  implicit input : event boolean;
}
node type ResourceSink {
  implicit input : resource Handle;
}
node type Invalid {
  state saved : boolean = false; // H: Source was declared here
  temporary temporary_value : boolean;
  implicit output : value boolean;
  node sink : Sink;
  node event_sink : EventSink;
  node resource_sink : ResourceSink;
  node source : Std.Constant(Type = boolean, Value = true);
  connect saved.old -> sink; // E: source has type
}

