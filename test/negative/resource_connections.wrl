// TEST: resource_mismatch
namespace Fixture {
  resource type First;
  resource type Second;

  node type Source {
    default output: resource First; // H: Source was declared here
  }

  node type Target {
    input Service: resource Second; // H: Target was declared here
  }
}
node source: Fixture.Source {}
node target: Fixture.Target {}
connect source -> target.Service; // E: source has resource type Fixture.First but target has resource type Fixture.Second

// TEST: resource_same_name_mismatch
namespace First {
  resource type Handle;
}

namespace Second {
  resource type Handle;
}

node type Source {
  default output: resource First.Handle; // H: Source was declared here
}

node type Target {
  default input: resource Second.Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: source has resource type First.Handle but target has resource type Second.Handle

// TEST: resource_boundary_mismatch
resource type First;
resource type Second;

node type Invalid {
  input Service: resource First; // H: Source was declared here
  default output: resource Second; // H: Target was declared here
  connect Service -> default output; // E: source has resource type First but target has resource type Second
}

// TEST: resource_to_data_value
resource type Handle;

node type Source {
  default output: resource Handle; // H: Source was declared here
}

node type Target {
  default input: value boolean; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect resource and data ports

// TEST: data_to_resource_value
resource type Handle;

node type Source {
  default output: value boolean; // H: Source was declared here
}

node type Target {
  default input: resource Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect resource and data ports

// TEST: resource_to_data_event
resource type Handle;

node type Source {
  default output: resource Handle; // H: Source was declared here
}

node type Target {
  default input: event boolean; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect resource and data ports

// TEST: data_to_resource_event
resource type Handle;

node type Source {
  default output: event boolean; // H: Source was declared here
}

node type Target {
  default input: resource Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect resource and data ports

// TEST: circular native initialization
// LIBRARIES:
namespace Std {
  resource type Service;
  native node type DebugValueSource {
    input Service: resource Service;
    default output: resource Service;
    native initializer depends on Service;
    // ^E: Circular native initializer dependency
  }
}
node first: Std.DebugValueSource {}
node second: Std.DebugValueSource {}
connect first -> second.Service;
connect second -> first.Service;

// TEST: circular resource forwarding
// LIBRARIES:
resource type Service;
node type Forward {
  input Service: resource Service;
  default output: resource Service;
  connect Service -> default output;
}
namespace Std {
  native node type DebugValueSource {
    input Service: resource Service;
    native initializer depends on Service;
  }
}
node first: Forward {}
node second: Forward {}
node sink: Std.DebugValueSource {}
connect first -> second.Service;
connect second -> first.Service; // E: Circular connection
connect first -> sink.Service;

// TEST: missing native resource provider
// LIBRARIES:
resource type Service;
node type Missing {
  default output: resource Service; // H: Resource output was declared here
}
namespace Std {
  native node type DebugValueSource {
    input Service: resource Service;
    native initializer depends on Service;
    // ^E: Resource input has no native provider
  }
}
node source: Missing {}
node sink: Std.DebugValueSource {}
connect source -> sink.Service;
