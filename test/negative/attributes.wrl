// TEST: unknown outer
#[unknown] node type T {} // E: Unknown attribute unknown

// TEST: unknown qualified
#[tool.position(x = 1, y = 2)] node type T {}
// ^E: Unknown attribute tool.position

// TEST: unknown file inner
#![unknown] // E: Unknown attribute unknown

// TEST: unknown body inner
node type T {
  #![unknown] // E: Unknown attribute unknown
}

// TEST: unknown field
struct type S {
  #[unknown] f: uint8, // E: Unknown attribute unknown
}

// TEST: unknown member
enum type E: uint8 {
  #[unknown] First = 0, // E: Unknown attribute unknown
}

// TEST: unknown source
connect #[unknown] a -> b; // E: Unknown attribute unknown

// TEST: wrong target
#[position(x = 1, y = 2)] node type T {}
// ^E: Attribute position is not permitted on node_type

// TEST: wrong inner target
struct type S {
  #![position(x = 1, y = 2)] // E: Attribute position is not permitted on struct
}

// TEST: wrong connection target
#[position(x = 1, y = 2)] connect a -> b;
// ^E: Attribute position is not permitted on connection

// TEST: wrong assertion target
#[position(x = 1, y = 2)] assert true;
// ^E: Attribute position is not permitted on assertion

// TEST: missing arguments
node n: Missing { #![position] } // E: position requires x and y arguments

// TEST: empty arguments
#[position()] node n: Missing {} // E: position requires x and y arguments

// TEST: missing y
#[position(x = 1)] node n: Missing {} // E: position requires x and y arguments

// TEST: missing x
#[position(y = 1)] node n: Missing {} // E: position requires x and y arguments

// TEST: duplicate argument
#[position(x = 1, x = 2, y = 0)] node n: Missing {}
// ^E: Duplicate position argument x

// TEST: unknown argument
#[position(x = 1, y = 2, z = 3)] node n: Missing {}
// ^E: Unknown position argument

// TEST: qualified argument
#[position(point.x = 1, y = 2)] node n: Missing {}
// ^E: Unknown position argument

// TEST: boolean argument
#[position(x = true, y = 2)] node n: Missing {}
// ^E: position x requires a finite numeric literal

// TEST: string argument
#[position(x = "1", y = 2)] node n: Missing {}
// ^E: position x requires a finite numeric literal

// TEST: flag argument
#[position(x, y = 2)] node n: Missing {}
// ^E: position x requires a finite numeric literal

// TEST: nested argument
#[position(x(1), y = 2)] node n: Missing {}
// ^E: position x requires a finite numeric literal

// TEST: literal argument
#[position(1, y = 2)] node n: Missing {}
// ^E: Unknown position argument

// TEST: nonfinite argument
#[position(x = 1e999, y = 2)] node n: Missing {}
// ^E: position x requires a finite numeric literal

// TEST: name value attribute
#[position = 1] node n: Missing {}
// ^E: position requires x and y arguments

// TEST: reference value
#[position(x = Something, y = 2)] node n: Missing {}
// ^E: Attribute values must be literals

// TEST: duplicate attribute
#[position(x = 1, y = 2)]
node n: Missing { #![position(x = 3, y = 4)] } // E: Duplicate attribute position

// TEST: dangling outer file
#[position(x = 1, y = 2)] // E: Unexpected token

// TEST: dangling outer body
node type T {
  #[position(x = 1, y = 2)]
} // E: Unexpected token

// TEST: dangling outer field
struct type S {
  #[position(x = 1, y = 2)]
} // E: Unexpected token

// TEST: dangling outer member
enum type E: uint8 {
  #[position(x = 1, y = 2)]
} // E: Unexpected token

// TEST: misplaced inner file
node type T {}
#![unknown] // E: Unexpected token

// TEST: misplaced inner node type
node type T {
  parameter P: ValueType;
  #![unknown] // E: Unexpected token
}

// TEST: misplaced inner namespace
namespace N {
  node type T {}
  #![unknown] // E: Unexpected token
}

// TEST: misplaced inner struct
struct type S {
  f: uint8,
  #![unknown] // E: Unexpected token
}

// TEST: misplaced inner enum
enum type E: uint8 {
  First = 0,
  #![unknown] // E: Unexpected token
}

// TEST: inner following outer
#[unknown]
#![unknown] // E: Unexpected token
node type T {}

// TEST: expression attributes deferred
node n: T { Value: #[unknown] 1 } // E: Unexpected token

// TEST: node argument attributes deferred
node n: T { #[unknown] Value: 1 } // E: Unexpected token

// TEST: literal field attributes deferred
parameter V: S = S { #[unknown] f: 1 }; // E: Unexpected token

// TEST: port attributes deferred
node type T {
  native procedure run depends on #[unknown] default input;
  // ^E: Unexpected token
}

// TEST: target attributes deferred
connect a -> #[unknown] b; // E: Unexpected token

// TEST: lowercase internal
#[internal] node type T {} // E: Unknown attribute internal

// TEST: Internal empty arguments
#[Internal()] node type T {}
// ^E: Internal must be a flag without arguments or a value

// TEST: Internal arguments
#[Internal(reason = "implementation")] node type T {}
// ^E: Internal must be a flag without arguments or a value

// TEST: Internal assigned value
#[Internal = true] node type T {}
// ^E: Internal must be a flag without arguments or a value

// TEST: duplicate Internal outer
#[Internal] #[Internal] node type T {} // E: Duplicate attribute Internal

// TEST: duplicate Internal outer and inner
#[Internal]
node type T {
  #![Internal] // E: Duplicate attribute Internal
}

// TEST: Internal file
#![Internal] // E: Attribute Internal is not permitted on file

// TEST: Internal connection
#[Internal] connect a -> b; // E: Attribute Internal is not permitted on connection

// TEST: Internal assertion
#[Internal] assert true; // E: Attribute Internal is not permitted on assertion

// TEST: Internal procedure
node type T {
  #[Internal] native procedure run;
  // ^E: Attribute Internal is not permitted on procedure
}

// TEST: Internal initializer
native node type T {
  #[Internal] native initializer;
  // ^E: Attribute Internal is not permitted on initializer
}

// TEST: summary arguments
node type T {
  #[summary(always)] parameter P: boolean;
  // ^E: summary must be a flag without arguments or a value
}

// TEST: summary node
#[summary] node type T {} // E: Attribute summary is not permitted on node_type

// TEST: summary state
node type T {
  #[summary] state s: boolean = true;
  // ^E: Attribute summary is not permitted on state
}
