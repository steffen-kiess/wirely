// TEST: integer_signed_underflow
// LIBRARIES: std
node source: Std.Constant(Type = int8, Value = -129); // E: Int value out of range: -129

// TEST: integer_positive_overflow
// LIBRARIES: std
node source: Std.Constant(Type = int8, Value = +128); // E: Int value out of range: 128

// TEST: integer_negative_unsigned
// LIBRARIES: std
node source: Std.Constant(Type = uint8, Value = -1); // E: Int value out of range: -1

// TEST: double_minus
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = --42); // E: Syntax error

// TEST: double_plus
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = ++42); // E: Syntax error

// TEST: minus_plus
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = -+42); // E: Syntax error

// TEST: plus_minus
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = +-42); // E: Syntax error

// TEST: minus_reference
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = -Value); // E: Syntax error

// TEST: plus_reference
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = +Value); // E: Syntax error

// TEST: minus_parentheses
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = -(42)); // E: Syntax error

// TEST: empty_hex
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = 0x); // E: Invalid integer literal

// TEST: decimal_lowercase_suffix
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = 1l); // E: Syntax error

// TEST: decimal_uppercase_suffix
