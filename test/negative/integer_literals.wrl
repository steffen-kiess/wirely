  parameter Value: int8;
}
node settings: Settings(Value = 0o10l); // E: Syntax error

// TEST: octal_uppercase_suffix
node type Settings {
  parameter Value: int8;
}
node settings: Settings(Value = 0o10L); // E: Syntax error

// TEST: attribute_integer_suffix
#[position(x = 1L, y = 0)] node n: Missing; // E: Syntax error

