// TEST: procedure_duplicate_alias
node type Invalid {
  native procedure First as "refresh"; // H: Previous Python procedure name was here
  native procedure Second as "refresh"; // E: Duplicate Python procedure name
}

// TEST: procedure_alias_name_collision
node type Invalid {
  native procedure First as "refresh"; // H: Previous Python procedure name was here
  native procedure refresh; // E: Duplicate Python procedure name
}

// TEST: procedure_name_alias_collision
node type Invalid {
  native procedure refresh; // H: Previous Python procedure name was here
  native procedure Second as "refresh"; // E: Duplicate Python procedure name
}

// TEST: procedure_duplicate_decoded_alias_name
node type Invalid {
  native procedure First as r"refresh"; // H: Previous Python procedure name was here
  native procedure Second as "\x72efresh"; // E: Duplicate Python procedure name
}

// TEST: procedure_missing_aliased_method
namespace TestLibrary {
  node type TestBlock {
    native procedure Poll as "missing"; // E: Cannot find native procedure 'missing'
  }
}
node test : TestLibrary.TestBlock;

// TEST: procedure_missing_method
namespace TestLibrary {
  node type TestBlock {
    native procedure missing; // E: Cannot find native procedure 'missing'
  }
}
node test : TestLibrary.TestBlock;
