namespace First {
  resource type Handle;
}

namespace Second {
  resource type Handle;
}

node type Source {
  implicit output : resource First.Handle; // H: Source was declared here
}

node type Target {
  implicit input : resource Second.Handle; // H: Target was declared here
}
node source : Source;
node target : Target;
connect source -> target; // E: source has resource type First.Handle but target has resource type Second.Handle
