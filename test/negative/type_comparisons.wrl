// TEST: type and boolean
assert int16 == true; // E: Expected value of type ValueType, got boolean

// TEST: boolean and type
assert true != int16; // E: Invalid boolean value

// TEST: type and unit value
assert unit == (); // E: Expected value of type ValueType, got unit

// TEST: type and integer
assert int16 == 1; // E: Expected value of type ValueType, got int32

// TEST: integer and type
assert 1 != int16; // E: Expected value of type ValueType, got int32

// TEST: a value name takes precedence over a built-in type name
constant int16: boolean = true;
assert unit == int16; // E: Expected value of type ValueType, got boolean

// TEST: mixed type and enum value
enum type Mode: uint8 {
  On = 1,
}
assert Mode == Mode.On; // E: Expected value of type ValueType, got Mode

// TEST: runtime direct types
temporary result: boolean;
procedure run produces result {
  result = int16 == int16; // E: Unknown procedure value int16
}

// TEST: runtime generic types
temporary result: boolean;
procedure run produces result {
  result = Option[int16] == Option[int16]; // E: Runtime calls and indexing
}

// TEST: runtime type parameter
node type Compare {
  parameter Type: ValueType;
  default output: value boolean;
  procedure run produces default output as output {
    output = Type == Type; // E: unavailable parameter 'Type'
  }
}
node compare: Compare { Type: int16 }

// TEST: runtime type constant
constant Type: ValueType = unit;
temporary result: boolean;
procedure run produces result {
  result = Type != Type; // E: unavailable parameter 'Type'
}

// TEST: optional output required
node type OptionalOutput {
  parameter OutputType: ValueType = unit;
  optional parameter OutputValue: OutputType;
  assert OutputType == unit || parameter_option(OutputValue).IsSome,
    "OutputValue is required when OutputType is not unit";
  // ^^E: OutputValue is required when OutputType is not unit
}
node missing: OptionalOutput { OutputType: int16 } // H: While instantiating 'missing'

// TEST: mismatched lists
constant Left: List[int8] = [];
constant Right: List[uint8] = [];
assert Left == Right; // E: Expected value of type TypeList(int8), got TypeList(uint8)

// TEST: mismatched options
constant Left: Option[int8] = None;
constant Right: Option[uint8] = None;
assert Left != Right; // E: Expected value of type TypeOption(int8), got TypeOption(uint8)

// TEST: nominal structs
struct type Left { flag: boolean, }
struct type Right { flag: boolean, }
constant A: Left = Left { flag: true };
constant B: Right = Right { flag: true };
assert A == B; // E: Expected value of type Left, got Right

// TEST: enum and integer
enum type Mode: uint8 { On = 1, }
constant Number: uint8 = 1;
assert Mode.On == Number; // E: Expected value of type Mode, got uint8

// TEST: integer and enum
enum type Mode: uint8 { On = 1, }
constant Number: uint8 = 1;
assert Number != Mode.On; // E: Invalid int value Mode.On

// TEST: generic mismatched aggregate
node type Compare {
  parameter Type: ValueType;
  parameter Left: Type;
  parameter Right: List[uint8];
  assert Left == Right; // E: Expected value of type TypeList(int8), got TypeList(uint8)
}
node compare: Compare { Type: List[int8], Left: [], Right: [] }
// ^H: While instantiating 'compare'

// TEST: procedure string operand
temporary result: boolean;
procedure run produces result {
  result = "text" == "text"; // E: Type String is not a runtime type: String is parameter-only
}

// TEST: procedure list operand
temporary result: boolean;
procedure run produces result {
  let items: List[uint8] = []; // E: Type TypeList(uint8) is not a runtime type: TypeList(uint8) is parameter-only
  result = items == items;
}

// TEST: procedure parameter-only struct operand
struct type Settings { text: String, }
temporary result: boolean;
procedure run produces result {
  result = Settings { text: "a" } != Settings { text: "b" };
  // ^E: Type Settings is not a runtime type: field text: String is parameter-only
}

// TEST: procedure parameter-only option operand
temporary result: boolean;
procedure run produces result {
  let value: Option[String] = None; // E: Type TypeOption(String) is not a runtime type: inner type: String is parameter-only
  result = value == value;
}

// TEST: ordering booleans
assert false < true; // E: Ordering comparison requires an integer, Duration, or TimeOfDay value, got boolean

// TEST: ordering strings
assert "a" <= "b"; // E: got String

// TEST: ordering enums
enum type Mode: uint8 { Off = 0, On = 1, }
assert Mode.Off < Mode.On; // E: got Mode

// TEST: ordering options
constant Value: Option[uint8] = None;
assert Value >= None; // E: got TypeOption(uint8)

// TEST: ordering monotonic times
constant Deadline: Option[MonotonicTime] = None;
assert if let Some(time) = Deadline { time > time } else { false }; // E: got MonotonicTime

// TEST: ordering types
assert int8 < int16; // E: got ValueType

// TEST: ordering mismatched integer types
constant Small: int8 = 1;
constant Large: int16 = 2;
assert Small < Large; // E: Expected value of type int8, got int16

// TEST: chained ordering
assert 1 < 2 < 3; // E: Unexpected token

// TEST: procedure ordering booleans
temporary result: boolean;
procedure run produces result {
  result = true > false; // E: got boolean
}
