// TEST: unconnected procedure input
node type Probe {
  default input: value boolean; // H: Input was declared here
  default output: value boolean;
  procedure run depends on default input as input produces default output as output {
    output = input;
  }
}
node probe: Probe {} // E: Default input of node 'probe' is not connected

// TEST: unconnected resource input
resource type Service;
node type Probe {
  input Service: resource Service; // H: Input was declared here
}
node probe: Probe {} // E: Input 'Service' of node 'probe' is not connected

// TEST: unconnected unused input
node type Probe {
  input Enabled: value boolean; // H: Input was declared here
}
node probe: Probe {} // E: Input 'Enabled' of node 'probe' is not connected

// TEST: unconnected composite input
node type Inner {
  default input: value boolean;
}
node type Outer {
  default input: value boolean; // H: Input was declared here
  node inner: Inner {}
  connect default input -> inner;
}
node outer: Outer {} // E: Default input of node 'outer' is not connected

// TEST: unconnected child input
node type Inner {
  default input: value boolean; // H: Input was declared here
}
node type Outer {
  node inner: Inner {} // E: Default input of node 'outer.inner' is not connected
}
node outer: Outer {}

// TEST: output without source
node type Probe {
  default output: value boolean; // E: Default output has no source
}
node probe: Probe {} // H: While instantiating 'probe'

// TEST: named output without source
node type Probe {
  output Ready: value boolean; // E: Output 'Ready' has no source
}
node probe: Probe {} // H: While instantiating 'probe'

// TEST: second source for a single input
// LIBRARIES: std
node first: Std.Constant { Type: boolean, Value: true }
node second: Std.Constant { Type: boolean, Value: false }
node printer: Std.DebugValuePrinter { Type: boolean }
connect first -> printer; // H: Previous connection was here
connect second -> printer; // E: Default input of node 'printer' already has a source; only multi inputs accept several

// TEST: second source for a composite input
// LIBRARIES: std
node type Forward {
  input Value: value boolean;
  default output: value boolean;
  connect Value -> default output;
}
node first: Std.Constant { Type: boolean, Value: true }
node second: Std.Constant { Type: boolean, Value: false }
node forward: Forward {}
connect first -> forward.Value; // H: Previous connection was here
connect second -> forward.Value; // E: Input 'Value' of node 'forward' already has a source

// TEST: second source for a node type output
// LIBRARIES: std
node type Probe {
  default output: value boolean;
  node first: Std.Constant { Type: boolean, Value: true }
  node second: Std.Constant { Type: boolean, Value: false }
  connect first -> default output; // H: Previous connection was here
  connect second -> default output; // E: Default output already has a source
}
node probe: Probe {}

// TEST: second procedure for an output
node type Probe {
  default output: value boolean;
  procedure first produces default output as output { output = true; } // H: Previous connection was here
  procedure second produces default output as output { output = false; } // E: Default output already has a source
}
node probe: Probe {}

// TEST: connected and produced output
node type Probe {
  default input: value boolean;
  default output: value boolean;
  procedure first depends on default input as input produces default output as output { // H: Previous connection was here
    output = input;
  }
  connect default input -> default output; // E: Default output already has a source
}

// TEST: second procedure for a temporary
node type Probe {
  temporary flag: boolean;
  procedure first produces flag { flag = true; } // H: Previous connection was here
  procedure second produces flag { flag = false; } // E: Temporary 'flag' already has a source
}
node probe: Probe {}

// TEST: temporary without source
node type Probe {
  default output: value boolean;
  temporary flag: boolean; // E: Temporary 'flag' has no source
  connect flag -> default output;
}

// TEST: temporary cycle
temporary first: boolean;
temporary second: boolean;
connect first -> second; // H: Cycle continues here
connect second -> first; // E: Circular connection

// TEST: cycle through a child node
node type Relay {
  default input: value boolean;
  default output: value boolean;
  connect default input -> default output; // H: Cycle continues here
}
node relay: Relay {}
connect relay -> relay; // E: Circular connection

// TEST: cycle between child nodes
node type Relay {
  default input: value boolean;
  default output: value boolean;
  temporary current: boolean;
  connect default input -> current; // H: Cycle continues here
  connect current -> default output; // H: Cycle continues here
}
node type Outer {
  default output: value boolean;
  node first: Relay {}
  node second: Relay {}
  connect first -> second; // E: Circular connection
  connect second -> first; // H: Cycle continues here
  connect second -> default output;
}
node outer: Outer {}
