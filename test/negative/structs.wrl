// TEST: duplicate_fields
struct type Bad {
  x: uint8, // H: Previous field was here
  x: uint16, // E: Duplicate struct field x
}

// TEST: duplicate_declarations
// SH: Previous
// SE: Bad conflicts with
struct type Bad {} // H: Previous declaration was here
struct type Bad {} // E: conflicts with struct type

// TEST: builtin_collision
struct type uint8 {} // E: conflicts with built-in type

// TEST: generic_collision
struct type Option {} // E: conflicts with built-in type

// TEST: unknown_field_type
struct type Bad {
  x: Missing, // E: Cannot find type Missing
}

// TEST: resource_field_type
resource type Handle;
struct type Bad {
  x: Handle, // E: Cannot find type Handle
}

// TEST: recursive
struct type Bad { // E: Recursive struct type
  x: Bad,
}

// TEST: recursive_option
struct type Bad { // E: Recursive struct type
  x: Option[Bad],
}

// TEST: recursive_list
struct type Bad { // E: Recursive struct type
  x: List[Bad],
}

// TEST: indirect_recursive
// SE: Recursive struct type
struct type First { // E: Recursive struct type
  x: Second,
}
struct type Second {
  x: First,
}

// TEST: namespaced_recursive
namespace N { struct type Bad { // E: Recursive struct type
  x: Option[N.Bad],
} }

// TEST: inside_node
node type Bad { struct type Inner {} } // E: not allowed inside node type

// TEST: semicolon
struct type Bad {
  x: uint8; // E: Syntax error
}

// TEST: missing_field_type
struct type Bad { x, } // E: Syntax error

// TEST: bare_struct
struct Bad { x: uint8, } // E: Syntax error

// TEST: field_default
struct type Bad {
  x: uint8 = 1, // E: Syntax error
}

// TEST: literal_type_required
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: { x: 1 } } // E: Syntax error

// TEST: missing_field
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Record {} } // E: Missing fields

// TEST: unknown_field
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Record { y: 1 } } // E: Unknown field

// TEST: duplicate_literal_field
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Record { x: 1, x: 2 } } // E: Duplicate struct field x // H: Previous field was here

// TEST: wrong_literal_type
// LIBRARIES: std
struct type First {
  x: uint8,
}
struct type Second {
  x: uint8,
}
node n: Std.Constant { Type: First, Value: Second { x: 1 } } // E: Expected struct type First

// TEST: unknown_literal_type
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Missing { x: 1 } } // E: Cannot find type Missing

// TEST: nonstruct_literal_type
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: uint8 { x: 1 } } // E: Expected struct type Record

// TEST: literal_in_scalar
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: uint8, Value: Record { x: 1 } } // E: got struct literal

// TEST: scalar_in_struct
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: 1 } // E: Expected struct literal

// TEST: overflow
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Record { x: 256 } } // E: out of range

// TEST: wrong_field_value
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node n: Std.Constant { Type: Record, Value: Record { x: "text" } } // E: Invalid int value

// TEST: wrong_nested_value
// LIBRARIES: std
struct type Inner {
  x: uint8,
}
struct type Outer {
  inner: Inner,
}
node n: Std.Constant { Type: Outer, Value: Outer { inner: 1 } } // E: Expected struct literal

// TEST: wrong_parameter_type
// LIBRARIES: std
struct type Record {
  x: uint8,
}
node type Settings {
  parameter Value: boolean = true;
  node n: Std.Constant { Type: Record, Value: Record { x: Value } } // E: Expected value of type uint8
}
node n: Settings {}

// TEST: wrong_namespaced_type
// LIBRARIES: std
namespace A { struct type Record {
  x: uint8,
} }
namespace B { struct type Record {
  x: uint8,
} }
node n: Std.Constant { Type: A.Record, Value: B.Record { x: 1 } } // E: Expected struct type A.Record

// TEST: struct_after_enum
// SH: Previous
// SE: Bad conflicts with
open enum type Bad: uint8 { One = 1, } // H: Previous declaration was here
struct type Bad {} // E: conflicts with enum

// TEST: enum_after_struct
// SH: Previous
// SE: Bad conflicts with
struct type Bad {} // H: Previous declaration was here
open enum type Bad: uint8 { One = 1, } // E: conflicts with struct type

// TEST: struct_after_resource
// SH: Previous
// SE: Bad conflicts with
resource type Bad; // H: Previous declaration was here
struct type Bad {} // E: conflicts with resource

// TEST: resource_after_struct
// SH: Previous
// SE: Bad conflicts with
struct type Bad {} // H: Previous declaration was here
resource type Bad; // E: conflicts with struct type

// TEST: struct_after_node
// SH: Previous
// SE: Bad conflicts with
node type Bad {} // H: Previous declaration was here
struct type Bad {} // E: conflicts with node

// TEST: node_after_struct
// SH: Previous
// SE: Bad conflicts with
struct type Bad {} // H: Previous declaration was here
node type Bad {} // E: conflicts with struct type

// TEST: struct_after_namespace
// SH: Previous
// SE: Bad conflicts with
namespace Bad {} // H: Previous declaration was here
struct type Bad {} // E: conflicts with namespace

// TEST: namespace_after_struct
// SH: Previous
// SE: Bad conflicts with
struct type Bad {} // H: Previous declaration was here
namespace Bad {} // E: conflicts with struct type

// TEST: parameter_only_string_value
struct type Record {
  x: String,
}
node type Bad { default output: value Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_string_event
struct type Record {
  x: String,
}
node type Bad { default output: event Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_string_state
struct type Record {
  x: String,
}
node type Bad { state saved: Record = Record { x: "text" }; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_string_temporary
struct type Record {
  x: String,
}
node type Bad { binding saved: value Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_list_uint8_value
struct type Record {
  x: List[uint8],
}
node type Bad { default output: value Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_list_uint8_event
struct type Record {
  x: List[uint8],
}
node type Bad { default output: event Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_list_uint8_state
struct type Record {
  x: List[uint8],
}
node type Bad { state saved: Record = Record { x: "text" }; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_list_uint8_temporary
struct type Record {
  x: List[uint8],
}
node type Bad { binding saved: value Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_option_string_value
struct type Record {
  x: Option[String],
}
node type Bad { default output: value Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_option_string_event
struct type Record {
  x: Option[String],
}
node type Bad { default output: event Record; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_option_string_state
struct type Record {
  x: Option[String],
}
node type Bad { state saved: Record = Record { x: "text" }; } // E: parameter-only
node n: Bad {}

// TEST: parameter_only_option_string_temporary
struct type Record {
  x: Option[String],
}
node type Bad { binding saved: value Record; } // E: parameter-only
node n: Bad {}

// TEST: unknown_field_access
struct type Pair { flag: boolean, }
constant Value: Pair = Pair { flag: true };
assert Value.missing; // E: Value of type Pair has no property 'missing'

// TEST: field_access_on_scalar
constant Value: uint8 = 1;
assert Value.flag; // E: Value of type uint8 has no property 'flag'

// TEST: field_access_through_option
struct type Pair { flag: boolean, }
constant Value: Option[Pair] = None;
assert Value.flag; // E: Value of type Option[Pair] has no property 'flag'

// TEST: option_property_on_struct
struct type Pair { flag: boolean, }
constant Value: Pair = Pair { flag: true };
assert Value.IsSome; // E: Value of type Pair has no property 'IsSome'

// TEST: calling_a_field
struct type Pair { flag: boolean, }
constant Value: Pair = Pair { flag: true };
assert Value.flag(); // E: Value of type Pair has no method 'flag'

// TEST: field_type_mismatch
struct type Pair { flag: boolean, }
constant Value: Pair = Pair { flag: true };
constant Number: uint8 = Value.flag; // E: Expected value of type uint8, got boolean

// TEST: field_access_on_type_parameter
struct type Pair { flag: boolean, }
node type Generic {
  parameter Type: ValueType;
  parameter Value: Type;
  constant Flag: boolean = Value.flag; // E: Field access requires a known struct type
}
node generic: Generic { Type: Pair, Value: Pair { flag: true } }

// TEST: parameter_only_field_in_procedure
struct type Labeled { label: String, enabled: boolean, }
node type Probe {
  parameter Value: Labeled;
  default output: value boolean;
  procedure run produces default output as output {
    let label = Value.label; // E: parameter-only
    output = Value.enabled;
  }
}
node probe: Probe { Value: Labeled { label: "a", enabled: true } }

// TEST: struct_literal_type
struct type Flag { set: boolean }
state bad: Flag { set: true } = Flag { set: true }; // E: Syntax error

// TEST: native name on a non-native struct
struct type Bad as "Example.Bad" { flag: boolean } // E: Unexpected token

// TEST: duplicate native struct name
// SH: Previous declaration was here
// SE: Duplicate native name 'Example.Pair'
namespace Example {
  native struct type Pair { flag: boolean } // H: Previous declaration was here
}
namespace Other {
  native struct type Couple as "Example.Pair" { flag: boolean } // E: Duplicate native name 'Example.Pair'
}
