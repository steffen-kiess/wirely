// TEST: missing implementation
native function Missing(): boolean; // E: Missing implementation

// TEST: missing return type
native function Missing(); // E: Syntax error

// TEST: node scope
node type Invalid {
  native function AddWrap(): TimeOfDay; // E: only allowed at root
}

// TEST: constructor name
native function Some(value: uint8): Option[uint8]; // E: Some is reserved

// TEST: duplicate argument
namespace TimeOfDay {
  native function AddWrap(time: TimeOfDay, time: String): TimeOfDay; // E: Duplicate function argument
}

// TEST: duplicate function
namespace TimeOfDay {
  native function AddWrap(time: TimeOfDay, offset: String): TimeOfDay;
}
namespace TimeOfDay {
  native function AddWrap(time: TimeOfDay, offset: String): TimeOfDay; // E: conflicting function
}

// TEST: declaration collision
namespace TimeOfDay {
  native function AddWrap(time: TimeOfDay, offset: String): TimeOfDay;
  struct type AddWrap {} // E: conflicting function
}

// TEST: reverse declaration collision
namespace TimeOfDay {
  node type AddWrap {}
  native function AddWrap(time: TimeOfDay, offset: String): TimeOfDay; // E: conflicting function
}

// TEST: unknown argument type
namespace TimeOfDay {
  native function AddWrap(time: Unknown, offset: String): TimeOfDay; // E: Cannot find type Unknown
}

// TEST: unknown return type
namespace TimeOfDay {
  native function AddWrap(time: TimeOfDay, offset: String): Unknown; // E: Cannot find type Unknown
}

// TEST: unavailable signature type
parameter Kind: ValueType;
namespace TimeOfDay {
  native function AddWrap(time: Kind, offset: String): TimeOfDay; // E: Cannot find type Kind
}

// TEST: argument count
// LIBRARIES: std
constant Invalid: TimeOfDay = TimeOfDay.AddWrap("12:00"); // E: expected 2 parameters

// TEST: argument type
// LIBRARIES: std
constant Invalid: TimeOfDay = TimeOfDay.AddWrap(true, "01:00"); // E: Invalid TimeOfDay value

// TEST: return type
// LIBRARIES: std
constant Invalid: boolean = TimeOfDay.AddWrap("12:00", "01:00"); // E: Expected value of type boolean

// TEST: function bodies
native function Missing(): boolean { true } // E: Syntax error

// TEST: runtime call
// LIBRARIES: std
node type Invalid {
  default output: value TimeOfDay;
  procedure run produces default output as output {
    output = TimeOfDay.AddWrap("12:00", "01:00"); // E: Runtime calls
  }
}
node invalid: Invalid {}
