// TEST: missing implementation
native constant function Missing(): boolean; // E: Missing implementation

// TEST: missing return type
native constant function Missing(); // E: Syntax error

// TEST: node scope
node type Invalid {
  native constant function AddWrap(): TimeOfDay; // E: only allowed at root
}

// TEST: constructor name
native constant function Some(value: uint8): Option[uint8]; // E: Some is reserved

// TEST: duplicate argument
namespace TimeOfDay {
  native constant function AddWrap(time: TimeOfDay, time: String): TimeOfDay; // E: Duplicate function argument
}

// TEST: duplicate function
// SE: conflicting function
namespace TimeOfDay {
  native constant function AddWrap(time: TimeOfDay, offset: String): TimeOfDay;
}
namespace TimeOfDay {
  native constant function AddWrap(time: TimeOfDay, offset: String): TimeOfDay; // E: conflicting function
}

// TEST: declaration collision
// SE: conflicting function
namespace TimeOfDay {
  native constant function AddWrap(time: TimeOfDay, offset: String): TimeOfDay;
  struct type AddWrap {} // E: conflicting function
}

// TEST: reverse declaration collision
// SE: conflicting function
namespace TimeOfDay {
  node type AddWrap {}
  native constant function AddWrap(time: TimeOfDay, offset: String): TimeOfDay; // E: conflicting function
}

// TEST: unknown argument type
namespace TimeOfDay {
  native function WrappingAdd(time: Unknown, duration: Duration): TimeOfDay; // E: Cannot find type Unknown
}

// TEST: unknown return type
namespace TimeOfDay {
  native function WrappingAdd(time: TimeOfDay, duration: Duration): Unknown; // E: Cannot find type Unknown
}

// TEST: unavailable signature type
parameter Kind: ValueType;
namespace TimeOfDay {
  native function WrappingAdd(time: Kind, duration: Duration): TimeOfDay; // E: Cannot find type Kind
}

// TEST: argument count
// LIBRARIES: std
constant Invalid: TimeOfDay = TimeOfDay.WrappingAdd("12:00"); // E: expected 2 parameters

// TEST: argument type
// LIBRARIES: std
constant Invalid: TimeOfDay = TimeOfDay.WrappingAdd(true, "PT1H"); // E: Invalid TimeOfDay value

// TEST: return type
// LIBRARIES: std
constant Invalid: boolean = TimeOfDay.WrappingAdd("12:00", "PT1H"); // E: Expected value of type boolean

// TEST: function bodies
native constant function Missing(): boolean { true } // E: Syntax error

// TEST: constant function expression with mismatched result type
// LIBRARIES: std, path
node type Invalid {
  default output: value TimeOfDay;
  procedure run produces default output as output {
    output = Path.Parent("file") == ""; // E: Expected value of type TimeOfDay, got boolean
  }
}
node invalid: Invalid {}

// TEST: runtime function with a parameter-only type
native function Describe(value: uint8): String; // E: Function 'Describe' uses parameter-only type String; declare it native constant function

// TEST: runtime function without an implementation
namespace TestLibrary {
  native function Missing(): boolean;
}
constant Value: boolean = TestLibrary.Missing(); // E: Cannot load function 'TestLibrary.Missing': Cannot find native function 'TestLibrary.Missing'

// TEST: runtime function argument type in a procedure
namespace TestLibrary {
  native function Clamp(value: int16, low: int16, high: int16): int16;
}
#[Allow(Unused)] temporary result: int16;
procedure run produces result {
  result = TestLibrary.Clamp(true, 0, 1); // E: Invalid int value true
}

// TEST: duplicate native name
// SH: Previous declaration was here
// SE: Duplicate native name 'Fixture.Parse'
namespace Fixture {
  native function Parse(text: String): uint16; // H: Previous declaration was here
}
namespace Other {
  native function Read as "Fixture.Parse"(text: String): uint16; // E: Duplicate native name 'Fixture.Parse'
}
