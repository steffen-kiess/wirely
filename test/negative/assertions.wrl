// TEST: root failure
assert false; // E: Compile-time assertion failed

// TEST: custom message
assert false, "must differ"; // E: Compile-time assertion failed: must differ

// TEST: raw message
assert false, r#"a "quoted" message\n"#; // E: Compile-time assertion failed: a "quoted" message\n

// TEST: node failure
node type Checked {
  assert Enabled; // E: Compile-time assertion failed
  parameter Enabled: boolean = false;
}
node checked: Checked {} // H: While instantiating 'checked'

// TEST: nested failure
node type Checked {
  assert false; // E: Compile-time assertion failed
}
node type Parent {
  node child: Checked {} // H: While instantiating 'parent.child'
}
node parent: Parent {}

// TEST: singleton failure
singleton node type Shared {
  assert false; // E: Compile-time assertion failed
}
node shared: Shared {} // H: While instantiating 'Shared'

// TEST: unused unknown name
node type Unused {
  assert Unknown; // E: Invalid boolean value
}

// TEST: unused non boolean
node type Unused {
  constant Number: int16 = 1;
  assert Number; // E: Expected value of type boolean, got int16
}

// TEST: literal non boolean
assert 1; // E: Invalid boolean value

// TEST: string non boolean
assert "true"; // E: Invalid boolean value

// TEST: namespace
namespace Example { // H: In this namespace
  assert true; // E: Declaration not allowed in namespace
}

// TEST: procedure failure
procedure run {
  assert false; // E: Compile-time assertion failed
}

// TEST: expression block failure
assert {
  assert false, "block failed"; // E: Compile-time assertion failed: block failed
  true
};

// TEST: procedure raw message
procedure run {
  assert false, r#"a "quoted" message\n"#;
  // ^E: Compile-time assertion failed: a "quoted" message\n
}

// TEST: block non boolean
assert {
  assert 1; // E: Invalid boolean value
  true
};

// TEST: uninitialized constant local
procedure run {
  let value: boolean;
  assert value; // E: is not definitely initialized
}

// TEST: runtime input
constant InputValue: boolean = true;
procedure run depends on input: value boolean {
  assert input; // E: Assertion condition must be a compile-time expression
}
connect InputValue -> run.input;

// TEST: runtime output read
temporary result: boolean;
procedure run produces result {
  result = true;
  assert result; // E: Assertion condition must be a compile-time expression
}

// TEST: literal-initialized runtime local
temporary result: boolean;
procedure run produces result {
  let value = true;
  assert value; // E: Assertion condition must be a compile-time expression
  result = value;
}

// TEST: runtime assignment in condition
temporary result: boolean;
procedure run produces result {
  assert { result = true; true };
  // ^E: Assertion condition must be a compile-time expression
}

// TEST: failing assertion in runtime-controlled branch
constant InputValue: boolean = false;
procedure run depends on input: value boolean {
  if input { assert false; } // E: Compile-time assertion failed
}
connect InputValue -> run.input;

// TEST: failing assertion in runtime short-circuit operand
constant InputValue: boolean = true;
procedure run depends on input: value boolean {
  input || { assert false; true }; // E: Compile-time assertion failed
}
connect InputValue -> run.input;

// TEST: unselected branches are still type checked
procedure run {
  if true {} else { assert 1; } // E: Invalid boolean value
}

// TEST: runtime loop element
procedure run depends on values: multi value boolean {
  for value in values {
    assert value; // E: Assertion condition must be a compile-time expression
  }
}

// TEST: failing constant assertion in an empty loop
procedure run depends on values: multi value boolean {
  for value in values { assert false; } // E: Compile-time assertion failed
}

// TEST: deferred block non boolean
node type Checked {
  parameter Type: ValueType;
  parameter Value: Type;
  constant Checked: boolean = {
    assert Value; // E: Expected value of type boolean, got int16
    true
  };
}
node checked: Checked { Type: int16, Value: 1 } // H: While instantiating 'checked'

// TEST: block assertion without semicolon
procedure run {
  assert true
} // E: Syntax error

// TEST: block assertion without condition
procedure run {
  assert; // E: Syntax error
}

// TEST: block nonliteral message
procedure run {
  let message: String = "message";
  assert true, message; // E: Syntax error
}

// TEST: missing condition
assert; // E: Syntax error

// TEST: missing semicolon
assert true // E: Syntax error

// TEST: missing message
assert true,; // E: Syntax error

// TEST: trailing comma
assert true, "message",; // E: Syntax error

// TEST: nonliteral message
constant Message: String = "message";
assert true, Message; // E: Syntax error

// TEST: reserved name
constant assert: boolean = true; // E: Syntax error

// TEST: metadata
#[unknown] assert true; // E: Unknown attribute

// TEST: inappropriate metadata
#[Diagram.Position(X = 1, Y = 2)] assert true; // E: Attribute Diagram.Position is not permitted on assertion

// TEST: evaluation error
// LIBRARIES: std, knx
assert {
  let address: uint16 = KNX.ParseGroupAddress("bad");
  // ^E: Invalid format
  true
};

// TEST: deferred non boolean
node type Checked {
  parameter Type: ValueType;
  parameter Value: Type;
  assert Value; // E: Expected value of type boolean, got int16
}
node checked: Checked { Type: int16, Value: 1 } // H: While instantiating 'checked'

// TEST: numeric message
assert true, 1; // E: Syntax error

// TEST: message expression
assert true, "message" == "message"; // E: Syntax error
