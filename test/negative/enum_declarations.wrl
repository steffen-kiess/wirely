// TEST: boolean_underlying_type
open enum type Bad: boolean { // E: Enum underlying type must be a supported integer type
  One = 1,
}

// TEST: generic_underlying_type
open enum type Bad: Option[int8] { // E: Enum underlying type must be a supported integer type
  One = 1,
}

// TEST: unknown_underlying_type
open enum type Bad: Missing { // E: Enum underlying type must be a supported integer type
  One = 1,
}

// TEST: boolean_member
open enum type Bad: int8 {
  One = true, // E: Enum member values must be integer literals
}

// TEST: string_member
open enum type Bad: int8 {
  One = "1", // E: Enum member values must be integer literals
}

// TEST: float_member
open enum type Bad: int8 {
  One = 1.0, // E: Enum member values must be integer literals
}

// TEST: int8_overflow
open enum type Bad: int8 {
  One = 128, // E: Int value out of range
}

// TEST: int8_underflow
open enum type Bad: int8 {
  One = -129, // E: Int value out of range
}

// TEST: negative_unsigned_member
open enum type Bad: uint8 {
  One = -1, // E: Int value out of range
}

// TEST: uint64_overflow
open enum type Bad: uint64 {
  One = 18446744073709551616, // E: Int value out of range
}

// TEST: uint128_overflow
open enum type Bad: uint128 {
  One = 340282366920938463463374607431768211456, // E: Int value out of range
}

// TEST: duplicate_member_name
// SH: Previous member was here
// SE: Duplicate enum member One
open enum type Bad: int8 {
  One = 1, // H: Previous member was here
  One = 2, // E: Duplicate enum member One
}

// TEST: duplicate_member_value
// SH: Previous member was here
// SE: Duplicate enum value 1
open enum type Bad: int8 {
  One = 1, // H: Previous member was here
  Two = 1, // E: Duplicate enum value 1
}

// TEST: duplicate_global_enum
// SH: Previous
// SE: Bad conflicts with
open enum type Bad: int8 { // H: Previous declaration was here
  One = 1,
}
open enum type Bad: int8 { // E: Enum type Bad conflicts with enum type
  One = 1,
}

// TEST: duplicate_namespaced_enum
// SH: Previous
// SE: Bad conflicts with
namespace A {
  open enum type Bad: int8 { // H: Previous declaration was here
    One = 1,
  }
}
namespace A {
  open enum type Bad: int8 { // E: Enum type Bad conflicts with enum type
    One = 1,
  }
}

// TEST: builtin_type_collision
open enum type int8: int8 { // E: Enum type int8 conflicts with built-in type
  One = 1,
}

// TEST: generic_type_collision
open enum type List: int8 { // E: Enum type List conflicts with built-in type
  One = 1,
}

// TEST: enum_after_node
// SH: Previous
// SE: Bad conflicts with
node type Bad { // H: Previous declaration was here
}
open enum type Bad: int8 { // E: Enum type Bad conflicts with node type
  One = 1,
}

// TEST: node_after_enum
// SH: Previous
// SE: Bad conflicts with
open enum type Bad: int8 { // H: Previous declaration was here
  One = 1,
}
node type Bad { // E: Node type Bad conflicts with enum type
}

// TEST: enum_after_resource
// SH: Previous
// SE: Bad conflicts with
resource type Bad; // H: Previous declaration was here
open enum type Bad: int8 { // E: Enum type Bad conflicts with resource type
  One = 1,
}

// TEST: resource_after_enum
// SH: Previous
// SE: Bad conflicts with
open enum type Bad: int8 { // H: Previous declaration was here
  One = 1,
}
resource type Bad; // E: Resource type Bad conflicts with enum type

// TEST: enum_after_namespace
// SH: Previous
// SE: Bad conflicts with
namespace Bad { // H: Previous declaration was here
}
open enum type Bad: int8 { // E: Enum type Bad conflicts with namespace
  One = 1,
}

// TEST: namespace_after_enum
// SH: Previous
// SE: Bad conflicts with
open enum type Bad: int8 { // H: Previous declaration was here
  One = 1,
}
namespace Bad { // E: Namespace Bad conflicts with enum type
}

// TEST: enum_inside_node
node type Bad {
  open enum type Inner: int8 { // E: Enum type declaration not allowed inside node type
    One = 1,
  }
}

// TEST: missing_member_value
open enum type Bad: int8 {
  Missing
} // E: Syntax error

// TEST: semicolon_separator
open enum type Bad: int8 {
  One = 1; // E: Syntax error
}

// TEST: arithmetic_member_value
open enum type Bad: int8 {
  One = 1 + 2, // E: Enum member values must be integer literals
}

// TEST: unknown_member
// LIBRARIES: std
open enum type Bad: int8 {
  One = 1,
}
node n: Std.Constant {
  Type: Bad,
  Value: Bad.Two, // E: Unknown member 'Two' of Bad
}

// TEST: wrong_qualified_enum
// LIBRARIES: std
namespace A {
  open enum type Mode: int8 {
    One = 1,
  }
}
namespace B {
  open enum type Mode: int8 {
    One = 1,
  }
}
node n: Std.Constant {
  Type: A.Mode,
  Value: B.Mode.One, // E: Expected enum type A.Mode, got B.Mode
}

// TEST: wrong_relative_enum
// LIBRARIES: std
namespace A {
  open enum type Mode: int8 {
    One = 1,
  }
}
namespace B {
  open enum type Mode: int8 {
    One = 1,
  }
  node type Bad {
    parameter Value: A.Mode = Mode.One; // E: Expected enum type A.Mode, got Mode
    node value: Std.Constant {
      Type: A.Mode,
      Value: Value,
    }
  }
}
node n: B.Bad {}

// TEST: wrong_nested_enum
namespace A {
  open enum type Mode: int8 {
    One = 1,
  }
}
namespace B {
  open enum type Mode: int8 {
    One = 1,
  }
}
node type LiteralParameter {
  parameter Type: ValueType;
  parameter Value: Type;
}
node n: LiteralParameter {
  Type: List[Option[A.Mode]],
  Value: [Some(B.Mode.One)], // E: Expected enum type A.Mode, got B.Mode
}

// TEST: duplicate_value_locations
// SH: Previous member was here
// SE: Duplicate enum value 1
open enum type Duplicate: int8 {
  First = 1, // H: Previous member was here
  Second = 1, // E: Duplicate enum value 1
}

// TEST: empty_enum
closed enum type Empty {} // E: Closed enum must declare at least one member

// TEST: empty_namespaced_enum
namespace Example {
  closed enum type Empty {} // E: Closed enum must declare at least one member
}

// TEST: missing_enum_kind
enum type Legacy: uint8 { One = 1 } // E: Syntax error

// TEST: closed_underlying_type
closed enum type Bad: uint8 { One } // E: Syntax error

// TEST: closed_member_value
closed enum type Bad { One = 0 } // E: Syntax error

// TEST: open_missing_underlying
open enum type Bad { One = 0 } // E: Syntax error

// TEST: closed_duplicate_member
// SH: Previous member was here
// SE: Duplicate enum member One
closed enum type Bad {
  One, // H: Previous member was here
  One, // E: Duplicate enum member One
}

// TEST: native name on a non-native enum
open enum type Bad as "Example.Bad": uint8 { One = 1, } // E: Unexpected token

// TEST: duplicate native enum name
// SH: Previous declaration was here
// SE: Duplicate native name 'Example.Mode'
namespace Example {
  native open enum type Mode: uint8 { On = 1, } // H: Previous declaration was here
}
namespace Other {
  native closed enum type State as "Example.Mode" { On, } // E: Duplicate native name 'Example.Mode'
}
