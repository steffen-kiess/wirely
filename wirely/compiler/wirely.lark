// Grammar of Wirely source files, parsed by Lark's LALR parser with the basic
// lexer. Rule names and aliases select the AST constructor in
// parser.Transformer: "name" calls the class Name, "name__method" calls
// Name.method, and "copy" and "copy_list" pass the children through.
// Rules starting with "_" are spliced into their parent; rules starting with
// "?" are replaced by their child when they have only one.

// ---------------------------------------------------------------------------
// Files and declarations

file_input: inner_attribute* declaration*
declaration_list: inner_attribute* declaration* -> file_input
declaration: outer_attribute* bare_declaration -> attributed

// Namespaces and node types
bare_declaration: "namespace" identifier ("." identifier)* "{" declaration_list "}" -> declaration_library__make
    // TODO: Can this be done in a nicer way?
    | node_type_specifier* "node" "type" identifier ["as" string_constant] "{" declaration_list "}" -> node_type__make
    // Types
    | "struct" "type" identifier "{" struct_field_list "}" -> declaration_struct_type
    | "native" "struct" "type" identifier ["as" string_constant] "{" struct_field_list "}" -> declaration_struct_type__create_native
    | "open" "enum" "type" identifier ":" type "{" enum_member_list "}" -> declaration_enum_type__create_open
    | "closed" "enum" "type" identifier "{" closed_enum_member_list "}" -> declaration_enum_type__create_closed
    | "native" "open" "enum" "type" identifier ["as" string_constant] ":" type "{" enum_member_list "}" -> declaration_enum_type__create_native_open
    | "native" "closed" "enum" "type" identifier ["as" string_constant] "{" closed_enum_member_list "}" -> declaration_enum_type__create_native_closed
    | "resource" "type" identifier ["as" string_constant] ";" -> declaration_resource_type
    // Native functions
    | "native" "function" _signature ";" -> declaration_native_function
    | "native" "constant" "function" _signature ";" -> declaration_native_function__create_constant
    // Compile-time values
    | "constant" identifier ":" type "=" expression ";" -> declaration_constant
    | [optional_specifier] "parameter" identifier ":" type ";" -> declaration_parameter
    | "parameter" identifier ":" type "=" expression ";" -> declaration_parameter__with_default_value
    | "assert" expression ["," string_constant] ";" -> declaration_assertion
    // Node type interface
    | port_direction identifier ":" port_type_specification ";" -> declaration_port__create
    | "default" port_direction ":" port_type_specification ";" -> declaration_port__create_default
    // Nodes and connections
    | "node" identifier ":" instantiation -> declaration_instance
    | "connect" connection_source_list "->" reference ";" -> declaration_connection
    | "state" identifier ":" type "=" expression ";" -> declaration_state
    | "binding" identifier ":" port_type_specification ";" -> declaration_binding
    // Procedures and initializers
    | native_specifier "procedure" identifier ["as" string_constant] _procedure_clauses [uses_declaration] ";" -> declaration_procedure
    | "procedure" identifier _procedure_clauses expression_block -> declaration_procedure__create_body
    | "native" "initializer" depends_declaration produces_declaration [uses_declaration] ";" -> declaration_initializer

native_specifier: "native"
optional_specifier: "optional"
node_type_specifier: native_specifier -> copy
    | "singleton" -> node_type_specifier__create_singleton

// ---------------------------------------------------------------------------
// Types and native functions

struct_field_list: inner_attribute* _list{struct_field} -> file_input
struct_field: outer_attribute* bare_struct_field -> attributed
bare_struct_field: identifier ":" type -> struct_field

enum_member_list: inner_attribute* _list{enum_member} -> file_input
enum_member: outer_attribute* bare_enum_member -> attributed
bare_enum_member: identifier "=" expression -> enum_member
closed_enum_member_list: inner_attribute* _list{closed_enum_member} -> file_input
closed_enum_member: outer_attribute* bare_closed_enum_member -> attributed
bare_closed_enum_member: identifier -> enum_member__create_closed

_signature: identifier ["as" string_constant] "(" function_argument_list ")" ":" type
function_argument_list: _list{function_argument} -> copy_list
function_argument: identifier ":" type

// ---------------------------------------------------------------------------
// Ports, nodes and connections

port_type_specification: list_specifier connection_kind type -> port_type_specification_data
    | list_specifier "resource" reference -> port_type_specification_resource
list_specifier: "multi" -> list_specifier__create_list
    | () -> list_specifier__create_nolist
connection_kind: "value" -> connection_kind_specifier__create_value
    | "event" -> connection_kind_specifier__create_event
port_direction: "input" -> port_direction_specifier__create_input
    | "output" -> port_direction_specifier__create_output

instantiation: reference "{" parameter_binding_list "}" -> instantiation__make
parameter_binding_list: inner_attribute* _list{parameter_binding} -> file_input
parameter_binding: identifier ":" expression
    | identifier "?:" expression -> parameter_binding__optional

connection_source_list: _list1{connection_source} -> copy_list
connection_source: outer_attribute* reference -> attributed

// ---------------------------------------------------------------------------
// Procedures

// Clauses in fixed order; each may be omitted.
_procedure_clauses: stage_declaration depends_declaration produces_declaration
stage_declaration: () -> stage_declaration__create_default
    | "stage" "input" -> stage_declaration__create_input
    | "stage" "output" -> stage_declaration__create_output
depends_declaration: ()
    | "depends" "on" _list{procedure_port}
produces_declaration: ()
    | "produces" _list{procedure_port}
uses_declaration: "uses" _list{static_binding} -> uses_declaration__of

// A reference port connected to what it references, or a typed port wired
// with connect. A typed port's name is an identifier; it starts with
// reference to avoid an LALR conflict.
procedure_port: reference ["as" identifier | "as" string_constant] -> reference_port
    | reference ["as" string_constant] ":" port_type_specification -> typed_port__from_reference
static_binding: expression ["as" identifier | "as" string_constant]

local_binding: "let" identifier [":" type] ["=" expression] ";"
    | "let" "mut" identifier [":" type] ["=" expression] ";" -> local_binding__mutable
block_statement: outer_attribute* bare_block_statement -> attributed
?bare_block_statement: local_binding
    | "assert" expression ["," string_constant] ";" -> assertion_statement
    | expression_without_block ";" -> expression_statement
    | block_expression ";" -> expression_statement
    | block_expression -> expression_statement__unterminated
block_tail: expression_without_block -> expression_statement__unterminated

// ---------------------------------------------------------------------------
// Expressions

// Types are compile-time expressions. As in Rust, a bare struct literal is not
// allowed where a "{" can follow: in types and if conditions.
?expression: assignment{struct_atom, struct_atom}
?expression_no_struct: assignment{atom, atom}
?expression_without_block: assignment{nonblock_struct_atom, struct_atom}
?type: disjunction{atom, atom}
expression_list: _list{expression} -> copy_list

// Binary and unary operators, from lowest to highest precedence. The atom
// rules control the first operand and subsequent operands. Statement
// expressions cannot start with a block: a leading block or conditional
// ends the statement unless followed by field access or enclosed in parentheses.
?assignment{a, b}: disjunction{a, b}
    | disjunction{a, b} "=" assignment{b, b} -> assignment_expression
    | "emit" identifier ["(" expression ")"] -> emit_expression
    | "emit" "?" identifier "(" expression ")" -> emit_expression__optional
?disjunction{a, b}: conjunction{a, b}
    | disjunction{a, b} "||" conjunction{b, b} -> binary_expression__logical_or
?conjunction{a, b}: comparison{a, b}
    | conjunction{a, b} "&&" comparison{b, b} -> binary_expression__logical_and
// Comparisons do not chain.
?comparison{a, b}: bitwise_or{a, b}
    | bitwise_or{a, b} "==" bitwise_or{b, b} -> binary_expression__equal
    | bitwise_or{a, b} "!=" bitwise_or{b, b} -> binary_expression__not_equal
    | bitwise_or{a, b} "<" bitwise_or{b, b} -> binary_expression__less
    | bitwise_or{a, b} "<=" bitwise_or{b, b} -> binary_expression__less_equal
    | bitwise_or{a, b} ">" bitwise_or{b, b} -> binary_expression__greater
    | bitwise_or{a, b} ">=" bitwise_or{b, b} -> binary_expression__greater_equal
?bitwise_or{a, b}: bitwise_xor{a, b}
    | bitwise_or{a, b} "|" bitwise_xor{b, b} -> binary_expression__bitwise_or
?bitwise_xor{a, b}: bitwise_and{a, b}
    | bitwise_xor{a, b} "^" bitwise_and{b, b} -> binary_expression__bitwise_xor
?bitwise_and{a, b}: shift{a, b}
    | bitwise_and{a, b} "&" shift{b, b} -> binary_expression__bitwise_and
?shift{a, b}: sum{a, b}
    | shift{a, b} "<<" sum{b, b} -> binary_expression__shift_left
    | shift{a, b} ">>" sum{b, b} -> binary_expression__shift_right
?sum{a, b}: product{a, b}
    | sum{a, b} "+" product{b, b} -> binary_expression__add
    | sum{a, b} "-" product{b, b} -> binary_expression__subtract
?product{a, b}: unary{a, b}
    | product{a, b} "*" unary{b, b} -> binary_expression__multiply
    | product{a, b} "/" unary{b, b} -> binary_expression__divide
    | product{a, b} "%" unary{b, b} -> binary_expression__remainder
?unary{a, b}: primary{a}
    | "!" unary{b, b} -> unary_expression
    | "-" unary{b, b} -> unary_expression__negate

// A dotted name is a reference; "." after anything else is a property access.
?primary{a}: reference -> copy
    | a
?struct_atom: atom | struct_postfix
?nonblock_struct_atom: nonblock_postfix | struct_postfix
?struct_postfix: reference "{" struct_literal_field_list "}" -> struct_literal
    | struct_postfix "[" expression "]" -> bracket_operator
    | struct_postfix "(" expression_list ")" -> function_call
    | struct_postfix "." identifier -> property_access
?nonblock_postfix: nonblock_atom
    | reference "[" expression "]" -> bracket_operator
    | reference "(" expression_list ")" -> function_call
    | nonblock_postfix "[" expression "]" -> bracket_operator
    | nonblock_postfix "(" expression_list ")" -> function_call
    | nonblock_postfix "." identifier -> property_access
// Bare blocks cannot take a field suffix here; nonblock_atom handles it.
?block_postfix: block_expression | block_suffix_expression
?block_suffix_expression: block_suffix_expression "[" expression "]" -> bracket_operator
    | block_suffix_expression "(" expression_list ")" -> function_call
    | block_suffix_expression "." identifier -> property_access
    | block_expression "[" expression "]" -> bracket_operator
    | block_expression "(" expression_list ")" -> function_call
struct_literal_field_list: _list{struct_literal_field} -> copy_list
struct_literal_field: identifier ":" expression

?atom: nonblock_postfix | block_postfix
?block_expression: if_expression | expression_block | for_expression | on_expression
for_expression: "for" identifier "in" expression_no_struct expression_block
on_expression: "on" on_trigger_list expression_block
on_trigger_list: _list1{on_trigger} -> copy_list
on_trigger: identifier -> on_trigger
    | "changed" identifier -> on_trigger__changed
?nonblock_atom: int_number -> copy
    | float_number -> copy
    | string_constant -> copy
    | "(" ")" -> unit_literal
    | "(" expression ")" -> copy
    | "[" expression_list "]" -> list_literal
    | "optional" "(" expression_list ")" -> optional_expression
    | block_expression "." identifier -> property_access

?if_expression: "if" expression_no_struct expression_block [_else] -> if_expression
    | "if" _let comparison{atom, atom} expression_block [_else] -> if_let_expression
// "let Some(name) =" in an if let
_let: "let" identifier "(" identifier ")" "="
_else: "else" (expression_block | if_expression)
expression_block: "{" block_statement* block_tail? "}" -> expression_block__of

// ---------------------------------------------------------------------------
// Names and literals

reference: identifier ("." identifier)* -> reference__from_list
    | "default" port_direction -> reference__create_default

// https://doc.rust-lang.org/reference/identifiers.html
// https://doc.rust-lang.org/rust-by-example/compatibility/raw_identifiers.html
// "!" keeps the keyword tokens, see
// https://lark-parser.readthedocs.io/en/latest/tree_construction.html#pinning-rule-terminals-with
!identifier: CNAME
    | RAW_IDENTIFIER
    // Weak keywords are also accepted as identifiers.
    | "open"
    | "closed"
    | "binding"
    | "changed"
    | "constant"
    | "default"
    | "event"
    | "emit"
    | "input"
    | "in"
    | "multi"
    | "on"
    | "output"
    | "resource"
    | "stage"
    | "state"
    | "type"
    | "value"

int_number: _integer_magnitude
    | "+" _integer_magnitude -> int_number__positive
_integer_magnitude: DEC_NUMBER | HEX_NUMBER | OCT_NUMBER
float_number: FLOAT
string_constant: STRING | RAW_STRING

// ---------------------------------------------------------------------------
// Attributes: #[outer] applies to the next item, #![inner] to the enclosing one

outer_attribute: "#[" metadata "]"
inner_attribute: "#![" metadata "]"
metadata: metadata_path -> metadata_flag
    | metadata_path "=" metadata_value_literal -> metadata_value
    | metadata_path "(" metadata_arguments ")" -> metadata_list
metadata_path: identifier ("." identifier)*
metadata_arguments: _list{metadata_argument}
?metadata_argument: metadata | metadata_literal
metadata_value_literal: metadata_literal -> copy
    | metadata_path -> metadata_named_literal
metadata_literal: int_number -> metadata_literal
    | "-" int_number -> metadata_negative_int
    | float_number -> metadata_literal
    | "+" float_number -> metadata_positive_float
    | "-" float_number -> metadata_negative_float
    | string_constant -> metadata_literal

// ---------------------------------------------------------------------------
// Helpers

// Comma-separated lists, possibly empty or with at least one element, with an
// optional trailing comma
_list{x}: _list1{x}?
_list1{x}: x ("," x)* ","?

// ---------------------------------------------------------------------------
// Tokens

%import common.CNAME
RAW_IDENTIFIER: "r#" CNAME

DEC_NUMBER: /[0-9]+(?!\w)/
HEX_NUMBER: /0x[\da-f]*(?!\w)/i
OCT_NUMBER: /0o[0-7]*(?!\w)/i
%import common.FLOAT -> FLOAT

// A quote, then any number of characters other than quotes and backslashes
// (each after any number of backslashes) or of quotes (after an odd number of
// backslashes), then a quote after an even number of backslashes.
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str
STRING: /\"(\\*[^\"\\]|(\\\\)*\\\")*(\\\\)*\"/s
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str-raw
// TODO: Support raw strings with more than one #?
RAW_STRING.2: /r\"[^\"]*\"|r#\"(\"*[^\"#]|#)*\"*\"#/s

%ignore /[\t \f\r\n]+/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT

// InstanceNode comments nest. The lexer handles COMMENT_START, COMMENT_NEST,
// COMMENT_CONTENT and COMMENT_END specially; %ignore keeps them from being
// dropped as unused.
COMMENT_START: "/*"
// Like COMMENT_START, but allows multiple slashes at the beginning
COMMENT_NEST: /\/+\*/
// One or more of:
// - a character which is neither * nor /
// - one or more * followed by a character which is neither * nor /
// - one or more / followed by a character which is neither * nor /
COMMENT_CONTENT: /([^\*\/]|\*+[^\*\/]|\/+[^\*\/])+/
// Multiple stars are part of the comment end
COMMENT_END: /\*+\//
%ignore COMMENT_START
%ignore COMMENT_NEST
%ignore COMMENT_CONTENT
%ignore COMMENT_END
