// Grammar of Wirely source files, parsed by Lark's LALR parser with the basic
// lexer. Rule names and aliases select the AST constructor in
// parser.Transformer: "name" calls the class Name, "name__method" calls
// Name.method, and "copy" and "copy_list" pass the children through.
// Rules starting with "_" are spliced into their parent; rules starting with
// "?" are replaced by their child when they have only one.

// ---------------------------------------------------------------------------
// Files and declarations

file_input: inner_attribute* declaration*
declaration_list: inner_attribute* declaration* -> file_input
declaration: outer_attribute* bare_declaration -> attributed

// Namespaces and node types
bare_declaration: "namespace" identifier ("." identifier)* "{" declaration_list "}" -> declaration_library__make
    // TODO: Can this be done in a nicer way?
    | block_type_specifier* "node" "type" identifier "{" declaration_list "}" -> block_type__make
    // Types
    | "struct" "type" identifier "{" struct_field_list "}" -> declaration_struct_type
    | "enum" "type" identifier ":" type "{" enum_member_list "}" -> declaration_enum_type
    | "resource" "type" identifier ";" -> declaration_resource_type
    // Native functions
    | "native" "function" _signature ";" -> declaration_native_function
    | "native" "constant" "function" _signature ";" -> declaration_native_function__create_constant
    // Compile-time values
    | "constant" identifier ":" type "=" expression ";" -> declaration_constant
    | [optional_specifier] "parameter" identifier ":" type ";" -> declaration_parameter
    | "parameter" identifier ":" type "=" expression ";" -> declaration_parameter__with_default_value
    | "assert" expression ["," string_constant] ";" -> declaration_assertion
    // Node type interface
    | block_connector_type identifier ":" connector_specification ";" -> declaration_connector__create
    | "default" block_connector_type ":" connector_specification ";" -> declaration_connector__create_default
    // Graph members
    | "node" identifier ":" block_instantiation -> declaration_block_instantiation
    | "connect" connection_source_list "->" reference ";" -> declaration_connection
    | "state" identifier ":" type "=" expression ";" -> declaration_state_variable
    | "temporary" identifier ":" type ";" -> declaration_temporary_variable
    // Procedures and initializers
    | native_specifier "procedure" identifier ["as" string_constant] _procedure_clauses [uses_declaration] ";" -> declaration_procedure
    | "procedure" identifier _procedure_clauses procedure_body -> declaration_procedure__create_body
    | "native" "initializer" depends_declaration [uses_declaration] ";" -> declaration_initializer

native_specifier: "native"
optional_specifier: "optional"
block_type_specifier: native_specifier -> copy
    | "singleton" -> block_type_specifier__create_singleton

// ---------------------------------------------------------------------------
// Types and native functions

struct_field_list: inner_attribute* _list{struct_field} -> file_input
struct_field: outer_attribute* bare_struct_field -> attributed
bare_struct_field: identifier ":" type -> struct_field

enum_member_list: inner_attribute* _list{enum_member} -> file_input
enum_member: outer_attribute* bare_enum_member -> attributed
bare_enum_member: identifier "=" expression -> enum_member

_signature: identifier "(" function_argument_list ")" ":" type
function_argument_list: _list{function_argument} -> copy_list
function_argument: identifier ":" type

// ---------------------------------------------------------------------------
// Connectors, nodes and connections

connector_specification: list_specifier connection_kind type -> connector_specification_data
    | list_specifier "resource" reference -> connector_specification_resource
list_specifier: "multi" -> list_specifier__create_list
    | () -> list_specifier__create_nolist
connection_kind: "value" -> connection_kind_specifier__create_value
    | "event" -> connection_kind_specifier__create_event
block_connector_type: "input" -> block_connector_type_specifier__create_input
    | "output" -> block_connector_type_specifier__create_output

block_instantiation: reference "{" block_parameter_list "}"
block_parameter_list: inner_attribute* _list{block_parameter} -> file_input
block_parameter: identifier ":" expression
    | identifier "?:" expression -> block_parameter__optional

connection_source_list: _list1{connection_source} -> copy_list
connection_source: outer_attribute* reference -> attributed

// ---------------------------------------------------------------------------
// Procedures

// Clauses in fixed order; each may be omitted.
_procedure_clauses: stage_declaration depends_declaration produces_declaration
stage_declaration: () -> stage_declaration__create_default
    | "stage" "input" -> stage_declaration__create_input
    | "stage" "output" -> stage_declaration__create_output
depends_declaration: ()
    | "depends" "on" _list{procedure_binding}
produces_declaration: ()
    | "produces" _list{procedure_binding}
uses_declaration: "uses" _list{static_binding}

// A port bound to a graph member, or a typed port wired with connect.
procedure_binding: reference ["as" identifier | "as" string_constant]
    | identifier ":" connector_specification -> procedure_port
static_binding: expression ["as" identifier | "as" string_constant]

procedure_body: "{" procedure_statement* "}"
?procedure_statement: local_binding | output_assignment
local_binding: "let" identifier [":" type] "=" expression ";"
output_assignment: identifier "=" expression ";"

// ---------------------------------------------------------------------------
// Expressions

// Types are compile-time expressions. As in Rust, a bare struct literal is not
// allowed where a "{" can follow: in types and if conditions.
?expression: disjunction{struct_atom}
?expression_no_struct: disjunction{atom}
?type: expression_no_struct
expression_list: _list{expression} -> copy_list

// Binary and unary operators, from lowest to highest precedence. The
// parameter is the atom rule, which decides whether struct literals appear.
?disjunction{a}: conjunction{a}
    | disjunction{a} "||" conjunction{a} -> binary_expression__logical_or
?conjunction{a}: comparison{a}
    | conjunction{a} "&&" comparison{a} -> binary_expression__logical_and
// Comparisons do not chain.
?comparison{a}: sum{a}
    | sum{a} "==" sum{a} -> binary_expression__equal
    | sum{a} "!=" sum{a} -> binary_expression__not_equal
    | sum{a} "<" sum{a} -> binary_expression__less
    | sum{a} "<=" sum{a} -> binary_expression__less_equal
    | sum{a} ">" sum{a} -> binary_expression__greater
    | sum{a} ">=" sum{a} -> binary_expression__greater_equal
?sum{a}: product{a}
    | sum{a} "+" product{a} -> binary_expression__add
    | sum{a} "-" product{a} -> binary_expression__subtract
?product{a}: unary{a}
    | product{a} "*" unary{a} -> binary_expression__multiply
    | product{a} "/" unary{a} -> binary_expression__divide
    | product{a} "%" unary{a} -> binary_expression__remainder
?unary{a}: primary{a}
    | "!" unary{a} -> unary_expression
    | "-" unary{a} -> unary_expression__negate

// A dotted name is a reference; "." after anything else is a property access.
?primary{a}: reference -> copy
    | postfix{a}
?postfix{a}: a
    | primary{a} "[" expression "]" -> bracket_operator
    | primary{a} "(" expression_list ")" -> function_call__create
    | postfix{a} "." identifier -> property_access

?struct_atom: atom
    | reference "{" struct_literal_field_list "}" -> struct_literal
struct_literal_field_list: _list{struct_literal_field} -> copy_list
struct_literal_field: identifier ":" expression

?atom: int_number -> copy
    | float_number -> copy
    | string_constant -> copy
    | "(" ")" -> unit_literal
    | "(" expression ")" -> copy
    | "[" expression_list "]" -> list_literal
    | if_expression
    | expression_block

?if_expression: "if" expression_no_struct expression_block _else -> if_expression
    | "if" _let comparison{atom} expression_block _else -> if_let_expression
// "let Some(name) =" in an if let
_let: "let" identifier "(" identifier ")" "="
_else: "else" (expression_block | if_expression)
expression_block: "{" local_binding* expression "}"

// ---------------------------------------------------------------------------
// Names and literals

reference: identifier ("." identifier)* -> reference__from_list
    | "default" block_connector_type -> reference__create_default

// https://doc.rust-lang.org/reference/identifiers.html
// https://doc.rust-lang.org/rust-by-example/compatibility/raw_identifiers.html
// "!" keeps the keyword tokens, see
// https://lark-parser.readthedocs.io/en/latest/tree_construction.html#pinning-rule-terminals-with
!identifier: CNAME
    | RAW_IDENTIFIER
    // Weak keywords are also accepted as identifiers.
    | "constant"
    | "default"
    | "event"
    | "input"
    | "multi"
    | "on"
    | "output"
    | "resource"
    | "stage"
    | "state"
    | "type"
    | "value"

int_number: _integer_magnitude
    | "+" _integer_magnitude -> int_number__positive
_integer_magnitude: DEC_NUMBER | HEX_NUMBER | OCT_NUMBER
float_number: FLOAT
string_constant: STRING | RAW_STRING

// ---------------------------------------------------------------------------
// Attributes: #[outer] applies to the next item, #![inner] to the enclosing one

outer_attribute: "#[" metadata "]"
inner_attribute: "#![" metadata "]"
metadata: metadata_path -> metadata_flag
    | metadata_path "=" metadata_value_literal -> metadata_value
    | metadata_path "(" metadata_arguments ")" -> metadata_list
metadata_path: identifier ("." identifier)*
metadata_arguments: _list{metadata_argument}
?metadata_argument: metadata | metadata_literal
metadata_value_literal: metadata_literal -> copy
    | metadata_path -> metadata_named_literal
metadata_literal: int_number -> metadata_literal
    | "-" int_number -> metadata_negative_int
    | float_number -> metadata_literal
    | "+" float_number -> metadata_positive_float
    | "-" float_number -> metadata_negative_float
    | string_constant -> metadata_literal

// ---------------------------------------------------------------------------
// Helpers

// Comma-separated lists, possibly empty or with at least one element, with an
// optional trailing comma
_list{x}: _list1{x}?
_list1{x}: x ("," x)* ","?

// ---------------------------------------------------------------------------
// Tokens

%import common.CNAME
RAW_IDENTIFIER: "r#" CNAME

DEC_NUMBER: /[0-9]+(?!\w)/
HEX_NUMBER: /0x[\da-f]*(?!\w)/i
OCT_NUMBER: /0o[0-7]*(?!\w)/i
%import common.FLOAT -> FLOAT

// A quote, then any number of characters other than quotes and backslashes
// (each after any number of backslashes) or of quotes (after an odd number of
// backslashes), then a quote after an even number of backslashes.
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str
STRING: /\"(\\*[^\"\\]|(\\\\)*\\\")*(\\\\)*\"/s
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str-raw
// TODO: Support raw strings with more than one #?
RAW_STRING.2: /r\"[^\"]*\"|r#\"(\"*[^\"#]|#)*\"*\"#/s

%ignore /[\t \f\r\n]+/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT

// Block comments nest. The lexer handles COMMENT_START, COMMENT_NEST,
// COMMENT_CONTENT and COMMENT_END specially; %ignore keeps them from being
// dropped as unused.
COMMENT_START: "/*"
// Like COMMENT_START, but allows multiple slashes at the beginning
COMMENT_NEST: /\/+\*/
// One or more of:
// - a character which is neither * nor /
// - one or more * followed by a character which is neither * nor /
// - one or more / followed by a character which is neither * nor /
COMMENT_CONTENT: /([^\*\/]|\*+[^\*\/]|\/+[^\*\/])+/
// Multiple stars are part of the comment end
COMMENT_END: /\*+\//
%ignore COMMENT_START
%ignore COMMENT_NEST
%ignore COMMENT_CONTENT
%ignore COMMENT_END
