file_input: inner_attribute* declaration*

declaration: outer_attribute* bare_declaration -> attributed

bare_declaration: "struct" "type" identifier "{" struct_field_list "}" -> declaration_struct_type
           | "resource" "type" identifier ";" -> declaration_resource_type
           | "enum" "type" identifier ":" enum_underlying_type "{" enum_member_list "}" -> declaration_enum_type
           | "node" identifier ":" block_instantiation -> declaration_block_instantiation
           | "connect" connection_source_list "->" reference ";" -> declaration_connection
           // TODO: Can this be done in a nicer way?
           | block_type_specifier* "node" "type" identifier "{" declaration_list "}" -> block_type__make
           | "namespace" identifier ("." identifier)* "{" declaration_list "}" -> declaration_library__make
           | "state" identifier ":" value "=" value ";" -> declaration_state_variable
           | "temporary" identifier ":" value ";" -> declaration_temporary_variable
           | native_specifier "procedure" identifier ["as" string_constant] stage_declaration depends_declaration produces_declaration ";" -> declaration_procedure
           | "procedure" identifier stage_declaration depends_declaration produces_declaration procedure_body -> declaration_procedure__create_body
           | "native" "initializer" depends_declaration ";" -> declaration_initializer
           | block_connector_type identifier ":" connector_specification ";" -> declaration_connector__create
           | "default" block_connector_type ":" connector_specification ";" -> declaration_connector__create_default
           | [optional_specifier] "parameter" identifier ":" value ";" -> declaration_parameter
           | "parameter" identifier ":" value "=" value ";" -> declaration_parameter__with_default_value
declaration_list: inner_attribute* declaration* -> file_input

enum_underlying_type: reference -> copy
                    | enum_underlying_type "[" value "]" -> bracket_operator
struct_field_list: inner_attribute* (struct_field ("," struct_field)* ","?)? -> file_input
struct_field: outer_attribute* bare_struct_field -> attributed
bare_struct_field: identifier ":" value -> struct_field
struct_literal_field_list: (struct_literal_field ("," struct_literal_field)* ","?)? -> copy_list
struct_literal_field: identifier ":" value

enum_member_list: inner_attribute* (enum_member ("," enum_member)* ","?)? -> file_input
enum_member: outer_attribute* bare_enum_member -> attributed
bare_enum_member: identifier "=" value -> enum_member

block_instantiation: reference "{" block_parameter_list "}" -> block_instantiation

stage_declaration: -> stage_declaration__create_default
                 | "stage" "input" -> stage_declaration__create_input
                 | "stage" "output" -> stage_declaration__create_output

depends_declaration: -> depends_declaration
                   | "depends" "on" _separated_empty{procedure_binding, ","} -> depends_declaration

produces_declaration: -> produces_declaration
                   | "produces" _separated_empty{procedure_binding, ","} -> produces_declaration

procedure_binding: reference -> procedure_binding
                 | reference "as" string_constant -> procedure_binding
                 | reference "as" identifier -> procedure_binding

block_parameter_list: inner_attribute* _separated_empty{block_parameter, ","} -> file_input

block_parameter: identifier ":" value

native_specifier: "native" -> native_specifier

optional_specifier: "optional" -> optional_specifier

block_type_specifier: native_specifier -> copy
                    | "singleton" -> block_type_specifier__create_singleton
block_type_specifier_list: block_type_specifier* -> copy_list

connector_specification: list_specifier connection_kind value -> connector_specification_data
                       | list_specifier "resource" reference -> connector_specification_resource

connection_kind: "value" -> connection_kind_specifier__create_value
               | "event" -> connection_kind_specifier__create_event

block_connector_type: "input" -> block_connector_type_specifier__create_input
                    | "output" -> block_connector_type_specifier__create_output

list_specifier: "multi" -> list_specifier__create_list
              | ()     -> list_specifier__create_nolist

?value: or_expression
?or_expression: and_expression
              | or_expression "||" and_expression -> binary_expression__logical_or
?and_expression: equality_expression
               | and_expression "&&" equality_expression -> binary_expression__logical_and
?equality_expression: unary_expression
                    | unary_expression "==" unary_expression -> binary_expression__equal
                    | unary_expression "!=" unary_expression -> binary_expression__not_equal
?unary_expression: atom
                 | "!" unary_expression -> unary_expression
?atom: reference "{" struct_literal_field_list "}" -> struct_literal
     | reference -> copy
     | int_number -> copy
     | float_number -> copy
     | string_constant -> copy
     | "(" ")" -> unit_literal
     | "(" value ")" -> copy
     | atom "[" value "]" -> bracket_operator
     | atom "(" value_list ")" -> function_call
     | "[" value_list "]" -> list_literal
     | if_expression
     | expression_block

if_expression: "if" condition expression_block "else" expression_block
             | "if" condition expression_block "else" if_expression
// A bare struct literal cannot be an if condition, as in Rust.
?condition: condition_or
?condition_or: condition_and
             | condition_or "||" condition_and -> binary_expression__logical_or
?condition_and: condition_equality
              | condition_and "&&" condition_equality -> binary_expression__logical_and
?condition_equality: condition_unary
                  | condition_unary "==" condition_unary -> binary_expression__equal
                  | condition_unary "!=" condition_unary -> binary_expression__not_equal
?condition_unary: condition_atom
                | "!" condition_unary -> unary_expression
?condition_atom: reference -> copy
               | int_number -> copy
               | float_number -> copy
               | string_constant -> copy
               | "(" value ")" -> copy
               | condition_atom "(" value_list ")" -> function_call

expression_block: "{" local_binding* value "}"
procedure_body: "{" procedure_statement* "}"
?procedure_statement: local_binding | result_assignment
local_binding: "let" identifier [":" value] "=" value ";"
result_assignment: identifier "=" value ";"

value_list: _separated_empty{value, ","} -> copy_list

reference: identifier ("." identifier)* -> reference__from_list
         | "default" block_connector_type -> reference__create_default
reference_list: _separated_empty{reference, ","} -> copy_list

int_number: _integer_magnitude
          | "+" _integer_magnitude -> int_number__positive
          | "-" _integer_magnitude -> int_number__negative
_integer_magnitude: DEC_NUMBER | HEX_NUMBER | OCT_NUMBER
float_number: FLOAT
string_constant: STRING | RAW_STRING
// Tokens

// COMMENT: /\/\/[^\n]*/
//        | /\/\*([^\*]|\*[^\/])*\*\//

COMMENT: /\/\/[^\n]*/
%ignore COMMENT

// COMMENT_START, COMMENT_NEST, COMMENT_CONTENT and COMMENT_END are handled specially by the lexer
COMMENT_START: "/*"
// Similar to COMMENT_START, but allows mulitple slashes at the beginning
COMMENT_NEST: /\/+\*/
// A comment content consists of one or more of:
// - something which is neither * nor /
// - one or more * followed by something which is neither * nor /
// - one or more / followed by something which is neither * nor /
COMMENT_CONTENT: /([^\*\/]|\*+[^\*\/]|\/+[^\*\/])+/
// Note: Multiple stars are considered part of the comment end
COMMENT_END: /\*+\//

// %ignore is needed to prevent these terminals from being dropped as unused
%ignore COMMENT_START
%ignore COMMENT_NEST
%ignore COMMENT_CONTENT
%ignore COMMENT_END

// String: A quote, followed an arbitrary number of normal character (preceeded by an arbitrary number of backslashes) or quotes (preceeded by an odd number of backslashes), followed by a quote (preceeded by an even number of backslashes)
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str
STRING: /\"(\\*[^\"\\]|(\\\\)*\\\")*(\\\\)*\"/s
// https://doc.rust-lang.org/reference/tokens.html#r-lex.token.literal.str-raw
// TODO: Support raw strings with more than one #?
RAW_STRING.2: /r\"[^\"]*\"|r#\"(\"*[^\"#]|#)*\"*\"#/s

DEC_NUMBER: /[0-9]+(?!\w)/
HEX_NUMBER: /0x[\da-f]*(?!\w)/i
OCT_NUMBER: /0o[0-7]*(?!\w)/i
%import common.FLOAT -> FLOAT

%import common.CNAME
// https://doc.rust-lang.org/reference/identifiers.html
// https://doc.rust-lang.org/rust-by-example/compatibility/raw_identifiers.html
// https://lark-parser.readthedocs.io/en/latest/tree_construction.html#pinning-rule-terminals-with
!identifier: CNAME
           | RAW_IDENTIFIER
// Weak keywords are also accepted as identifiers.
           | "default"
           | "event"
           | "input"
           | "multi"
           | "on"
           | "output"
           | "resource"
           | "stage"
           | "state"
           | "type"
           | "value"
RAW_IDENTIFIER: "r#" CNAME

%ignore /[\t \f\r\n]+/

_separated_nonempty{x, sep}: x (sep x)* sep?
_separated_empty{x, sep}: _separated_nonempty{x, sep}?

outer_attribute: "#[" metadata "]"
inner_attribute: "#![" metadata "]"
metadata_path: identifier ("." identifier)*
metadata: metadata_path -> metadata_flag
        | metadata_path "=" metadata_value_literal -> metadata_value
        | metadata_path "(" metadata_arguments ")" -> metadata_list
metadata_arguments: ((metadata | metadata_literal) ("," (metadata | metadata_literal))* ","?)? -> metadata_arguments
metadata_value_literal: metadata_literal -> copy
                      | metadata_path -> metadata_named_literal
metadata_literal: int_number -> metadata_literal
                | float_number -> metadata_literal
                | "+" float_number -> metadata_positive_float
                | "-" float_number -> metadata_negative_float
                | string_constant -> metadata_literal
connection_source_list: _separated_nonempty{connection_source, ","} -> copy_list
connection_source: outer_attribute* reference -> attributed
