namespace MQTT {
  native open enum type Format: uint8 {
    Default = 1,
    SnakeCase = 2,
  }

  #[Internal]
  native constant function SupportsType(type: type): boolean;

  #[Internal]
  native struct type TemplateParts {
    prefix: string,
    suffix: string,
  }
  #[Internal]
  native constant function ParseTemplate(template: Option[string]): TemplateParts;

  resource type Broker;

  node type Connection {
    parameter URI: string;
    parameter KeepAlive: Std.Duration = "PT60S";

    default output: fixed Broker;
    output Connected: value boolean;

    native initializer create
      reads URI, KeepAlive
      writes default output as "broker";

    native procedure get_connected stage input
      reads default output as "broker"
      writes Connected as "connected";
  }

  #[Internal]
  resource type ValueOptionProviderState;

  node type ValueOptionProvider {
    parameter Type: type;
    #[Diagram.ShowValue]
    parameter Topic: string;
    optional parameter Format: MQTT.Format;
    optional parameter Template: string;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(optional(Template));

    input Broker: fixed Broker;
    default input: value Option[Type];

    binding state: fixed ValueOptionProviderState;
    native initializer create
      reads Broker, Type, Topic, optional(Format) as Format, template_parts
      writes state as "state";

    native procedure set_value stage output
      reads state as "state", default input as "input", Type;
  }

  node type ValueProvider {
    parameter Type: type;
    #[Diagram.ShowValue]
    parameter Topic: string;
    optional parameter Format: MQTT.Format;
    optional parameter Template: string;

    input Broker: fixed Broker;
    default input: value Type;

    node create_option: Std.OptionSome { InnerType: Type }
    connect default input -> create_option;

    node impl: ValueOptionProvider {
      Type: Type,
      Topic: Topic,
      Format?: optional(Format),
      Template?: optional(Template),
    }
    connect Broker -> impl.Broker;
    connect create_option -> impl;
  }

  #[Internal]
  resource type EventSenderState;

  node type EventSender {
    parameter Type: type;
    #[Diagram.ShowValue]
    parameter Topic: string;
    optional parameter Format: MQTT.Format;
    optional parameter Template: string;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(optional(Template));

    input Broker: fixed Broker;
    default input: event Type;

    binding state: fixed EventSenderState;
    native initializer create
      reads Broker, Type, Topic, optional(Format) as Format, template_parts
      writes state as "state";

    native procedure send_value stage output
      reads state as "state", default input as "input", Type;
  }

  #[Internal]
  resource type EventReceiverState;

  node type EventReceiver {
    parameter Type: type;
    #[Diagram.ShowValue]
    parameter Topic: string;
    optional parameter Format: MQTT.Format;
    // TODO optional parameter Template : string;

    assert SupportsType(Type), "Unsupported type for MQTT";

    input Broker: fixed Broker;
    default output: event Type;

    binding state: fixed EventReceiverState;
    native initializer create
      reads Broker, Type, Topic, optional(Format) as Format
      writes state as "state";

    native procedure get_value stage input
      reads state as "state", Type
      writes default output as "output";
  }
}
