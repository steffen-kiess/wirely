namespace MQTT {
  enum type Format: uint8 {
    Default = 1,
    SnakeCase = 2,
  }

  #[Internal]
  native constant function SupportsType(type: ValueType): boolean;

  #[Internal]
  struct type TemplateParts {
    prefix: String,
    suffix: String,
  }
  #[Internal]
  native constant function ParseTemplate(template: Option[String]): TemplateParts;

  resource type Broker;

  native node type Connection {
    parameter URI: String;

    default output: resource Broker;

    native initializer produces default output as "broker" uses URI;
  }

  #[Internal]
  resource type ValueOptionProviderState;

  native node type ValueOptionProvider {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Topic: String;
    optional parameter Format: MQTT.Format;
    optional parameter Template: String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(optional(Template));

    input Broker: resource Broker;
    default input: value Option[Type];

    resource state: ValueOptionProviderState;
    native initializer depends on Broker
      produces state as "state"
      uses Type, Topic, optional(Format) as Format, template_parts;

    native procedure set_value stage output
      depends on state as "state", default input as "input";
  }

  node type ValueProvider {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Topic: String;
    optional parameter Format: MQTT.Format;
    optional parameter Template: String;

    input Broker: resource Broker;
    default input: value Type;

    node create_option: Std.OptionSome { InnerType: Type }
    connect default input -> create_option;

    node impl: ValueOptionProvider {
      Type: Type,
      Topic: Topic,
      Format?: optional(Format),
      Template?: optional(Template),
    }
    connect Broker -> impl.Broker;
    connect create_option -> impl;
  }

  #[Internal]
  resource type EventSenderState;

  native node type EventSender {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Topic: String;
    optional parameter Format: MQTT.Format;
    optional parameter Template: String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(optional(Template));

    input Broker: resource Broker;
    default input: event Type;

    resource state: EventSenderState;
    native initializer depends on Broker
      produces state as "state"
      uses Type, Topic, optional(Format) as Format, template_parts;

    native procedure send_value stage output
      depends on state as "state", default input as "input";
  }

  #[Internal]
  resource type EventReceiverState;

  native node type EventReceiver {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Topic: String;
    optional parameter Format: MQTT.Format;
    // TODO optional parameter Template : String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    input Broker: resource Broker;
    default output: event Type;

    resource state: EventReceiverState;
    native initializer depends on Broker
      produces state as "state"
      uses Type, Topic, optional(Format) as Format;

    native procedure get_value stage input
      depends on state as "state"
      produces default output as "output";
  }
}
