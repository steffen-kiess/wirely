namespace MQTT {
  native function SupportsType(type: ValueType): boolean;

  // Internal template representation.
  struct type TemplateParts {
    prefix: String,
    suffix: String,
  }
  // Internal template parser.
  native function ParseTemplate(template: Option[String]): TemplateParts;

  resource type Broker;

  native node type Connection {
    parameter URI: String;

    default output: resource Broker;

    native initializer uses URI;
  }

  native node type ValueOptionProvider {
    parameter Type: ValueType;
    parameter Topic: String;
    optional parameter Format: String;
    optional parameter Template: String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(parameter_option(Template));

    input Broker: resource Broker;
    default input: value Option[Type];

    native initializer depends on Broker
      uses Type, Topic, parameter_option(Format) as Format, template_parts;

    native procedure set_value stage output
      depends on default input as "input";
  }

  node type ValueProvider {
    parameter Type: ValueType;
    parameter Topic: String;
    optional parameter Format: String;
    optional parameter Template: String;

    input Broker: resource Broker;
    default input: value Type;

    node create_option: Std.OptionSome { InnerType: Type }
    connect default input -> create_option;

    node impl: ValueOptionProvider {
      Type: Type,
      Topic: Topic,
      Format?: parameter_option(Format),
      Template?: parameter_option(Template),
    }
    connect Broker -> impl.Broker;
    connect create_option -> impl;
  }

  native node type EventSender {
    parameter Type: ValueType;
    parameter Topic: String;
    optional parameter Format: String;
    optional parameter Template: String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    constant template_parts: TemplateParts =
      ParseTemplate(parameter_option(Template));

    input Broker: resource Broker;
    default input: event Type;

    native initializer depends on Broker
      uses Type, Topic, parameter_option(Format) as Format, template_parts;

    native procedure send_value stage output
      depends on default input as "input";
  }

  native node type EventReceiver {
    parameter Type: ValueType;
    parameter Topic: String;
    optional parameter Format: String;
    // TODO optional parameter Template : String;

    assert SupportsType(Type), "Unsupported type for MQTT";

    input Broker: resource Broker;
    default output: event Type;

    native initializer depends on Broker
      uses Type, Topic, parameter_option(Format) as Format;

    native procedure get_value stage input produces default output as "output";
  }
}
