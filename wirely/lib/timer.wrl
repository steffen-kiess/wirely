namespace Timer {
  // A monotonic clock reading.
  opaque struct type MonotonicTime {
    // Ticks of 2^-64 s.
    Ticks: uint128,
    // Clock generation; generation 0 is never current.
    Generation: uint64,
  }
  namespace MonotonicTime {
    native function SaturatingAdd(time: MonotonicTime, duration: Std.Duration): MonotonicTime;
    native function SaturatingSub(time: MonotonicTime, duration: Std.Duration): MonotonicTime;
    native function CheckedAdd(time: MonotonicTime, duration: Std.Duration): Option[MonotonicTime];
    native function CheckedSub(time: MonotonicTime, duration: Std.Duration): Option[MonotonicTime];
    native function CheckedDurationSince(time: MonotonicTime, earlier: MonotonicTime): Option[Std.Duration];
    native function CheckedLess(a: MonotonicTime, b: MonotonicTime): Option[boolean];
  }

  // Emits the start time of each step in which the input event is present.
  node type MonotonicTimestamp {
    parameter Type: ValueType = unit;

    default input: event Type;
    default output: event MonotonicTime;

    native procedure run
      depends on default input as "input"
      produces default output as "output"
      uses Type;
  }

  // Block which returns false if the current time is before input, true if the
  // current time is at or after input, and None if the input is None or not
  // comparable to the current time.
  node type MonotonicTimeReached {
    default input: value Option[MonotonicTime];
    default output: value Option[boolean];

    native procedure run
      depends on default input as "input"
      produces default output as "output";
  }

  node type DurationElapsed {
    parameter Duration: Std.Duration;

    default input: value Option[MonotonicTime];
    default output: value Option[boolean];

    node reached: MonotonicTimeReached {}

    procedure deadline
      depends on default input as start
      produces time: value Option[MonotonicTime]
    {
      time = if let Some(start_time) = start {
        Some(MonotonicTime.SaturatingAdd(start_time, Duration))
      } else {
        None
      };
    }
    connect deadline.time -> reached;
    connect reached -> default output;
  }

  // Output the initial value immediately, then accept changes after the input
  // remains stable for Duration.
  node type DebounceStable {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Duration: Std.Duration;

    default input: value Type;
    default output: value Type;

    // The value which was last sent as output
    state current_value: Option[Type] = None;
    // The pending value, or None while there is no pending change.
    state pending_value: Option[Type] = None;
    // Start of the pending change, or None while there is none.
    state change_started_at: Option[MonotonicTime] = None;

    node change_time: MonotonicTimestamp {}
    node elapsed: DurationElapsed { Duration: Duration }
    connect change_started_at.old -> elapsed;

    procedure run
      depends on default input as input, current_value.old as current_value_old,
        pending_value.old as pending_value_old, elapsed
      produces default output as output, current_value, pending_value,
        restart: event unit
    {
      let lost = pending_value_old.IsSome && elapsed.IsNone;
      if current_value_old.IsNone || lost || current_value_old == Some(input) {
        // Startup and clock loss accept the input immediately. Returning to
        // the current output cancels any pending change.
        current_value = Some(input);
        pending_value = None;
        output = input;
      } else if pending_value_old != Some(input) {
        // A different pending value starts a new stability interval.
        current_value = current_value_old;
        pending_value = Some(input);
        // The first branch handles current_value_old.IsNone, so the fallback
        // is unreachable here and in the waiting branch below.
        output = current_value_old.UnwrapOr(input);
      } else if elapsed == Some(true) {
        current_value = pending_value_old;
        pending_value = None;
        output = input;
      } else {
        // Keep the output and pending value while waiting for stability.
        current_value = current_value_old;
        pending_value = pending_value_old;
        output = current_value_old.UnwrapOr(input);
      }
      on changed pending_value {
        if pending_value.IsSome { emit restart; }
      }
    }
    connect run.restart -> change_time;

    procedure record
      depends on change_time, pending_value.new as pending_value_new,
        change_started_at.old as change_started_at_old
      produces change_started_at
    {
      change_started_at = if optional(change_time).IsSome {
        optional(change_time)
      } else if pending_value_new.IsSome {
        change_started_at_old
      } else {
        None
      };
    }
  }

  // TODO: Add DebounceLockout (first change is passed though, fixed lock-out
  // interval after that) and/or DebouncePrompt (first change is passed
  // through, then wait for stability before allowing the next change to pass)?
  // See also: <https://github.com/thomasfredericks/Bounce2/blob/master/README.md#alternate-algorithms>
}
