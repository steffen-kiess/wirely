namespace KNX {
  open enum type Protocol: uint8 {
    TCP = 1,
    UDP = 2,
    Unix = 3,
    Auto = 4,
  }

  #[Internal]
  native constant function ParseGroupAddress(address: String): uint16;
  #[Internal]
  native constant function ValueTypeName(type: ValueType): String;
  #[Internal]
  native constant function SupportsValueType(type: ValueType): boolean;

  resource type Bus;

  native node type Connection {
    optional parameter Host: String;
    optional parameter Protocol: KNX.Protocol;
    optional parameter Port: uint16;
    optional parameter UnixPath: String;
    optional parameter SSHTarget: String;
    optional parameter IndividualAddress: String;

    default output: resource Bus;

    native initializer
      produces default output as "bus"
      uses optional(Host) as Host,
        optional(Protocol) as Protocol,
        optional(Port) as Port,
        optional(UnixPath) as UnixPath,
        optional(SSHTarget) as SSHTarget,
        optional(IndividualAddress) as IndividualAddress;
  }

  #[Internal]
  resource type ValueReceiverState;

  native node type ValueReceiver {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter GroupAddress: String;
    // TODO: Mores parameter with information about read-on-init etc.?
    // TODO: event input which can trigger read?
    // TODO: event output which is triggered when a value is received, even if
    // the value stays the same? Should this event contain the value?

    assert SupportsValueType(Type), "Unsupported value type for KNX";

    constant group_address: uint16 = ParseGroupAddress(GroupAddress);
    constant value_type_name: String = ValueTypeName(Type);

    input Bus: resource Bus;
    default output: value Option[Type];

    binding state: resource ValueReceiverState;
    native initializer depends on Bus
      produces state as "state"
      uses Type, group_address, value_type_name;

    native procedure get_value stage input
      depends on state as "state"
      produces default output as "output";
  }

  #[Internal]
  resource type ValueOptionProviderState;

  native node type ValueOptionProvider {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter GroupAddress: String;
    // TODO: More parameter with information about transmitting behavior etc.?
    // TODO: event input which can trigger transmission?
    // TODO: event output for reads? Probably not really useful.

    assert SupportsValueType(Type), "Unsupported value type for KNX";

    constant group_address: uint16 = ParseGroupAddress(GroupAddress);
    constant value_type_name: String = ValueTypeName(Type);

    input Bus: resource Bus;
    default input: value Option[Type];

    binding state: resource ValueOptionProviderState;
    native initializer depends on Bus
      produces state as "state"
      uses Type, group_address, value_type_name;

    native procedure set_value stage output
      depends on state as "state", default input as "input";
  }

  node type ValueProvider {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter GroupAddress: String;

    input Bus: resource Bus;
    default input: value Type;

    node create_option: Std.OptionSome { InnerType: Type }
    connect default input -> create_option;

    node impl: ValueOptionProvider { Type: Type, GroupAddress: GroupAddress }
    connect Bus -> impl.Bus;
    connect create_option -> impl;
  }

  #[Internal]
  resource type EventReceiverState;

  native node type EventReceiver {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter GroupAddress: String;

    constant group_address: uint16 = ParseGroupAddress(GroupAddress);
    constant value_type_name: String = ValueTypeName(Type);

    input Bus: resource Bus;
    default output: event Type;

    binding state: resource EventReceiverState;
    native initializer depends on Bus
      produces state as "state"
      uses Type, group_address, value_type_name;

    native procedure get_value stage input
      depends on state as "state"
      produces default output as "output";
  }

  #[Internal]
  resource type EventSenderState;

  native node type EventSender {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter GroupAddress: String;

    constant group_address: uint16 = ParseGroupAddress(GroupAddress);
    constant value_type_name: String = ValueTypeName(Type);

    input Bus: resource Bus;
    default input: event Type;

    binding state: resource EventSenderState;
    native initializer depends on Bus
      produces state as "state"
      uses Type, group_address, value_type_name;

    native procedure send_value stage output
      depends on state as "state", default input as "input";
  }
}
