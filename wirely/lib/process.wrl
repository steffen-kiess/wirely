namespace Process {
  #[Internal]
  resource type LaunchOnEventState;

  native node type LaunchOnEvent {
    // Will be passed to "sh -c"
    #[Diagram.ShowValue]
    parameter ShellCommand: String;
    parameter Type: type = unit;
    // Note: The value of the event will be ignored
    default input: event Type;

    binding state: resource LaunchOnEventState;
    native initializer produces state as "state" uses ShellCommand;

    native procedure run stage output
      depends on state as "state", default input as "input"
      uses Type;
  }
}
