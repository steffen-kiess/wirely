namespace Process {
  #[Internal]
  resource type LaunchOnEventState;

  node type LaunchOnEvent {
    // Will be passed to "sh -c"
    #[Diagram.ShowValue]
    parameter ShellCommand: string;
    parameter Type: type = unit;
    // Note: The value of the event will be ignored
    default input: event Type;

    binding state: fixed LaunchOnEventState;
    native initializer create reads ShellCommand writes state as "state";

    native procedure run stage output
      reads state as "state", default input as "input", Type;
  }
}
