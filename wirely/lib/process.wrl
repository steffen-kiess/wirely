namespace Process {
  native node type LaunchOnEvent {
    // Will be passed to "sh -c"
    #[summary]
    parameter ShellCommand: String;
    parameter Type: ValueType = unit;
    // Note: The value of the event will be ignored
    default input: event Type;

    native initializer uses ShellCommand;

    native procedure run stage output depends on default input as "input";
  }
}
