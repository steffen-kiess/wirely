namespace Schedule {
  #[Internal]
  native constant function IsValidDailyInterval(start: TimeOfDay, end: TimeOfDay): boolean;

  #[Internal]
  resource type TimeOfDayMinuteState;

  #[Internal]
  native singleton node type TimeOfDayMinute {
    default output: value TimeOfDay;

    binding state: resource TimeOfDayMinuteState;
    native initializer produces state as "state";

    // TODO: Should this be "stage input"? Should this use some global time?
    native procedure get_value
      depends on state as "state"
      produces default output as "output";
  }

  // TODO: Implement this in a way which does not cause code to be run every
  // minute
  node type IsInDailyInterval {
    #[Diagram.ShowValue]
    parameter Start: TimeOfDay;
    #[Diagram.ShowValue]
    parameter End: TimeOfDay;

    assert IsValidDailyInterval(Start, End), "Start and End must differ";

    default output: value boolean;

    node current_time: TimeOfDayMinute {}

    native procedure run
      depends on current_time
      produces default output as "output" uses Start, End;
  }

  // Creates an event whenever the current time changes from the range of 8
  // hours before Time to the range 2 hours after Time, if since the last time
  // it was in the range 2 hours after Time the time was at lease once outside
  // both ranges. 8/2 hours should be long enough to allow triggering even
  // during DST changes and make sure that it is triggered only once a day
  // during DST changes.
  // TODO: Make ranges configurable? (In that case something needs to make sure
  // that the don't overlap, and probably that they don't add up to 24h.)
  node type TriggerAt {
    #[Diagram.ShowValue]
    parameter Time: TimeOfDay;

    // Defaults to unit
    parameter OutputType: ValueType = unit;
    // Defaults to () when OutputType is unit
    optional parameter OutputValue: OutputType;

    assert OutputType == unit || optional(OutputValue).IsSome,
      "OutputValue is required when OutputType is not unit";

    default output: event OutputType;

    // Keeps track of the last state
    // TODO: Introduce an enum for this?
    // 0: Initial state / outside any range
    // 1: In 'before' range, transition to 'after' range will trigger output
    // 2: Has already triggered (or at least was in 'after' range), waiting for
    // time outside any range
    state trigger_state: uint8 = 0;

    // Note: This relies on both blocks using the same time source, so that
    // there is no cycle/step at the Time where both or neither are true.
    node before: IsInDailyInterval {
      Start: TimeOfDay.WrappingSub(Time, "PT8H"),
      End: Time,
    }
    node after: IsInDailyInterval {
      Start: Time,
      End: TimeOfDay.WrappingAdd(Time, "PT2H"),
    }

    native procedure run
      depends on trigger_state.old as "state_old", before, after
      produces default output as "output", trigger_state
      uses optional(OutputValue) as OutputValue;
  }
}
