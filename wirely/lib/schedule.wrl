namespace Schedule {
  // Time within a day.
  opaque struct type TimeOfDay {
    // Ticks of 2^-64 s since midnight; at most 24 hours.
    Ticks: uint128,
  }
  namespace TimeOfDay {
    #[Internal]
    native function Less(a: TimeOfDay, b: TimeOfDay): boolean;
    native function WrappingAdd(time: TimeOfDay, duration: Std.Duration): TimeOfDay;
    native function WrappingSub(time: TimeOfDay, duration: Std.Duration): TimeOfDay;
    native function DurationUntil(from: TimeOfDay, to: TimeOfDay): Std.Duration;
  }

  #[Internal]
  native constant function IsValidDailyInterval(start: TimeOfDay, end: TimeOfDay): boolean;

  #[Internal]
  singleton node type TimeOfDayMinute {
    default output: value Option[TimeOfDay];

    // TODO: Should this be "stage input"?
    native procedure get_value produces default output as "output";
  }

  node type IsInDailyInterval {
    #[Diagram.ShowValue]
    parameter Start: TimeOfDay;
    #[Diagram.ShowValue]
    parameter End: TimeOfDay;

    assert IsValidDailyInterval(Start, End), "Start and End must differ";

    default output: value Option[boolean];

    native procedure run
      produces default output as output
      uses Start, End;
  }

  #[Internal]
  closed enum type TriggerAtState {
    // Initial state, or outside both intervals.
    Outside,
    // In the before interval; entering the after interval will emit an event.
    Before,
    // Already visited the after interval; wait until outside both to re-arm.
    Triggered,
  }

  // Creates an event whenever the current time changes from the range of 8
  // hours before Time to the range 2 hours after Time, if since the last time
  // it was in the range 2 hours after Time the time was at lease once outside
  // both ranges. 8/2 hours should be long enough to allow triggering even
  // during DST changes and make sure that it is triggered only once a day
  // during DST changes.
  // TODO: Make ranges configurable? (In that case something needs to make sure
  // that the don't overlap, and probably that they don't add up to 24h.)
  node type TriggerAt {
    #[Diagram.ShowValue]
    parameter Time: TimeOfDay;

    // Defaults to unit
    parameter OutputType: type = unit;
    // Defaults to () when OutputType is unit
    parameter OutputValue: OutputType = ();

    default output: event OutputType;

    state trigger_state: TriggerAtState = TriggerAtState.Outside;

    // Note: This relies on both blocks using the same time source, so that
    // there is no cycle/step at the Time where both or neither are true.
    node before: IsInDailyInterval {
      Start: TimeOfDay.WrappingSub(Time, "PT8H"),
      End: Time,
    }
    node after: IsInDailyInterval {
      Start: Time,
      End: TimeOfDay.WrappingAdd(Time, "PT2H"),
    }

    procedure run
      depends on trigger_state.old as previous, before, after
      produces default output as output, trigger_state
    {
      trigger_state = if let Some(is_before) = before {
        if let Some(is_after) = after {
          if is_before && is_after {
            // The shared clock makes this impossible; keep the state if it occurs.
            previous
          } else if is_after {
            // Startup here, or skipping the before interval, records the visit
            // without emitting an event.
            TriggerAtState.Triggered
          } else if is_before {
            if previous == TriggerAtState.Outside {
              TriggerAtState.Before
            } else {
              // A clock rollback into the before interval, for example during DST
              // changes, must not re-arm a Triggered state: returning to after
              // would emit a duplicate.
              previous
            }
          } else {
            // Leaving both intervals allows a new before-to-after transition.
            TriggerAtState.Outside
          }
        } else {
          TriggerAtState.Outside
        }
      } else {
        TriggerAtState.Outside
      };
      on changed trigger_state {
        if previous == TriggerAtState.Before
            && trigger_state == TriggerAtState.Triggered {
          emit output(OutputValue);
        }
      }
    }
  }
}
