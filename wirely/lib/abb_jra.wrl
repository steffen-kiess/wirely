namespace ABB.JRA {
  node type InterpretStatusInformation {
    default input: value uint16;
    output ManualOperation: value boolean;
    output BlockActive: value boolean;
    output ForcedOperation: value boolean;
    output FrostAlarm: value boolean;
    output RainAlarm: value boolean;
    output WindAlarm: value boolean;
    output AutomaticSunProtection: value boolean;
    output AutomaticHeatingCooling: value boolean;
    output DriveError: value boolean;
    output DriveInMotion: value boolean;
    output DriveDown: value boolean;
    output DriveUp: value boolean;
    output SendReceiveDelayActive: value boolean;
    // output Unassigned13 : value boolean;
    // output Unassigned14 : value boolean;
    // output Unassigned15 : value boolean;

    native procedure run
      depends on default input as "input"
      produces ManualOperation, BlockActive, ForcedOperation, FrostAlarm,
        RainAlarm, WindAlarm, AutomaticSunProtection, AutomaticHeatingCooling,
        DriveError, DriveInMotion, DriveDown, DriveUp, SendReceiveDelayActive;
  }

  node type InterpretStatusInformationOption {
    default input: value Option[uint16];
    output ManualOperation: value Option[boolean];
    output BlockActive: value Option[boolean];
    output ForcedOperation: value Option[boolean];
    output FrostAlarm: value Option[boolean];
    output RainAlarm: value Option[boolean];
    output WindAlarm: value Option[boolean];
    output AutomaticSunProtection: value Option[boolean];
    output AutomaticHeatingCooling: value Option[boolean];
    output DriveError: value Option[boolean];
    output DriveInMotion: value Option[boolean];
    output DriveDown: value Option[boolean];
    output DriveUp: value Option[boolean];
    output SendReceiveDelayActive: value Option[boolean];
    // output Unassigned13 : value Option[boolean];
    // output Unassigned14 : value Option[boolean];
    // output Unassigned15 : value Option[boolean];

    native procedure run
      depends on default input as "input"
      produces ManualOperation, BlockActive, ForcedOperation, FrostAlarm,
        RainAlarm, WindAlarm, AutomaticSunProtection, AutomaticHeatingCooling,
        DriveError, DriveInMotion, DriveDown, DriveUp, SendReceiveDelayActive;

    // TODO: Make this work?
