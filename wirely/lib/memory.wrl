namespace Memory {
  // TODO: Add node type FlipFlop?

  // TODO: Move to another library (e.g. "FlipFlop")?
  // TODO: Name? This will send a trigger value in order to change an external
  // toggle flip-flop to a certain value.
  node type ToggleFlipFlopTrigger {
    default input: event boolean;

    // Value which indicates the current value of the toggle flip-flop. While
    // this is None input values will be ignored (because the flip-flop is
    // assumed to be unavailable).
    // TODO: Should this store the last command until the flip-flop gets
    // available? Probably not.
    input Feedback: value Option[boolean];

    parameter OutputType: type = unit;
    // Defaults to () when OutputType is unit
    parameter OutputValue: OutputType = ();

    default output: event OutputType;

    // Minimum delay between two output events.
    parameter MinimumDelay: Std.Duration = "PT1S";

    // Start of the minimum delay after an output, cleared when the delay ends
    // without another output. None or lost monotonic time allows output now.
    state last_output_at: Option[Timer.MonotonicTime] = None;
    // If this is not None, there is a pending change.
    state pending_event: Option[boolean] = None;

    node output_time: Timer.MonotonicTimestamp {}
    node delay: Timer.DurationElapsed { Duration: MinimumDelay }
    connect last_output_at.old -> delay;

    procedure update
      depends on default input as input, Feedback,
        pending_event.old as pending_event_old,
        last_output_at.old as last_output_at_old, delay
      produces default output as output, emitted: event unit, pending_event
    {
      // Clock loss drops a stale pending change, but a fresh command wins.
      let lost = last_output_at_old.IsSome && delay.IsNone;
      let mut pending = if optional(input).IsSome {
        optional(input)
      } else if lost {
        None
      } else {
        pending_event_old
      };
      // Ignore commands without feedback, or when the requested state matches.
      if Feedback.IsNone || pending == Feedback { pending = None; }
      let fire = pending.IsSome && delay != Some(false);
      pending_event = if fire { None } else { pending };
      // Consuming a pending change guards delayed output without a fresh input.
      on input, changed pending_event {
        if fire {
          emit output(OutputValue);
          emit emitted;
        }
      }
    }
    connect update.emitted -> output_time;

    procedure record
      depends on output_time, last_output_at.old as last_output_at_old, delay
      produces last_output_at
    {
      last_output_at = if optional(output_time).IsSome {
        optional(output_time)
      } else if delay == Some(false) {
        // Keep the running delay even when no command is pending.
        last_output_at_old
      } else {
        // Clear an expired or lost timer when no new output starts a delay.
        None
      };
    }
  }
}
