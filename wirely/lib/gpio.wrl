namespace GPIO {
  native open enum type ActiveState: uint8 {
    High = 1,
    Low = 2,
  }

  native open enum type Drive: uint8 {
    PushPull = 1,
    OpenDrain = 2,
    OpenSource = 3,
  }

  native open enum type Bias: uint8 {
    AsIs = 1,
    Disable = 2,
    PullDown = 3,
    PullUp = 4,
  }

  #[Internal]
  resource type OutputState;

  // Set a GPIO based on a boolean value
  native node type Output {
    parameter ChipDeviceFile: String;
    #[Diagram.ShowValue]
    parameter Name: String;

    parameter ActiveState: GPIO.ActiveState = GPIO.ActiveState.High;
    parameter Drive: GPIO.Drive = GPIO.Drive.PushPull;
    parameter Bias: GPIO.Bias = GPIO.Bias.AsIs;

    binding state: resource OutputState;
    native initializer
      produces state as "state"
      uses ChipDeviceFile, Name, ActiveState, Drive, Bias;

    default input: value boolean;

    native procedure set_value stage output
      depends on state as "state", default input as "input";
  }

  // TODO: Add tri-state output where the value can be None which will cause the
  // GPIO to be configured as input?
}
