namespace Std {
  enum type EdgeType: uint8 {
    Rising = 1,
    Falling = 2,
    Both = 3,
  }

  #[Internal]
  struct type FormatParts {
    prefix: String,
    suffix: String,
    has_value: boolean,
  }
  #[Internal]
  native constant function ParseFormat(format: String, type: ValueType): FormatParts;

  node type Constant {
    parameter Type: ValueType;
    #[Diagram.ShowValue]
    parameter Value: Type;

    default output: value Type;

    native procedure run produces default output as "output" uses Value;
  }

  node type And {
    #[Unordered]
    default input: multi value boolean;
    default output: value boolean;

    procedure run
      depends on default input as input
      produces default output as output
    {
      let mut result = true;
      for value in input {
        result = result && value;
      }
      output = result;
    }
  }

  node type TwoStageValueForward {
    parameter Type: ValueType;

    default input: value Type;
    default output: value Type;

    temporary temp: Type;

    procedure run1 depends on default input as input produces temp {
      temp = input;
    }
    procedure run2 depends on temp produces default output as output {
      output = temp;
    }
  }

  node type DebugValuePrinter {
    parameter Type: ValueType;

    default input: value Type;

    native procedure run stage output depends on default input as "input";
  }

  node type DebugEventPrinter {
    parameter Type: ValueType;

    default input: event Type;

    native procedure run stage output depends on default input as "input";
  }

  node type WarnOnEvent {
    #[Diagram.ShowValue]
    parameter Format: String;
    parameter Type: ValueType = unit;

    constant format_parts: FormatParts = ParseFormat(Format, Type);

    default input: event Type;

    native procedure run stage output
      depends on default input as "input"
      uses format_parts;
  }

  #[Internal]
  resource type DebugValueSourceState;

  native node type DebugValueSource {
    parameter Type: ValueType;

    default output: value Type;

    resource state: DebugValueSourceState;
    native initializer produces state as "state" uses Type;

    native procedure run stage input
      depends on state as "state"
      produces default output as "output";
  }

  #[Internal]
  resource type DebugEventSourceState;

  native node type DebugEventSource {
    parameter Type: ValueType;

    default output: event Type;

    resource state: DebugEventSourceState;
    native initializer produces state as "state" uses Type;

    native procedure run stage input
      depends on state as "state"
      produces default output as "output";
  }

  node type OptionNone {
    parameter InnerType: ValueType;

    default output: value Option[InnerType];

    native procedure run produces default output as "output";
  }

  node type OptionSome {
    parameter InnerType: ValueType;

    default input: value InnerType;
    default output: value Option[InnerType];

    native procedure run
      depends on default input as "input"
      produces default output as "output";
  }

  node type OptionUnwrapOr {
    parameter InnerType: ValueType;
    // TODO: Should this be a parameter or an input? Use an input an allow
    // inputs to be specified as options?
    #[Diagram.ShowValue]
    parameter Default: InnerType;

    default input: value Option[InnerType];
    default output: value InnerType;

    native procedure run
      depends on default input as "input"
      produces default output as "output" uses Default;
  }

  node type OptionIsSome {
    parameter InnerType: ValueType;

    default input: value Option[InnerType];
    default output: value boolean;

    native procedure run
      depends on default input as "input"
      produces default output as "output";
  }

  node type OptionCreate {
    parameter InnerType: ValueType;

    input HasValue: value boolean;
    input Value: value InnerType;
    default output: value Option[InnerType];

    native procedure run
      depends on HasValue, Value
      produces default output as "output";
  }

  // TODO: Allow ignoring edges when the time is lost
  node type DetectEdge {
    // Currently only Falling is implemented.
    #[Diagram.ShowValue]
    parameter EdgeType: Std.EdgeType;

    default input: value boolean;
    // Contains the new value
    default output: event boolean;

    state last_value: Option[boolean] = None;

    native procedure run
      depends on last_value.old as "last_value_old", default input as "input"
      produces default output as "output", last_value uses EdgeType;
  }
}

namespace Duration {
  native function SaturatingAdd(a: Duration, b: Duration): Duration;
  native function SaturatingSub(a: Duration, b: Duration): Duration;
  native function SaturatingMul(duration: Duration, factor: uint32): Duration;
  native function CheckedAdd(a: Duration, b: Duration): Option[Duration];
  native function CheckedSub(a: Duration, b: Duration): Option[Duration];
  native function CheckedMul(duration: Duration, factor: uint32): Option[Duration];
  native function CheckedDiv(duration: Duration, divisor: uint32): Option[Duration];
  native function FromSecs(secs: uint32): Duration;
  native function FromMillis(millis: uint32): Duration;
  native function FromMicros(micros: uint32): Duration;
  native function FromNanos(nanos: uint64): Duration;
  native function AsSecs(duration: Duration): uint64;
  native function AsMillis(duration: Duration): uint64;
  native function AsMicros(duration: Duration): uint64;
  native function AsNanos(duration: Duration): uint64;
}

namespace MonotonicTime {
  native function SaturatingAdd(time: MonotonicTime, duration: Duration): MonotonicTime;
  native function SaturatingSub(time: MonotonicTime, duration: Duration): MonotonicTime;
  native function CheckedAdd(time: MonotonicTime, duration: Duration): Option[MonotonicTime];
  native function CheckedSub(time: MonotonicTime, duration: Duration): Option[MonotonicTime];
  native function CheckedDurationSince(time: MonotonicTime, earlier: MonotonicTime): Option[Duration];
  native function CheckedLess(a: MonotonicTime, b: MonotonicTime): Option[boolean];
}

namespace TimeOfDay {
  native function WrappingAdd(time: TimeOfDay, duration: Duration): TimeOfDay;
  native function WrappingSub(time: TimeOfDay, duration: Duration): TimeOfDay;
  native function DurationUntil(from: TimeOfDay, to: TimeOfDay): Duration;
}
