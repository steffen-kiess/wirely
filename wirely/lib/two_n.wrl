namespace TwoN {
  #[Internal]
  native constant function IsValidCode(code: string): boolean;

  #[Internal]
  native struct type Credentials {
    username: string,
    password: string,
  }
  #[Internal]
  native constant function ReadCredentials(filename: string): Credentials;

  resource type Device;

  node type Connection {
    parameter Host: string;
    parameter Port: uint16 = 443;
    parameter TLSA: List[string];
    parameter UsernamePasswordFile: string;

    constant credentials: Credentials = ReadCredentials(UsernamePasswordFile);

    default output: fixed Device;

    native initializer create
      reads Host, Port, TLSA, credentials
      writes default output as "device";
  }

  #[Internal]
  resource type KeyEventState;

  // Get an event whenever a key is pressed or released
  node type KeyEvent {
    #[Diagram.ShowValue]
    parameter Key: string;

    input Device: fixed Device;
    // True if the key is pressed, false if it released.
    default output: event boolean;

    binding state: fixed KeyEventState;
    native initializer create reads Device, Key writes state as "state";

    native procedure get_value stage input
      reads state as "state"
      writes default output as "output";
  }

  // Get the current state of a key
  //
  // Might be incorrect after startup if key is already pressed on startup.
  // TODO: When the connection is lost, this also should reset the value to
  // "False"
  node type KeyState {
    #[Diagram.ShowValue]
    parameter Key: string;
    // Timeout after which the key will be assumed to be released (because "2N
    // -> Calling -> Dialing -> Quick dial button functionality test" will
    // trigger a KeyPressed event but no KeyReleased event).
    parameter Timeout: Std.Duration = "PT30S";

    input Device: fixed Device;

    // True if the key is pressed, false otherwise.
    default output: value boolean;

    node key_event: KeyEvent { Key: Key }
    connect Device -> key_event.Device;

    // Start of the current press, or None while the key is released.
    state pressed_at: Option[Timer.MonotonicTime] = None;

    node event_time: Timer.MonotonicTimestamp { Type: boolean }
    connect key_event -> event_time;
    node timeout: Timer.DurationElapsed { Duration: Timeout }
    connect pressed_at.old -> timeout;
    node timeout_warning: Std.WarnOnEvent {
      Format: "TwoN.KeyState: Resetting key after timeout",
    }

    procedure get_value
      reads key_event, event_time, pressed_at.old as previous, timeout
      writes default output as output, pressed_at, timed_out: event unit
    {
      // A new press or release takes precedence over an expired timeout.
      pressed_at = if let Some(pressed) = optional(key_event) {
        if pressed { optional(event_time) } else { None }
      } else if timeout == Some(false) {
        previous
      } else {
        // A missing release event or lost monotonic time releases the key.
        None
      };
      output = pressed_at.IsSome;
      on changed pressed_at {
        if previous.IsSome && pressed_at.IsNone && optional(key_event).IsNone {
          emit timed_out;
        }
      }
    }
    connect get_value.timed_out -> timeout_warning;
  }

  #[Internal]
  resource type IOStateState;

  // Get the current state of an input or output
  // TODO: Regularly get the current value?
  node type IOState {
    #[Diagram.ShowValue]
    parameter Port: string;

    input Device: fixed Device;

    binding state: fixed IOStateState;
    native initializer create reads Device, Port writes state as "state";

    // True if the input/output is on, false otherwise.
    default output: value boolean;

    native procedure get_value stage input
      reads state as "state"
      writes default output as "output";
  }

  #[Internal]
  resource type SwitchStateState;

  // Get the current state of a switch
  // TODO: Regularly get the current value?
  node type SwitchState {
    #[Diagram.ShowValue]
    parameter SwitchNumber: int32;

    input Device: fixed Device;

    binding state: fixed SwitchStateState;
    native initializer create
      reads Device, SwitchNumber
      writes state as "state";

    // True if the switch is active, false otherwise.
    default output: value boolean;

    // TODO: Outputs for "locked" and "held"?

    native procedure get_value stage input
      reads state as "state"
      writes default output as "output";
  }

  #[Internal]
  resource type CodeEnteredEventState;

  node type CodeEnteredEvent {
    parameter Code: string;

    assert IsValidCode(Code), "Code must contain at most 15 ASCII digits";

    input Device: fixed Device;
    default output: event unit;

    binding state: fixed CodeEnteredEventState;
    native initializer create reads Device, Code writes state as "state";

    native procedure get_value stage input
      reads state as "state"
      writes default output as "output";
  }

  #[Internal]
  resource type OutputControlState;

  node type OutputControl {
    #[Diagram.ShowValue]
    parameter Port: string;

    input Device: fixed Device;

    binding state: fixed OutputControlState;
    native initializer create reads Device, Port writes state as "state";

    // True to turn the output is on, false to turn it off.
    default input: event boolean;

    native procedure send_value stage output
      reads state as "state", default input as "input";
  }

  // TODO: Block for setting output from value?

  // TODO: Block for setting switch from event? Also allow toggle? Also allow
  // lock/unlock/hold/release?
}
