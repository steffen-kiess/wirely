namespace TwoN {
resource type Device;

native node type Connection {
  parameter Host : String;
  parameter Port : uint16 = 443;
  parameter TLSA : List[String];
  parameter UsernamePasswordFile : String;

  implicit output : resource Device;
}

// Get an event whenever a key is pressed or released
native node type KeyEvent {
  parameter Key : String;

  input Device : resource Device;

  // True if the key is pressed, false if it released.
  implicit output : event boolean;

  native procedure get_value stage input produces implicit output as "output";
}

// Get the current state of a key
//
// Might be incorrect after startup if key is already pressed on startup.
// TODO: When the connection is lost, this also should reset the value to "False"
node type KeyState {
  parameter Key : String;
  // Timeout after which the key will be assumed to be released (because
  // "2N -> Calling -> Dialing -> Quick dial button functionality test" will
  // trigger a KeyPressed event but no KeyReleased event).
  parameter Timeout : Duration = "30s";

  input Device : resource Device;

  // True if the key is pressed, false otherwise.
  implicit output : value boolean;

  node key_event : KeyEvent(Key=Key);
  connect Device -> key_event.Device;

  // The current value which is kept if there is no new event
  state CurrentValue : boolean = false;

  // The next time at which the the state will be reset to False.
  // If this time is not comparable to the current time, the the state will be reset to False.
  state TimeoutTime : MonotonicTime = MonotonicTime.Invalid;

  node TimeoutReached : Time.MonotonicTimeReached;
  // TODO: Allow this?
  // connect TimeoutTime.old -> TimeoutReached;
  temporary TimeoutTimeOld : MonotonicTime;
  native procedure read_timeout_time
    depends on TimeoutTime.old as "timeout_time_old"
    produces TimeoutTimeOld;
  connect TimeoutTimeOld -> TimeoutReached;

  native procedure get_value
    depends on CurrentValue.old as "current_value_old", TimeoutTime.old as
      "timeout_time_old", key_event, TimeoutReached
    produces implicit output as "output", TimeoutTime, CurrentValue;
}

// Get the current state of an input or output
// TODO: Regularly get the current value?
native node type IOState {
  parameter Port : String;

  input Device : resource Device;

  // True if the input/output is on, false otherwise.
  implicit output : value boolean;

  native procedure get_value stage input produces implicit output as "output";
}

// Get the current state of a switch
// TODO: Regularly get the current value?
native node type SwitchState {
  parameter SwitchNumber : int32;

  input Device : resource Device;

  // True if the switch is active, false otherwise.
  implicit output : value boolean;

  // TODO: Outputs for "locked" and "held"?

  native procedure get_value stage input produces implicit output as "output";
}

native node type CodeEnteredEvent {
  parameter Code : String;

  input Device : resource Device;

  implicit output : event unit;

  native procedure get_value stage input produces implicit output as "output";
}

native node type OutputControl {
  parameter Port : String;

  input Device : resource Device;

  // True to turn the output is on, false to turn it off.
  implicit input : event boolean;

  native procedure send_value stage output depends on implicit input as "input";
}

// TODO: Block for setting output from value?

// TODO: Block for setting switch from event? Also allow toggle? Also allow lock/unlock/hold/release?
}
