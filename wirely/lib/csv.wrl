namespace CSV {
  #[Internal]
  native constant function SupportsType(type: type): boolean;

  #[Internal]
  resource type ValueWriterState;

  // Writes lines with:
  // - Current date / time
  // - Old value (or null (unquoted empty string) on startup / when value was
  //   None)
  // - New value (or null (unquoted empty string) on shutdown / when value is
  //   None)
  // Will open file for appending. Will periodically write lines (with old and
  // new value the same) if there are no changes.
  // TODO: Write a header? Probably not.
  // TODO: Make restarts clear? Should already be clear because null is written
  // on shutdown.
  native node type ValueWriter {
    parameter Type: type;
    #[Diagram.ShowValue]
    parameter Filename: string;

    assert SupportsType(Type), "Type must support CSV conversion";

    binding state: resource ValueWriterState;
    native initializer produces state as "state" uses Filename;
    // TODO: Make repeat interval configurable? Allow disabling repeat?

    default input: value Type;

    // Time of the last write. Repeat a nonempty value after one hour, or when
    // this time is absent or not comparable to the current time.
    state last_written_at: Option[Timer.MonotonicTime] = None;

    node repeat_elapsed: Timer.DurationElapsed { Duration: "PT1H" }
    connect last_written_at.old -> repeat_elapsed;

    native procedure run stage output
      depends on state as "state", last_written_at.old as "last_written_at_old",
        default input as "input", repeat_elapsed
      produces last_written_at uses Type;
  }

  // TODO: Add EventWriter
}
