node in: Std.DebugEventSource { Type: boolean }

node fb: Std.DebugValueSource { Type: Option[boolean] }

node trigger: Memory.ToggleFlipFlopTrigger {
  OutputType: boolean,
  OutputValue: true,
  MinimumDelay: "PT1S",
}
connect in -> trigger;
connect fb -> trigger.Feedback;

node prnt: Std.DebugEventPrinter { Type: boolean }
connect trigger -> prnt;
