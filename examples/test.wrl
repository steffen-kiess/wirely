// foo

/* foo * bar /*baz*/ */

/* a /*/ */ */

/* // /*/ */* */

/** /* */ **/
/* //* *// */

/*
*/

node type MyBlock {
  input x1: value boolean;
  input x2: event int32;
  output x3: event unit;
  output x4: value boolean;
  parameter i: uint8;

  node di: Std.DebugValueSource { Type: boolean }
  // connect x1 -> x4;
  connect di -> x4;
}

node type SingleDelay {
  default input: value boolean;
  default output: value boolean;

  state d1: boolean = false;
  connect default input -> d1;
  connect d1.old -> default output;
}

node type DoubleDelay {
  default input: value boolean;
  default output: value boolean;

  state d1: boolean = false;
  state d2: boolean = false;
  connect default input -> d1;
  connect d1.old -> d2;
  connect d2.old -> default output;
}

node inp1: Std.DebugValueSource { Type: boolean }
node inp2: Std.DebugValueSource { Type: boolean }

// node inp1_d : Std.DoubleDelay {}
// node inp1_d : Std.SingleDelay {}
state inp1_d: boolean = false;
connect inp1 -> inp1_d;

node inp2_d: Std.TwoStageValueForward { Type: boolean }
connect inp2 -> inp2_d;

node res: Std.And {}
connect inp1_d.old, inp2_d -> res;

node prnt: Std.DebugValuePrinter { Type: boolean }
connect res -> prnt;

node time_1: Schedule.TimeOfDayMinute {}
node prnt_time_1: Std.DebugValuePrinter { Type: TimeOfDay }
connect time_1 -> prnt_time_1;

node time_2: Schedule.TimeOfDayMinute {}
node prnt_time_2: Std.DebugValuePrinter { Type: TimeOfDay }
connect time_2 -> prnt_time_2;

node between_1: Schedule.IsInDailyInterval { Start: "10:33", End: "22:51" }
node prnt_between_1: Std.DebugValuePrinter { Type: boolean }
connect between_1 -> prnt_between_1;

node between_2: Schedule.IsInDailyInterval { Start: "22:52", End: "06:30" }
node prnt_between_2: Std.DebugValuePrinter { Type: boolean }
connect between_2 -> prnt_between_2;

node between_3: Schedule.IsInDailyInterval { Start: "23:50", End: "22:53" }
node prnt_between_3: Std.DebugValuePrinter { Type: boolean }
connect between_3 -> prnt_between_3;
