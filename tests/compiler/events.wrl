// Event dependencies in procedure bodies.
node type Events {
  parameter Type: type = uint8;
  input Press: event unit;
  input Values: multi event Type;
  input Changed: event Type;
  default output: value Type;
  procedure run
    reads Press as on, Values, empty: multi event Type,
      changed: event Type
    writes default output as output
  {
    let mut result: Type = 0;
    // Weak keywords name events and locals.
    on on {}
    on changed, on, { result = 2; }
    on changed {
      let event: Type = changed;
      result = event;
      #[Allow(RedundantOn)]
      on changed { result = changed; }
    }
    on changed, on {
      on changed { result = changed; }
    }
    let unit_value = on on {};
    on Values {}
    on empty { result = 1; }
    for item in Values {
      on item { result = Type.WrappingAdd(result, item); }
    }
    assert Values.Length == 2;
    output = result;
  }
  connect Changed -> run.changed;
}
node press: Std.DebugEventSource { Type: unit }
node value: Std.DebugEventSource { Type: uint8 }
node events: Events {}
connect press -> events.Press;
connect value, value -> events.Values;
connect value -> events.Changed;

// optional(e) reads an event as an option anywhere in a body.
node type Optionals {
  input A: event uint8;
  input B: event uint8;
  input Nested: event Option[uint8];
  input Values: multi event uint8;
  default output: value Option[uint8];
  procedure run
    reads A as a, B as b, Nested as nested, Values as values
    writes default output as output
  {
    let mut result: Option[uint8] = optional(a);
    on a, b {
      if let Some(value) = optional(b) { result = Some(value); }
    }
    on a {
      let same: Option[uint8] = optional(a);
      result = same;
    }
    for item in values {
      let item_value: Option[uint8] = optional(item);
      if item_value.IsSome { result = item_value; }
    }
    let twice: Option[Option[uint8]] = optional(nested);
    if let Some(inner) = twice { result = inner; }
    output = result;
  }
}
node nested: Std.DebugEventSource { Type: Option[uint8] }
node optionals: Optionals {}
connect value -> optionals.A;
connect value -> optionals.B;
connect nested -> optionals.Nested;
connect value, value -> optionals.Values;

// Emission expressions yield unit and event outputs need not be emitted.
node type EmitEvents {
  input Input: event uint8;
  input Press: event unit;
  output Value: event uint8;
  output Unit: event unit;
  output Optional: event uint8;
  output Nested: event Option[uint8];
  output Absent: event boolean;
  procedure run
    reads Input as input, Press as press
    writes Value as value, Unit as unit, Optional as option, Nested as nested,
      Absent as absent
  {
    on input {
      let result: unit = emit value(input);
      emit? option(Some(input));
      emit nested(None)
    }
    on press { emit unit(()) }
  }
}
node emitted: EmitEvents {}
connect value -> emitted.Input;
connect press -> emitted.Press;

// Mutually exclusive branches share an emission opportunity.
node type EmitBranches {
  input Input: event boolean;
  default output: event uint8;
  procedure run reads Input as input writes default output as output {
    on input {
      if input { emit output(1); } else { emit? output(Some(2)); }
    }
  }
}
node flag: Std.DebugEventSource { Type: boolean }
node branches: EmitBranches {}
connect flag -> branches.Input;

// emit remains usable as an identifier, including an emission target.
node type EmitKeyword {
  input Input: event unit;
  default output: event unit;
  procedure run reads Input as input writes default output as emit {
    on input { emit emit; }
  }
  procedure names {
    let mut emit = 1;
    emit = 2;
    assert { let emit = Some(1); emit.IsSome };
  }
}
node keyword: EmitKeyword {}
connect press -> keyword.Input;

namespace EmitKeywordCalls {
  native function emit(value: uint8): uint8;
  node type Check {
    assert true || emit(1) == 1;
  }
}
node check_emit_call: EmitKeywordCalls.Check {}

namespace EmitKeywordStruct {
  struct type emit {
    value: uint8,
  }
  node type Check {
    constant Value: emit = emit { value: 1 };
    assert Value.value == 1;
  }
}
node check_emit_struct: EmitKeywordStruct.Check {}
