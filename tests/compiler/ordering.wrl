constant Low: int16 = -3;
assert Low < 0 && 0 > Low && !(Low < Low);
assert Low <= -3 && -3 <= Low && Low >= -3 && !(Low > -3);
assert !(0 <= Low) && !(Low >= 0);
assert 1 < 2 && 2 > 1 && 2 <= 2 && 2 >= 2;

constant Max: uint64 = 18446744073709551615;
assert Max > 0 && 18446744073709551614 < Max;

constant At: Schedule.TimeOfDay = "08:00";
constant Before: Schedule.TimeOfDay = "07:59";
constant LateTime: Schedule.TimeOfDay = "23:59";
constant Midnight: Schedule.TimeOfDay = "00:00";
assert Before < At && At < "08:01" && At <= "08:00" && LateTime >= At;
assert !(At > "08:00") && !(Midnight > At);

constant Span: Std.Duration = "PT1M";
constant Longer: Std.Duration = "PT61S";
assert Span > "PT59S" && Longer > Span && Span >= "PT60S" && !(Span < "PT1M");

constant Late: boolean = if At >= "08:00" { true } else { false };
assert Late;
assert (Low < 0) == true;
