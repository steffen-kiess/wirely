constant Morning: Schedule.TimeOfDay = "08:00";
constant EndOfDay: Schedule.TimeOfDay = "24:00";
constant Midnight: Schedule.TimeOfDay = "00:00";

// Parsing forms and 2^-64 s resolution.
assert Morning == "08:00:00" && Morning == "08:00:00.000000000";
constant Last: Schedule.TimeOfDay = "23:59:59.99999999999999999995";
constant Tiny: Schedule.TimeOfDay = "00:00:00.00000000000000000005";
assert Tiny > Midnight && Last < EndOfDay;

// Fractions round to the nearest unit; times before 24:00 stay before it.
assert "08:00:00.00000000000000000002" == Morning;
assert "23:59:59.99999999999999999999" == Last;
assert EndOfDay == "24:00:00" && EndOfDay == "24:00:00.0";

// 24:00 is distinct from 00:00 and ordered after all other times.
assert EndOfDay != Midnight && EndOfDay > "23:59:59.999999999";

// Whole days leave a time unchanged; other results wrap below 24:00.
assert Schedule.TimeOfDay.WrappingAdd(Morning, "PT2H30M") == "10:30";
assert Schedule.TimeOfDay.WrappingAdd("23:00", "PT2H") == "01:00";
assert Schedule.TimeOfDay.WrappingAdd("23:00", "PT1H") == Midnight;
assert Schedule.TimeOfDay.WrappingAdd(EndOfDay, "PT1H") == "01:00";
assert Schedule.TimeOfDay.WrappingAdd(Morning, "P2D") == Morning;
assert Schedule.TimeOfDay.WrappingAdd(EndOfDay, "PT0S") == EndOfDay;
assert Schedule.TimeOfDay.WrappingAdd(EndOfDay, "P1D") == EndOfDay;
assert Schedule.TimeOfDay.WrappingSub(EndOfDay, "P2D") == EndOfDay;
assert Schedule.TimeOfDay.WrappingSub(Midnight, "PT0S") == Midnight;
assert Schedule.TimeOfDay.WrappingAdd("23:00", "P1DT1H") == Midnight;
assert Schedule.TimeOfDay.WrappingSub("01:00", "PT2H") == "23:00";
assert Schedule.TimeOfDay.WrappingSub(EndOfDay, "PT1H") == "23:00";
assert Schedule.TimeOfDay.WrappingSub(Midnight, "PT0.000000001S") == "23:59:59.999999999";

// DurationUntil goes forward from the first time to the second.
assert Schedule.TimeOfDay.DurationUntil(Morning, Morning) == "PT0S";
assert Schedule.TimeOfDay.DurationUntil(Morning, "10:30") == "PT2H30M";
assert Schedule.TimeOfDay.DurationUntil("23:00", "01:00") == "PT2H";
assert Schedule.TimeOfDay.DurationUntil(Midnight, EndOfDay) == "PT24H";
assert Schedule.TimeOfDay.DurationUntil(EndOfDay, Midnight) == "PT0S";
assert Schedule.TimeOfDay.DurationUntil(EndOfDay, EndOfDay) == "PT0S";
assert Schedule.TimeOfDay.DurationUntil("23:00", EndOfDay) == "PT1H";
