node source: Std.Constant {
  #![Diagram.Position(X = 120, Y = -40.5)]
  Type: boolean,
  Value: true,
}
node sink: Std.And {}
connect source -> sink;

node type Metadata {
  #[Diagram.ShowValue]
  parameter Value: boolean = true;
  assert Value;
}
#[Diagram.Position(X = -0x2a, Y = +0o52)]
node positioned: Metadata {}
node inner: Metadata {
  #![Diagram.Position(X = 1.5, Y = -2)]
}
node type Positioned {
  #[Diagram.Position(X = 0, Y = 0)]
  parameter Initial: boolean = true;
  #[Diagram.Position(X = 0, Y = 1)]
  constant Inverted: boolean = !Initial;
  #[Diagram.Position(X = 1, Y = 0)]
  default output: value boolean;
  #[Internal]
  #[Diagram.Position(X = 2, Y = 0)]
  state previous: boolean = Initial;
  #[Diagram.Position(X = 3, Y = 0)]
  binding current: value boolean;

  #[Diagram.Position(X = 4, Y = 0)]
  procedure run reads previous.old as old writes current { current = !old; }
  connect current -> previous;
  connect current -> default output;
}
node positioned_type: Positioned {}

node type AllOf {
  #[Unordered]
  default input: multi value boolean;
  default output: value boolean;
  node all: Std.And {}
  connect default input -> all;
  connect all -> default output;
}
node all_of: AllOf {}
connect source, source -> all_of;

node type Sized {
  #![Diagram.DefaultWidth = 10]
  #![Diagram.DefaultHeight = 6.5]
  #[Diagram.ShowValue]
  #[Diagram.Width = 4]
  parameter Label: string = "sized";
  #[Diagram.Row = 2]
  input Enable: value boolean;
  #[Diagram.Row = 0]
  default input: value boolean;
  #[Diagram.Row = 2]
  output Enabled: value boolean;
  #[Diagram.Height = 3]
  state last: boolean = false;
  connect Enable -> Enabled;
  connect default input -> last;
}
#[Diagram.Width = 12.5]
node sized: Sized {
  #![Diagram.Height = 9]
}
connect source -> sized;
connect source -> sized.Enable;

#[Internal]
namespace Implementation {
  #[Internal]
  resource type Handle;

  #[Internal]
  struct type Record {
    #[Internal]
    enabled: boolean,
  }

  open enum type Mode: uint8 {
    #![Internal]
    #[Internal]
    On = 1,
  }
}

#[Internal]
constant Enabled: Implementation.Record =
  Implementation.Record { enabled: true };
namespace InnerImplementation {
  #![Internal]
  node type Empty {}
}
node inner_namespace: InnerImplementation.Empty {}
assert Enabled == Implementation.Record { enabled: true };
assert Implementation.Mode.On == Implementation.Mode.On;
assert KNX.ParseGroupAddress("1/2/3") == 2563;
assert MQTT.SupportsType(boolean);

#[Internal]
node type InternalForward {
  #[Internal]
  parameter Initial: boolean = true;
  #[Internal]
  default input: value boolean;
  #[Internal]
  default output: value boolean;
  #[Internal]
  state previous: boolean = Initial;
  #[Internal]
  binding forwarded: value boolean;

  procedure forward
    reads default input as input
    writes forwarded as output
  {
    output = input;
  }
  procedure remember
    reads forwarded as input
    writes previous, default output as output
  {
    previous = input;
    output = input;
  }
}
node type InnerType {
  #![Internal]
  node impl: InternalForward {}
  node input: Std.Constant { Type: boolean, Value: true }
  connect input -> impl;
}
#[Internal]
node internal_forward: InternalForward {}
connect source -> internal_forward;
node inner_internal: InnerType { #![Internal] }

struct type InnerRecord {
  #![Internal]
  enabled: boolean,
}
#[Internal]
open enum type OuterMode: uint8 {
  On = 1,
}
assert InnerRecord { enabled: true } == InnerRecord { enabled: true };
assert OuterMode.On == OuterMode.On;

#[JSON]
closed enum type JSONMode {
  #[JSON.Name = "standby"]
  Standby,
  Active,
}
open enum type JSONOpenMode: uint8 {
  #![JSON]
  #[JSON.Name = ""]
  Off = 0,
  On = 3,
}
#[JSON]
struct type JSONRecord {
  #[JSON.Name = "mode"]
  Mode: JSONMode,
  Count: uint8,
}
struct type JSONEmpty {
  #![JSON]
}
closed enum type PlainMode {
  Off,
}
#[JSON]
native open enum type NativeJSONMode as "TestLibrary.JSONMode": uint8 {
  #[JSON.Name = "off"]
  Off = 0,
}
#[JSON]
native struct type NativeJSONRecord as "TestLibrary.JSONRecord" {
  #[JSON.Name = "count"]
  Count: uint8,
}
#[JSON]
opaque struct type OpaqueJSONRecord as "TestLibrary.OpaqueJSONRecord" {
  #[JSON.Name = "count"]
  Count: uint8,
}
assert JSONMode.Standby != JSONMode.Active;
assert JSONRecord { Mode: JSONMode.Standby, Count: 3 }.Count == 3;
assert MQTT.SupportsType(JSONMode);
assert MQTT.SupportsType(JSONOpenMode);
assert !MQTT.SupportsType(PlainMode);
assert !MQTT.SupportsType(Std.EdgeType);
assert !MQTT.SupportsType(JSONRecord);
