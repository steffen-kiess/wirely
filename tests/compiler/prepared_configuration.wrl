assert MQTT.SupportsType(boolean);
assert !MQTT.SupportsType(Option[uint16]) && !MQTT.SupportsType(Timer.MonotonicTime);
assert MQTT.ParseTemplate(None)
  == MQTT.TemplateParts { prefix: "", suffix: "" };
assert MQTT.ParseTemplate(Some("%s"))
  == MQTT.TemplateParts { prefix: "", suffix: "" };
assert MQTT.ParseTemplate(Some("[%% %s %%]"))
  == MQTT.TemplateParts { prefix: "[% ", suffix: " %]" };
assert MQTT.ParseTemplate(Some(r#"{"quoted":"%s", "value":%s}"#))
  == MQTT.TemplateParts {
    prefix: r#"{"quoted":"%s", "value":"#,
    suffix: "}",
  };
assert MQTT.CheckURI("mqtt://localhost") && MQTT.CheckURI("mqtts://host:1234")
  && MQTT.CheckURI("mqtt+unix:///run/mosquitto/socket");
assert MQTT.CheckKeepAlive("PT0.1S") && MQTT.CheckKeepAlive("PT65535S");
assert MQTT.CheckClientID(None) && MQTT.CheckClientID(Some("wirely"));
assert MQTT.CheckTopic("a") && MQTT.CheckTopic("home/living room/$temperature");
assert KNX.CheckConnection(
  Some("localhost"), Some(KNX.Protocol.TCP), Some(1234), None, None, Some("1.1.1"),
);
assert KNX.CheckConnection(None, None, None, Some("/run/knxnet"), None, None);
assert KNX.CheckConnection(
  None, Some(KNX.Protocol.Unix), None, None, Some("user@host"), Some("4660"),
);
assert KNX.CheckConnection(None, Some(KNX.Protocol.Auto), None, None, None, None);

assert Std.ParseFormat("text", unit)
  == Std.FormatParts { prefix: "text", suffix: "", has_value: false };
assert Std.ParseFormat("a{}b", boolean)
  == Std.FormatParts { prefix: "a", suffix: "b", has_value: true };
assert Std.ParseFormat("{}", uint8)
  == Std.FormatParts { prefix: "", suffix: "", has_value: true };
assert Std.ParseFormat("{{x}} {} }}{{", boolean)
  == Std.FormatParts { prefix: "{x} ", suffix: " }{", has_value: true };

assert MQTT.TemplateParts { prefix: "a", suffix: "b" }
  != MQTT.TemplateParts { prefix: "a", suffix: "c" };
