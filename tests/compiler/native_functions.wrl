constant Wrapped: TimeOfDay = TimeOfDay.WrappingAdd("23:30", "PT1H");
constant Expected: TimeOfDay = "00:30";
assert Wrapped == Expected;
// Untaken branches and unused types do not evaluate failing calls.
constant Selected: uint16 = if true { 1 } else {
  KNX.ParseGroupAddress("bad")
};
assert Selected == 1;
assert true || { let unused: uint16 = KNX.ParseGroupAddress("bad"); false };
assert !(false && {
  let unused: uint16 = KNX.ParseGroupAddress("bad"); true
});
node type Unused {
  constant Address: uint16 = KNX.ParseGroupAddress("bad");
}
