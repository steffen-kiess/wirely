namespace Fixture {
  namespace Deep {
    namespace Level {
      node type Empty {
      }
    }
  }
}

node instance: Fixture.Deep.Level.Empty {}

namespace Fixture {
  node type TopLevel {
  }
}

namespace Fixture.Deep.Level {
  node type AddedWithDottedName {
  }
}

namespace Fixture.Inner {
  node type First {
  }
}

namespace Fixture {
  namespace Inner {
    node type Second {
    }
  }
}

namespace Empty {
}

namespace Empty {
}

node top_level: Fixture.TopLevel {}
node dotted: Fixture.Deep.Level.AddedWithDottedName {}
node first: Fixture.Inner.First {}
node second: Fixture.Inner.Second {}

// A namespace can share its name with a struct or enum type in the same scope.
namespace Pair {
  struct type Inner {
    value: uint8,
  }
}
struct type Pair {
  left: uint8,
}
closed enum type Mode {
  On,
  Off,
}
namespace Mode {
  node type Probe {
  }
}

constant First: Pair = Pair { left: 1 };
constant Second: Pair.Inner = Pair.Inner { value: 2 };
assert First.left == 1 && Second.value == 2 && Mode.On != Mode.Off;
node probe: Mode.Probe {}
