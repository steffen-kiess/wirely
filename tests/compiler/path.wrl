assert Path.Join("base", "child") == "base/child";
assert Path.Join("base", "../child") == "base/../child";
assert Path.Join("", "child") == "child";
assert Path.Join("base", "") == "base/";
assert Path.Join("", "") == "";
assert Path.Join("relative", "/missing/child") == "/missing/child";
assert Path.Parent("file.txt") == ".";
assert Path.Parent("base/../child") == "base/..";
assert Path.Parent("") == ".";
assert Path.Parent("base/child/") == "base";
assert Path.Parent("nonexistent/directory/file") == "nonexistent/directory";
assert Path.Parent("/") == "/";
constant Source: string = Path.SourceFile();
assert Source == Path.Join(Path.Parent(Source), "path.wrl");
node type Defaults {
  parameter Location: string = Path.SourceFile();
  parameter Expected: string;
  assert Location == Expected;
}
node defaults: Defaults { Expected: Path.SourceFile() }
node explicit: Defaults { Location: Path.SourceFile(), Expected: Source }
