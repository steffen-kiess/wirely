assert Later;
constant Later: boolean = true;
constant r#assert: boolean = true;
assert r#assert, "raw identifier";

assert { assert true; } == ();
assert {
  let mut amount: uint8 = 1;
  assert amount == 1;
  assert { amount = 2; true };
  assert amount == 2, "assertions preserve mutation order";
  { assert amount == 2; }
  let r#assert = amount == 2;
  assert r#assert, r#"a "quoted" message"#;
  amount == 2
};

procedure compile_only {
  assert true;
  let mut text: string = "before";
  assert text == "before";
  { text = "after"; assert text == "after"; }
  assert text == "after";
  if true { assert true; } else { assert false; }
  true || { assert false; false };
  false && { assert false; true };
}

procedure iterate reads values: multi value boolean {
  for value in values { assert true; }
}

node type BlockChecked {
  parameter Type: type;
  parameter Value: Type;
  parameter Expected: Type;
  parameter Default: Type = { assert Value == Expected; Value };
  constant Checked: Type = {
    let value: Type = Default;
    assert value == Expected;
    value
  };
  assert Checked == Expected;
  procedure check {
    assert Value == Expected;
    let value: Type = Checked;
    assert value == Expected;
  }
}
node integer: BlockChecked { Type: uint8, Value: 3, Expected: 3 }
node text: BlockChecked { Type: string, Value: "hello", Expected: "hello" }

node type Checked {
  assert Default == Selected;
  assert {
    let expected: int16 = 12;
    if Enabled { Selected == expected } else { Selected == 0 }
  }, r#"selected value"#;
  parameter Enabled: boolean;
  parameter Default: int16 = Selected;
  constant Selected: int16 = if Enabled { Later } else { 0 };
  constant Later: int16 = 12;
}

node type Parent {
  parameter Enabled: boolean = true;
  assert Enabled;
  node child: Checked { Enabled: Enabled }
}

singleton node type Shared {
  assert Flag;
  constant Flag: boolean = true;
}

node type Unused {
  assert false;
}

node enabled: Checked { Enabled: true }
node disabled: Checked { Enabled: false }
node nested: Parent {}
node shared: Shared {}
node repeated: Shared {}
