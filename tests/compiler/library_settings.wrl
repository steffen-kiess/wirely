node input: Std.DebugValueSource { Type: boolean, Initial: false }
node rising: Std.DetectEdge { EdgeType: Std.EdgeType.Rising }
node falling: Std.DetectEdge { EdgeType: Std.EdgeType.Falling }
node both: Std.DetectEdge { EdgeType: Std.EdgeType.Both }
connect input -> rising;
connect input -> falling;
connect input -> both;
node type GPIOSettings {
  default input: value boolean;
  parameter Active: GPIO.ActiveState;
  parameter Drive: GPIO.Drive;
  parameter Bias: GPIO.Bias;
  node output: GPIO.Output {
    ChipDeviceFile: "/dev/unused", Name: "LED",
    ActiveState: Active, Drive: Drive, Bias: Bias,
  }
  connect default input -> output;
}
node gpio_default: GPIO.Output { ChipDeviceFile: "/dev/unused", Name: "LED" }
connect input -> gpio_default;
node gpio_high: GPIOSettings {
  Active: GPIO.ActiveState.High, Drive: GPIO.Drive.PushPull, Bias: GPIO.Bias.AsIs,
}
node gpio_low: GPIOSettings {
  Active: GPIO.ActiveState.Low, Drive: GPIO.Drive.OpenDrain, Bias: GPIO.Bias.Disable,
}
node gpio_source: GPIOSettings {
  Active: GPIO.ActiveState.High,
  Drive: GPIO.Drive.OpenSource,
  Bias: GPIO.Bias.PullDown,
}
node gpio_pullup: GPIOSettings {
  Active: GPIO.ActiveState.High, Drive: GPIO.Drive.PushPull, Bias: GPIO.Bias.PullUp,
}
assert CSV.SupportsType(boolean) && CSV.SupportsType(uint16);
assert CSV.SupportsType(Option[boolean]);
assert !CSV.SupportsType(List[uint8]) && !CSV.SupportsType(string);
node interval: Schedule.IsInDailyInterval { Start: "08:00", End: "12:00" }
node overnight: Schedule.IsInDailyInterval { Start: "22:00", End: "06:00" }
node trigger_default: Schedule.TriggerAt { Time: "12:00" }
node trigger_unit: Schedule.TriggerAt { Time: "12:00", OutputType: unit, OutputValue: () }
node trigger_number: Schedule.TriggerAt { Time: "12:00", OutputType: uint16, OutputValue: 42 }
node trigger_option: Schedule.TriggerAt {
  Time: "12:00", OutputType: Option[boolean], OutputValue: None,
}

connect input -> gpio_high;
connect input -> gpio_low;
connect input -> gpio_source;
connect input -> gpio_pullup;

node type KNXSettings {
  optional parameter Protocol: KNX.Protocol;
  optional parameter Host: string;
  optional parameter UnixPath: string;
  node connection: KNX.Connection {
    Protocol?: optional(Protocol),
    Host?: optional(Host),
    UnixPath?: optional(UnixPath),
  }
}
node knx_tcp: KNXSettings { Protocol: KNX.Protocol.TCP, Host: "127.0.0.1" }
node knx_udp: KNXSettings { Protocol: KNX.Protocol.UDP, Host: "127.0.0.1" }
node knx_unix: KNXSettings { Protocol: KNX.Protocol.Unix }
node knx_auto: KNXSettings { Protocol: KNX.Protocol.Auto }
node knx_inferred: KNXSettings { UnixPath: "/unused" }

#[JSON]
closed enum type PublishEdge {
  Falling,
  Rising,
}

node type MQTTSettings {
  optional parameter Format: MQTT.Format;
  optional parameter Template: string;
  input Broker: fixed MQTT.Broker;
  default input: value PublishEdge;
  node output: MQTT.ValueProvider {
    Topic: "unused", Type: PublishEdge,
    Format?: optional(Format),
    Template?: optional(Template),
  }
  connect Broker -> output.Broker;
  connect default input -> output;
}
node enum_input: Std.Constant { Type: PublishEdge, Value: PublishEdge.Falling }
node broker: MQTT.Connection { URI: "mqtt://localhost" }
node mqtt_omitted: MQTTSettings {}
node mqtt_default: MQTTSettings { Format: MQTT.Format.Default }
node mqtt_snake: MQTTSettings { Format: MQTT.Format.SnakeCase, Template: "%s" }
connect broker -> mqtt_omitted.Broker;
connect broker -> mqtt_default.Broker;
connect broker -> mqtt_snake.Broker;
connect enum_input -> mqtt_omitted;
connect enum_input -> mqtt_default;
connect enum_input -> mqtt_snake;
