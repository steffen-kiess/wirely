constant RootType: type = int16;
constant RootValue: RootType = RootLater;
constant RootLater: RootType = 12;
assert RootValue == 12;

struct type Settings {
  enabled: boolean,
  number: int16,
  at: Schedule.TimeOfDay,
}
node type Capture {
  parameter Value: int16;
  parameter Expected: int16;
  assert Value == Expected;
}
node type Select {
  parameter Enabled: boolean;
  parameter Expected: int16;
  parameter Default: SelectedType = Selected;
  constant SelectedType: type = int16;
  constant Selected: SelectedType = {
    let fallback: int16 = 0;
    if Enabled { Later } else { fallback }
  };
  constant Later: int16 = 12;
  constant Items: List[Option[int16]] = [Some(Selected), None];
  constant Pair: Settings = {
    let at: Schedule.TimeOfDay = "23:30";
    Settings {
      enabled: Enabled,
      number: Selected,
      at: Schedule.TimeOfDay.WrappingAdd(at, "PT1H"),
    }
  };
  constant ExpectedAt: Schedule.TimeOfDay = "00:30";
  assert Selected == Expected && Default == Expected;
  assert Items == [Some(Expected), None];
  assert Pair == Settings { enabled: Enabled, number: Expected, at: ExpectedAt };
  node child: Capture { Value: Default, Expected: Expected }
}
node type Forward {
  constant Flag: boolean = false;
  node child: Select { Enabled: Flag, Expected: 0 }
}
node enabled: Select { Enabled: true, Expected: 12 }
node disabled: Select { Enabled: false, Expected: 0 }
node nested: Forward {}

singleton node type Shared {
  constant Type: type = boolean;
  constant Flag: Type = true;
  assert Flag;
}
node shared: Shared {}
node shared_again: Shared {}

node type Generic {
  parameter Type: type;
  parameter Expected: Type;
  constant Value: Type = { let number: uint8 = 7; Some([number, 8]) };
  assert Value == Expected;
}
node generic: Generic { Type: Option[List[uint8]], Expected: Some([7, 8]) }
node type TypedList {
  constant Type: type = List[Option[int16]];
  constant Items: Type = { let number: int16 = 12; [Some(number), None] };
  assert Items == [Some(12), None];
}
node typed_list: TypedList {}
node type TypeValue {
  parameter Type: type;
  constant Value: Type = uint8;
  assert Value == uint8;
}
node type_value: TypeValue { Type: type }
node type BooleanExpression {
  parameter Type: type;
  parameter Value: Type;
  parameter Enabled: boolean = !Value;
  parameter Matches: boolean = Value == Value;
  assert Enabled && Matches;
}
node expression: BooleanExpression { Type: boolean, Value: false }

// Namespace and root constants are visible in nested scopes.
namespace Limits {
  constant Doubled: int16 = Base * 2;
  constant Base: int16 = 21;
  constant Corner: Settings = Settings { enabled: true, number: Base, at: "06:00" };
  constant Kind: type = int16;

  node type Check {
    parameter Value: Kind = Doubled;
    assert Value == 42 && Limits.Base == 21;
  }
}
namespace Limits.Inner {
  constant Tripled: int16 = Base * 3;
}
assert Limits.Doubled == 42 && Limits.Inner.Tripled == 63;
assert Limits.Corner.number == 21 && Limits.Corner.enabled;
node check: Limits.Check {}
node kind: Std.Constant { Type: Limits.Kind, Value: Limits.Base }

constant RootOffset: int16 = RootLater + 1;
optional parameter RootOption: boolean;
constant RootOptionValue: Option[boolean] = optional(RootOption);
node type UsesRoot {
  constant Copy: RootType = RootOffset;
  constant RootValue: int16 = 1;
  assert Copy == 13 && RootOptionValue == None;
  // A node type's own constants shadow root constants.
  assert RootValue == 1;
  default output: value int16;
  procedure run writes default output as output {
    output = RootOffset + Limits.Base;
  }
}
node uses_root: UsesRoot {}
