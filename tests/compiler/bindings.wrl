node type ValueBinding {
  parameter Type: type = uint8;
  default input: value Type;
  default output: value Type;
  binding binding: value Type;
  procedure copy reads default input as input writes binding {
    binding = input;
  }
  connect binding -> default output;
}
node source: Std.Constant { Type: uint8, Value: 7 }
node forwarded: ValueBinding {}
connect source -> forwarded;

// Resource bindings share the one-source connection rules.
resource type Handle;
node type ResourceBinding {
  default input: fixed Handle;
  default output: fixed Handle;
  binding service: fixed Handle;
  connect default input -> service;
  connect service -> default output;
}

// Event bindings retain their kind through reference ports and alias chains.
node type EventBinding {
  parameter Type: type = uint8;
  default input: event Type;
  default output: event Type;
  binding first: event Type;
  binding second: event Type;
  binding produced: event Type;
  connect default input -> first;
  connect first -> second;
  procedure forward reads second as input writes produced as output {
    on input { emit output(input); }
  }
  connect produced -> default output;
}
node event_source: Std.DebugEventSource { Type: uint8 }
node event_forwarded: EventBinding {}
connect event_source -> event_forwarded;
