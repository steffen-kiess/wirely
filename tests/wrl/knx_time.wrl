node bus: KNX.Connection {
  UnixPath: Test.ReplaceKNXPath("/run/knxnet"),
}

node trigger: Schedule.TriggerAt {
  Time: "08:00",
  OutputType: boolean,
  OutputValue: true,
}

node event_sender: KNX.EventSender { GroupAddress: "0/7/1", Type: boolean }
connect bus -> event_sender.Bus;
connect trigger -> event_sender;
