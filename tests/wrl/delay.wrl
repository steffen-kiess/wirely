node inp: Std.DebugValueSource { Type: boolean }
node prnt0: Std.DebugValuePrinter { Type: boolean }
connect inp -> prnt0;

state delay1: boolean = false;
connect inp -> delay1;
node prnt1: Std.DebugValuePrinter { Type: boolean }
connect delay1.old -> prnt1;

state delay2: boolean = false;
connect delay1.old -> delay2;
node prnt2: Std.DebugValuePrinter { Type: boolean }
connect delay2.old -> prnt2;
