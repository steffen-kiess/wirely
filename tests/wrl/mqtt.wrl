// TODO: Don't depend on the ordering of server / provider
node server: MQTT.Connection {
  URI: Test.ReplaceMQTTURI("mqtt://localhost"),
}

node provider_input: Std.DebugValueSource { Type: boolean, Initial: false }

node provider: MQTT.ValueProvider {
  Topic: "test/t1",
  Type: boolean,
  Format: MQTT.Format.Default,
}
connect provider_input -> provider;

// TODO: Allow this line to be above the declaration for server and provider and
// add tests for that
connect server -> provider.Broker;

node template_provider_input: Std.DebugValueSource { Type: boolean, Initial: false }

node template_provider: MQTT.ValueProvider {
  Topic: r"test/t1t",
  Type: boolean,
  Template: r#"{"value": %s, "other": "%s"}"#,
}
connect template_provider_input -> template_provider;

connect server -> template_provider.Broker;

node option_provider_input: Std.DebugValueSource { Type: Option[boolean], Initial: None }

node option_provider: MQTT.ValueOptionProvider {
  Topic: "test/t2",
  Type: boolean,
}
connect option_provider_input -> option_provider;

connect server -> option_provider.Broker;

node event_source: Std.DebugEventSource { Type: boolean }

node event_sender: MQTT.EventSender {
  Topic: "test/t3",
  Type: boolean,
  Format: MQTT.Format.Default,
}
connect event_source -> event_sender;

connect server -> event_sender.Broker;

node number_event_source: Std.DebugEventSource { Type: uint8 }

node number_event_sender: MQTT.EventSender {
  Topic: "test/t4",
  Type: uint8,
}
connect number_event_source -> number_event_sender;

connect server -> number_event_sender.Broker;

node enum_event_source: Std.DebugEventSource { Type: ThermostatSystemModeEnum }

node enum_event_sender: MQTT.EventSender {
  Topic: "test/t5",
  Type: ThermostatSystemModeEnum,
  Format: MQTT.Format.SnakeCase,
}
connect enum_event_source -> enum_event_sender;

connect server -> enum_event_sender.Broker;

node template_event_source: Std.DebugEventSource {
  Type: ThermostatSystemModeEnum,
}

node template_event_sender: MQTT.EventSender {
  Topic: "test/t5",
  Type: ThermostatSystemModeEnum,
  Format: MQTT.Format.SnakeCase,
  Template: "{\"value\": %s, \"other\": \"%s\"}",
}
connect template_event_source -> template_event_sender;

connect server -> template_event_sender.Broker;

node event_receiver: MQTT.EventReceiver {
  Topic: "test/t6",
  Type: boolean,
  Format: MQTT.Format.Default,
}
connect server -> event_receiver.Broker;

node event_receiver_prnt: Std.DebugEventPrinter { Type: boolean }
connect event_receiver -> event_receiver_prnt;

node template_event_receiver: MQTT.EventReceiver {
  Topic: "test/t7",
  Type: boolean,
  Template: r#"{"value": %s, "other": "%s"}"#,
}
connect server -> template_event_receiver.Broker;

node template_event_receiver_prnt: Std.DebugEventPrinter { Type: boolean }
connect template_event_receiver -> template_event_receiver_prnt;

node template_value_receiver: MQTT.ValueReceiver {
  Topic: "test/t8",
  Type: boolean,
  Template: r#"{"value": %s, "other": "%s"}"#,
}
connect server -> template_value_receiver.Broker;

node template_value_receiver_prnt: Std.DebugValuePrinter { Type: Option[boolean] }
connect template_value_receiver -> template_value_receiver_prnt;
