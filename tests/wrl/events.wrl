// Procedure bodies read events inside on blocks.
node press: Std.DebugEventSource { Type: unit }
node number: Std.DebugEventSource { Type: uint8 }
node first: Std.DebugEventSource { Type: uint8 }
node second: Std.DebugEventSource { Type: uint8 }

state toggled: boolean = false;
state last: Option[uint8] = None;
state count: uint8 = 0;
state both: Option[uint8] = None;
state total: uint8 = 0;
state any_steps: uint8 = 0;

procedure toggle
  depends on press, toggled.old as previous
  produces toggled
{
  let mut next = previous;
  on press { next = !previous; }
  toggled = next;
}

procedure remember
  depends on number, last.old as previous
  produces last
{
  let mut next = previous;
  on number { next = Some(number); }
  last = next;
}

procedure count_either
  depends on first, second, count.old as previous
  produces count
{
  let mut next = previous;
  on first, second { next = uint8.WrappingAdd(previous, 1); }
  count = next;
}

procedure add_both
  depends on first, second, both.old as previous
  produces both
{
  let mut sum = previous;
  on first {
    #[Allow(CoincidentTriggers)]
    on second { sum = Some(uint8.WrappingAdd(first, second)); }
  }
  both = sum;
}

procedure add_all
  depends on values: multi event uint8, total.old as previous_total,
    any_steps.old as previous_steps
  produces total, any_steps
{
  let mut next = previous_total;
  for value in values {
    on value { next = uint8.WrappingAdd(next, value); }
  }
  total = next;
  let mut steps = previous_steps;
  on values { steps = uint8.WrappingAdd(previous_steps, 1); }
  any_steps = steps;
}
connect first, second -> add_all.values;

// The payload of second, else of first, else the previous value.
state latest: uint8 = 0;
procedure keep_latest
  depends on first, second, latest.old as previous
  produces latest
{
  latest = optional(second).UnwrapOr(optional(first).UnwrapOr(previous));
}

// Forward, filter, and merge events without retaining them in state.
node type Emissions {
  input Number: event uint8;
  input Press: event unit;
  input Values: multi event uint8;
  output payload: event uint8;
  output unit: event unit;
  output constant: event uint8;
  output filtered: event uint8;
  output nested: event Option[uint8];
  output absent: event unit;
  output merged: event uint8;
  output persistent: event unit;
  #[Allow(UnguardedEvent)]
  procedure always produces persistent { emit persistent; }
  procedure run
    depends on Number as number, Press as press, Values as values
    produces payload, unit, constant, filtered, nested, absent, merged
  {
    on number {
      emit payload(number);
      emit constant(42);
      emit? filtered(if number == 0 { None } else { Some(number) });
      emit nested(if number == 0 { None } else { Some(number) });
    }
    on press { emit unit }
    on values {
      let mut result: Option[uint8] = None;
      for item in values {
        on item { result = Some(item); }
      }
      emit? merged(result);
    }
  }
}
node forward: Emissions {}
connect number -> forward.Number;
connect press -> forward.Press;
connect first, second -> forward.Values;
