node in: Std.DebugEventSource { Type: boolean }
node feedback: Std.DebugValueSource { Type: Option[boolean], Initial: None }

node trigger: Memory.ToggleFlipFlopTrigger {}
connect in -> trigger;
connect feedback -> trigger.Feedback;

node debug_printer: Std.DebugEventPrinter { Type: unit }
connect trigger -> debug_printer;
