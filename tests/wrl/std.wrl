node c0: Std.Constant { Type: boolean, Value: true }

// TODO: Support unary minus
// node c1 : Std.Constant { Type: int16, Value: -1000 }
node c1: Std.Constant { Type: int16, Value: 1000 }

node in: Std.DebugValueSource { Type: boolean }

node edge: Std.DetectEdge { EdgeType: Std.EdgeType.Falling }
connect in -> edge;
node rising: Std.DetectEdge { EdgeType: Std.EdgeType.Rising }
connect in -> rising;
node both: Std.DetectEdge { EdgeType: Std.EdgeType.Both }
connect in -> both;

node initial_true: Std.DebugValueSource { Type: boolean }
node initial_falling: Std.DetectEdge { EdgeType: Std.EdgeType.Falling }
connect initial_true -> initial_falling;
node initial_rising: Std.DetectEdge { EdgeType: Std.EdgeType.Rising }
connect initial_true -> initial_rising;
node initial_both: Std.DetectEdge { EdgeType: Std.EdgeType.Both }
connect initial_true -> initial_both;

node unit_events: Std.DebugEventSource { Type: unit }
node w_unit: Std.WarnOnEvent { Format: "Unit warning" }
connect unit_events -> w_unit;

node bool_events: Std.DebugEventSource { Type: boolean }
node w_bool: Std.WarnOnEvent { Format: "Bool warning {}!", Type: boolean }
connect bool_events -> w_bool;

node edge_events: Std.DebugEventSource { Type: Std.EdgeType }
node w_edge: Std.WarnOnEvent { Format: "Edge {}", Type: Std.EdgeType }
connect edge_events -> w_edge;
