// TEST: literal-initialized procedure local is runtime
#[Allow(Unused)] binding result: value uint8;
procedure run produces result {
  let value: uint8 = 1;
  result = value + 1; // E: Arithmetic operators are compile-time only
}

// TEST: later output assignment makes the block runtime
#[Allow(Unused)] binding result: value boolean;
procedure run produces result {
  {
    let text: String = "hello"; // E: `String` is parameter-only
    result = text == "hello";
  }
}

// TEST: later outer local assignment makes the nested block runtime
#[Allow(Unused)] binding result: value boolean;
procedure run produces result {
  let mut value = false;
  {
    let text: String = "hello"; // E: `String` is parameter-only
    value = true;
  }
  result = value;
}

// TEST: outer runtime local read makes the nested block runtime
#[Allow(Unused)] binding result: value boolean;
procedure run produces result {
  let value = true;
  result = {
    let text: String = "hello"; // E: `String` is parameter-only
    text == "hello" && value
  };
}

// TEST: unreachable runtime dependency still makes the body runtime
procedure run depends on input: value boolean {
  let text: String = "hello"; // E: `String` is parameter-only
  if false { input; }
}
constant InputValue: boolean = true;
connect InputValue -> run.input;

// TEST: runtime conditional cannot produce a string
#[Allow(Unused)] binding result: value boolean;
procedure run depends on input: value boolean produces result {
  result = (if input { "a" } else { "b" }) == "a";
  // ^E: `String` is parameter-only
}
constant InputValue: boolean = true;
connect InputValue -> run.input;

// TEST: failing constant in runtime-controlled branch
#[Allow(Unused)] binding result: value uint8;
procedure run depends on input: value boolean produces result {
  result = if input { 1 / 0 } else { 1 }; // E: Division by zero
}
constant InputValue: boolean = false;
connect InputValue -> run.input;

// TEST: failing constant in runtime short-circuit operand
#[Allow(Unused)] binding result: value boolean;
procedure run depends on input: value boolean produces result {
  result = input && (1 / 0 == 1); // E: Division by zero
}
constant InputValue: boolean = false;
connect InputValue -> run.input;

// TEST: failing constant in result-free body
procedure run {
  let invalid: uint8 = 1 / 0; // E: Division by zero
}

// TEST: compile-time function with runtime arguments
// LIBRARIES: std, schedule
#[Allow(Unused)] binding result: value boolean;
procedure run depends on input: value Schedule.TimeOfDay produces result {
  result = Schedule.IsValidDailyInterval(input, "09:00");
  // ^E: is a compile-time function and requires constant arguments
}
constant InputValue: Schedule.TimeOfDay = "08:00";
connect InputValue -> run.input;
