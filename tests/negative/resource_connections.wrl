// TEST: resource_mismatch
namespace Fixture {
  resource type First;
  resource type Second;

  node type Source {
    default output: fixed First; // H: Source was declared here
  }

  node type Target {
    input Service: fixed Second; // H: Target was declared here
  }
}
node source: Fixture.Source {}
node target: Fixture.Target {}
connect source -> target.Service; // E: source has resource type `Fixture.First` but target has resource type `Fixture.Second`

// TEST: resource_same_name_mismatch
namespace First {
  resource type Handle;
}

namespace Second {
  resource type Handle;
}

node type Source {
  default output: fixed First.Handle; // H: Source was declared here
}

node type Target {
  default input: fixed Second.Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: source has resource type `First.Handle` but target has resource type `Second.Handle`

// TEST: resource_boundary_mismatch
resource type First;
resource type Second;

node type Invalid {
  input Service: fixed First; // H: Source was declared here
  default output: fixed Second; // H: Target was declared here
  connect Service -> default output; // E: source has resource type `First` but target has resource type `Second`
}

// TEST: resource_to_data_value
resource type Handle;

node type Source {
  default output: fixed Handle; // H: Source was declared here
}

node type Target {
  default input: value boolean; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect fixed and value or event ports

// TEST: data_to_resource_value
resource type Handle;

node type Source {
  default output: value boolean; // H: Source was declared here
}

node type Target {
  default input: fixed Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect fixed and value or event ports

// TEST: resource_to_data_event
resource type Handle;

node type Source {
  default output: fixed Handle; // H: Source was declared here
}

node type Target {
  default input: event boolean; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect fixed and value or event ports

// TEST: data_to_resource_event
resource type Handle;

node type Source {
  default output: event boolean; // H: Source was declared here
}

node type Target {
  default input: fixed Handle; // H: Target was declared here
}
node source: Source {}
node target: Target {}
connect source -> target; // E: Cannot connect fixed and value or event ports

// TEST: circular native initialization
// LIBRARIES:
namespace Std {
  resource type Service;
  node type DebugValueSource {
    input Service: fixed Service;
    default output: fixed Service;
    native initializer create reads Service writes default output as "service";
    // ^E: Circular native initializer dependency
  }
}
node first: Std.DebugValueSource {}
node second: Std.DebugValueSource {}
connect first -> second.Service; // H: Cycle continues here
connect second -> first.Service; // H: Cycle continues here

// TEST: circular resource forwarding
// LIBRARIES:
resource type Service;
node type Forward {
  input Service: fixed Service;
  default output: fixed Service;
  connect Service -> default output; // H: Cycle continues here
}
namespace Std {
  node type DebugValueSource {
    input Service: fixed Service;
    native initializer create reads Service;
  }
}
node first: Forward {}
node second: Forward {}
node sink: Std.DebugValueSource {}
connect first -> second.Service; // H: Cycle continues here
connect second -> first.Service; // E: Circular connection
connect first -> sink.Service;

// TEST: missing native resource provider
// LIBRARIES:
resource type Service;
node type Missing {
  default output: fixed Service; // H: Fixed output was declared here
}
namespace Std {
  node type DebugValueSource {
    input Service: fixed Service;
    native initializer create reads Service;
    // ^E: Fixed input is not written by an initializer
  }
}
node source: Missing {}
node sink: Std.DebugValueSource {}
connect source -> sink.Service;
