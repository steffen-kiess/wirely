// LIBRARIES: std, knx, mqtt, path, schedule, timer, two_n

// TEST: invalid KNX address
constant Address: uint16 = KNX.ParseGroupAddress("invalid");
// ^E: Invalid format for KNX group address

// TEST: unsupported KNX mapping
constant Name: string = KNX.ValueTypeName(string);
// ^E: Unsupported type for KNX

// TEST: unsupported KNX value type
assert KNX.SupportsValueType(string), "Unsupported value type for KNX";
// ^E: Compile-time assertion failed: Unsupported value type for KNX

// TEST: unsupported MQTT JSON type
assert MQTT.SupportsType(Timer.MonotonicTime), "Unsupported type for MQTT";
// ^E: Compile-time assertion failed: Unsupported type for MQTT

// TEST: missing MQTT placeholder
constant Parts: MQTT.TemplateParts = MQTT.ParseTemplate(Some("text"));
// ^E: Got template string without %s

// TEST: quoted MQTT placeholder
constant Parts: MQTT.TemplateParts = MQTT.ParseTemplate(Some("\"%s\""));
// ^E: Got template string without %s

// TEST: repeated MQTT placeholder
constant Parts: MQTT.TemplateParts = MQTT.ParseTemplate(Some("%s%s"));
// ^E: Found multiple %s in template string

// TEST: trailing percent
constant Parts: MQTT.TemplateParts = MQTT.ParseTemplate(Some("%s%"));
// ^E: Found lone % at end of string

// TEST: invalid MQTT escape
constant Parts: MQTT.TemplateParts = MQTT.ParseTemplate(Some("%x"));
// ^E: Unexpected sequence in template string

// TEST: missing format placeholder
constant Parts: Std.FormatParts = Std.ParseFormat("text", boolean);
// ^E: Format without {} for type `boolean`

// TEST: format placeholder for unit
constant Parts: Std.FormatParts = Std.ParseFormat("{}", unit);
// ^E: Format with {} for unit type

// TEST: repeated format placeholder
constant Parts: Std.FormatParts = Std.ParseFormat("{}{}", boolean);
// ^E: Found multiple {} in format string

// TEST: format argument
constant Parts: Std.FormatParts = Std.ParseFormat("{0}", boolean);
// ^E: Found { without } in format string

// TEST: trailing format brace
constant Parts: Std.FormatParts = Std.ParseFormat("{}{", boolean);
// ^E: Found { without } in format string

// TEST: lone closing format brace
constant Parts: Std.FormatParts = Std.ParseFormat("{}}", boolean);
// ^E: Found } without { in format string

// TEST: relative credential path
constant Credentials: TwoN.Credentials = TwoN.ReadCredentials("relative");
// ^E: UsernamePasswordFile must be absolute

// TEST: invalid group address 1/2/3/4
constant Address: uint16 = KNX.ParseGroupAddress("1/2/3/4");
// ^E: Invalid format for KNX group address

// TEST: invalid group address 1/2/256
constant Address: uint16 = KNX.ParseGroupAddress("1/2/256");
// ^E: Sub group out of range

// TEST: invalid group address 32/0/0
constant Address: uint16 = KNX.ParseGroupAddress("32/0/0");
// ^E: Main group out of range

// TEST: invalid group address 1/2048
constant Address: uint16 = KNX.ParseGroupAddress("1/2048");
// ^E: Sub group out of range

// TEST: invalid group address 65536
constant Address: uint16 = KNX.ParseGroupAddress("65536");
// ^E: Address out of range

// TEST: invalid middle group
constant Address: uint16 = KNX.ParseGroupAddress("1/8/0");
// ^E: Middle group out of range

// TEST: negative group address
constant Address: uint16 = KNX.ParseGroupAddress("-1");
// ^E: Invalid format for KNX group address

// TEST: empty group address
constant Address: uint16 = KNX.ParseGroupAddress("");
// ^E: Invalid format for KNX group address

// TEST: leading space
constant Address: uint16 = KNX.ParseGroupAddress(" 1");
// ^E: Invalid format for KNX group address

// TEST: trailing space
constant Address: uint16 = KNX.ParseGroupAddress("1 ");
// ^E: Invalid format for KNX group address

// TEST: signed group address
constant Address: uint16 = KNX.ParseGroupAddress("+1");
// ^E: Invalid format for KNX group address

// TEST: empty middle group
constant Address: uint16 = KNX.ParseGroupAddress("1//2");
// ^E: Invalid format for KNX group address

// TEST: trailing slash
constant Address: uint16 = KNX.ParseGroupAddress("1/2/");
// ^E: Invalid format for KNX group address

// TEST: three-digit main group
constant Address: uint16 = KNX.ParseGroupAddress("001/2/3");
// ^E: Invalid format for KNX group address
