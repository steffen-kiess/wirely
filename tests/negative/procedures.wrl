// LIBRARIES: std

// TEST: duplicate result
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    output = true;
    output = false; // E: assigned more than once
  }
}
node probe: Probe {  }

// TEST: result read
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    output = output; // E: not definitely initialized
  }
}
node probe: Probe {  }

// TEST: local assignment
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let value = true;
    value = false; // E: assigned more than once
    output = value;
  }
}
node probe: Probe {  }

// TEST: unknown input
node type Probe {
  default input: value boolean;
  default output: value boolean;
  procedure run writes default output as output {
    output = input; // E: Unknown procedure value
  }
}
node probe: Probe {  }
node source: Std.Constant { Type: boolean, Value: true }
connect source -> probe;

// TEST: inferred string
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let time = "08:00"; // E: parameter-only
    output = true;
  }
}
node probe: Probe {  }

// TEST: out of range
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let number: uint8 = 256; // E: out of range
    output = true;
  }
}
node probe: Probe {  }

// TEST: wrong Boolean operand
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    output = !7; // E: Invalid boolean
  }
}
node probe: Probe {  }

// TEST: different branches
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    output = if true { true } else { 7 }; // E: Invalid boolean
  }
}
node probe: Probe {  }

// TEST: protected result name
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let output = true; // E: Cannot shadow
    output = true;
  }
}
node probe: Probe {  }

// TEST: protected parameter name
node type Probe {
  parameter Enabled: boolean = true;
  default output: value boolean;
  procedure run writes default output as output {
    let Enabled = true; // E: Cannot shadow
    output = true;
  }
}
node probe: Probe {  }

// TEST: parameter-only value
node type Probe {
  parameter Text: string = "text";
  default output: value boolean;
  procedure run writes default output as output {
    let value = Text; // E: `string` is parameter-only
    output = true;
  }
}
node probe: Probe {  }

// TEST: compile-time function result in a runtime local
// LIBRARIES: std, path
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let path: string = Path.Parent("file"); // E: `string` is parameter-only
    output = true;
  }
}
node probe: Probe {  }

// TEST: branch local scope
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let value = if true { let inside = true; inside } else { false };
    output = inside; // E: Unknown procedure value
  }
}
node probe: Probe {  }

// TEST: different integer types
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let number: uint8 = 7;
    let other: int32 = 7;
    output = number == other; // E: Expected value of type `uint8`
  }
}
node probe: Probe {  }

// TEST: loop
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    while true {} // E: Syntax error
    output = true;
  }
}
node probe: Probe {  }

// TEST: mutable local type mismatch
node type Probe {

  default output: value boolean;
  procedure run writes default output as output {
    let mut value = true;
    value = 1; // E: Invalid boolean
    output = value;
  }
}
node probe: Probe {  }

// TEST: missing result
node type Probe {
  default output: value boolean;
  procedure run writes default output as output {} // E: did not assign outputs
}
node probe: Probe {}

// TEST: string port alias
node type Probe {
  default output: value boolean;
  procedure run writes default output as "output" { // E: aliases must be identifiers
    output = true;
  }
}
node probe: Probe {}

// TEST: typed port key
node type Probe {
  procedure run writes result as "output": value boolean { // E: Typed port keys require a native procedure
    result = true;
  }
}
node probe: Probe {}

// TEST: colliding port names
node type Probe {
  default input: value boolean;
  default output: value boolean;
  procedure run reads default input as same writes default output as same { // E: names must be distinct
    same = true;
  }
}
node source: Std.Constant { Type: boolean, Value: true }
node probe: Probe {}
connect source -> probe;

// TEST: input assignment
node type Probe {
  default input: value boolean;
  default output: value boolean;
  procedure run reads default input as input writes default output as output {
    input = false; // E: expected a local variable or output
    output = input;
  }
}
node source: Std.Constant { Type: boolean, Value: true }
node probe: Probe {}
connect source -> probe;

// TEST: event output
node type Probe {
  default output: event boolean;
  procedure run writes default output as output { output = true; } // E: Cannot assign event output
}
node probe: Probe {}

// TEST: resource input
resource type Service;
node type Provider {
  default output: fixed Service;
  native initializer create writes default output as "service";
}
node type Probe {
  input ServiceInput: fixed Service;
  default output: value boolean;
  procedure run reads ServiceInput // E: Procedure bodies cannot read resources
    writes default output as output { output = true; }
}
node provider: Provider {}
node probe: Probe {}
connect provider -> probe.ServiceInput;

// TEST: old state must be declared
node type Probe {
  state saved: boolean = false;
  procedure write writes saved { saved = true; }
  default output: value boolean;
  procedure run writes default output as output {
    output = saved.old; // E: Unknown procedure value
  }
}
node probe: Probe {}

// TEST: input stage restriction
node type Probe {
  default input: value boolean;
  default output: value boolean;
  procedure run stage input reads default input as input // E: declared as input stage
  // ^H: Reads declared here
    writes default output as output { output = input; }
}
node probe: Probe {}

// TEST: cycle
// SH: Cycle continues here
// SH: Cycle continues here
// SE: Circular procedure dependency
// SH: Cycle continues here
node type Probe {
  binding first: value boolean;
  binding second: value boolean;
  procedure one reads second writes first { first = second; } // H: Cycle continues here // H: Cycle continues here
  procedure two reads first writes second { second = first; } // E: Circular procedure dependency // H: Cycle continues here
}
node probe: Probe {}

// TEST: resource output
resource type Service;
node type Probe {
  output ServiceOutput: fixed Service;
  procedure run writes ServiceOutput {} // E: Only load procedures can write fixed values
}
node probe: Probe {}

// TEST: result assignment with mismatched branch types
node type Probe {
  default output: value boolean;
  procedure run writes default output as output {
    let value = if true { output = true; } else { false }; // E: Invalid unit
    output = value;
  }
}
node probe: Probe {}

// TEST: compile-time generic Boolean operand
node type Probe {
  parameter Type: type;
  parameter Value: Type;
  parameter Enabled: boolean = !Value; // E: Expected value of type `boolean`
  default output: value boolean;
  procedure run writes default output as output { output = Enabled; }
}
node probe: Probe { Type: int32, Value: 7 }

// TEST: compile-time generic local annotation
node type Probe {
  parameter Type: type;
  parameter Value: Type;
  parameter Enabled: boolean = {
    let value: boolean = Value; // E: Expected value of type `boolean`
    value
  };
  default output: value boolean;
  procedure run writes default output as output { output = Enabled; }
}
node probe: Probe { Type: int32, Value: 7 }

// TEST: non-function in a compile-time branch
node type Probe {
  parameter Enabled: boolean = if true { 1() } else { false }; // E: Function is not a reference
  default output: value boolean;
  procedure run writes default output as output { output = Enabled; }
}
node probe: Probe {}

// TEST: top-level result type
#[Allow(Unused)] binding t: value int8;
procedure p1 writes t {
  t = 128; // E: out of range
}

// TEST: top-level missing assignment
#[Allow(Unused)] binding t: value int8;
procedure p1 writes t {} // E: did not assign outputs

// TEST: top-level dependency cycle
// SH: Cycle continues here
// SH: Cycle continues here
// SE: Circular procedure dependency
// SH: Cycle continues here
binding first: value boolean;
binding second: value boolean;
procedure one reads second writes first { first = second; } // H: Cycle continues here // H: Cycle continues here
procedure two reads first writes second { second = first; } // E: Circular procedure dependency // H: Cycle continues here

// TEST: dependency cycle through a child node
// SH: Cycle continues here
// SH: Cycle continues here
// SH: Cycle continues here
// SH: Cycle continues here
// SE: Circular procedure dependency
// SH: Cycle continues here
node type Relay {
  default input: value boolean;
  default output: value boolean;
  connect default input -> default output; // H: Cycle continues here
}
binding first: value boolean;
binding second: value boolean;
node relay: Relay {}
procedure one
  reads second // H: Cycle continues here
  writes first // H: Cycle continues here
{
  first = second;
}
connect first -> relay; // H: Cycle continues here
procedure two
  reads relay as value // E: Circular procedure dependency
  writes second // H: Cycle continues here
{
  second = value;
}

// TEST: top-level native procedure
native procedure p1; // E: Native procedures must belong to a node type

// TEST: Some argument count in a procedure
#[Allow(Unused)] binding result: value Option[boolean];
procedure run writes result {
  result = Some(true, false); // E: Some expects exactly one argument
}

// TEST: struct literal missing field in a procedure
struct type Pair { enabled: boolean, number: uint8, }
#[Allow(Unused)] binding result: value Pair;
procedure run writes result {
  result = Pair { enabled: true }; // E: Missing fields of `Pair`: `number`
}

// TEST: struct literal unknown field in a procedure
struct type Pair { enabled: boolean, }
#[Allow(Unused)] binding result: value Pair;
procedure run writes result {
  result = Pair { enabled: true, number: 1 }; // E: Unknown field `number` of `Pair`
}

// TEST: procedure reference to a reference port
node type References {
  default input: value boolean;
  binding copy: value boolean;
  procedure first
    reads default input as input
    writes copy as result
  {
    result = input;
  }
  procedure second
    reads first.result as value // E: Port `result` of procedure `first` is not a typed port
  {
  }
}

// TEST: root temporary without a source
binding unused: value boolean; // E: Binding `unused` has no source
