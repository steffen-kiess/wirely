// TEST: missing type
constant Missing = true; // E: Syntax error

// TEST: missing initializer
constant Missing: boolean; // E: Syntax error

// TEST: duplicate constants
// SH: Previous declaration was here
// SE: Duplicate constant name 'Flag'
constant Flag: boolean = true; // H: Previous declaration was here
constant Flag: boolean = false; // E: Duplicate constant name 'Flag'

// TEST: parameter followed by constant
// SH: Previous declaration was here
// SE: name 'Flag'
node type Unused {
  parameter Flag: boolean; // H: Previous declaration was here
  constant Flag: boolean = false; // E: Duplicate constant name 'Flag'
}

// TEST: constant followed by parameter
// SH: Previous declaration was here
// SE: name 'Flag'
node type Unused {
  constant Flag: boolean = false; // H: Previous declaration was here
  parameter Flag: boolean; // E: Duplicate parameter name 'Flag'
}

// TEST: override
node type Probe {
  constant Flag: boolean = true;
}
node probe: Probe { Flag: false } // E: Cannot override constant 'Flag'

// TEST: unknown name in unused node
node type Unused {
  constant Value: int16 = Unknown; // E: Invalid int value
}

// TEST: unknown type in unused node
node type Unused {
  constant Value: Unknown = 0; // E: Cannot find type Unknown
}

// TEST: wrong type in unused node
node type Unused {
  constant Flag: boolean = true;
  constant Value: int16 = Flag; // E: Expected value of type int16, got boolean
}

// TEST: out of range in unused node
node type Unused {
  constant Value: uint8 = 256; // E: out of range
}

// TEST: constant cycle
// SE: Cyclic static value resolution
// SH: While instantiating 'probe'
node type Probe {
  constant First: int16 = Second; // E: Cyclic static value resolution: First -> Second -> First
  constant Second: int16 = First;
}
node probe: Probe {} // H: While instantiating 'probe'

// TEST: mixed cycle
node type Probe {
  parameter First: int16 = Second; // E: Cyclic static value resolution: First -> Second -> First
  constant Second: int16 = First;
}
node probe: Probe {}

// TEST: type cycle
// SE: Cyclic static value resolution
// SH: While instantiating 'probe'
node type Probe {
  constant First: ValueType = Option[Second]; // E: Cyclic static value resolution: First -> Second -> First
  constant Second: ValueType = First;
}
node probe: Probe {} // H: While instantiating 'probe'

// TEST: type and initializer cycle
// SE: Cyclic static value resolution
// SH: While instantiating 'probe'
node type Probe {
  constant First: Second = 0;
  constant Second: ValueType = Second; // E: Cyclic static value resolution: First -> Second -> Second
}
node probe: Probe {} // H: While instantiating 'probe'

// TEST: procedure port collision
node type Probe {
  constant Flag: boolean = true;
  procedure run produces Flag: value boolean { // E: Procedure names must be distinct
    Flag = true;
  }
}
node probe: Probe {}

// TEST: local shadowing
node type Probe {
  constant Flag: boolean = true;
  default output: value boolean;
  procedure run produces default output as output {
    let Flag = false; // E: Cannot shadow procedure port or parameter 'Flag'
    output = Flag;
  }
}
node probe: Probe {}

// TEST: immutable
node type Probe {
  constant Flag: boolean = true;
  default output: value boolean;
  procedure run produces default output as output {
    Flag = false; // E: Cannot assign to 'Flag'
    output = Flag;
  }
}
node probe: Probe {}

// TEST: dependency without alias
node type Probe {
  constant Flag: boolean = true;
  default output: value boolean;
  procedure run depends on Flag produces default output as output { // E: Procedure names must be distinct
    output = Flag;
  }
}
node probe: Probe {}

// TEST: constant destination
node type Probe {
  constant Flag: boolean = true;
  binding flag: value boolean;
  procedure run produces Flag as flag { // E: Cannot connect to constant 'Flag'
    flag = true;
  }
}
node probe: Probe {}

// TEST: namespace constants deferred
namespace Example { // H: In this namespace
  constant Flag: boolean = true; // E: Declaration not allowed in namespace
}

// TEST: qualified constants deferred
node type Probe {
  constant Flag: boolean = true;
}
node probe: Probe {}
constant Flag: boolean = probe.Flag; // E: Invalid boolean value

// TEST: parameter dependent unknown name in unused node
node type Unused {
  parameter Type: ValueType;
  constant Value: Type = Missing; // E: Unknown static value Missing
}

// TEST: parameter dependent malformed expression in unused node
node type Unused {
  parameter Type: ValueType;
  constant Value: Type = if 7 { 0 } else { 1 }; // E: Invalid boolean value
}

// TEST: parameter dependent type mismatch
node type Probe {
  parameter Type: ValueType;
  constant Value: Type = true; // E: Invalid int value
}
node probe: Probe { Type: int16 } // H: While instantiating 'probe'

// TEST: parameter dependent range
node type Probe {
  parameter Type: ValueType;
  constant Value: Type = 256; // E: out of range
}
node probe: Probe { Type: uint8 } // H: While instantiating 'probe'

// TEST: enclosing constants are not child procedure names
constant Flag: boolean = true;
node type Probe {
  default output: value boolean;
  procedure run produces default output as output {
    output = Flag; // E: Unknown procedure value Flag
  }
}
node probe: Probe {}

// TEST: constant type in runtime port
node type Probe {
  constant Type: ValueType = String;
  default output: value Type;
  procedure run produces default output as output { output = "hello"; }
}
node probe: Probe {} // E: parameter-only

// TEST: constant type in root temporary
constant Type: ValueType = String;
#[Allow(Unused)] binding text: value Type; // E: parameter-only
procedure run produces text { text = "hello"; }

// TEST: constant type in root state
constant Type: ValueType = String;
state text: Type = "hello"; // E: parameter-only
procedure run produces text { text = "hello"; }
