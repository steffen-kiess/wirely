// LIBRARIES: std, schedule

// TEST: after the end of the day
constant Value: Schedule.TimeOfDay = "24:01"; // E: Invalid Schedule.TimeOfDay value '24:01'

// TEST: fraction after the end of the day
constant Value: Schedule.TimeOfDay = "24:00:00.1"; // E: Invalid Schedule.TimeOfDay value

// TEST: hour out of range
constant Value: Schedule.TimeOfDay = "25:00"; // E: Invalid Schedule.TimeOfDay value

// TEST: minute out of range
constant Value: Schedule.TimeOfDay = "08:60"; // E: Invalid Schedule.TimeOfDay value

// TEST: removed AddWrap
constant Value: Schedule.TimeOfDay = Schedule.TimeOfDay.AddWrap("08:00", "01:00"); // E: Type Schedule.TimeOfDay has no member 'AddWrap'

// TEST: adding times
constant Value: Schedule.TimeOfDay = "08:00" + "01:00"; // E: Integer arithmetic requires an integer value, got Schedule.TimeOfDay

// TEST: duration argument
constant Value: Schedule.TimeOfDay = Schedule.TimeOfDay.WrappingAdd("08:00", "01:00"); // E: Invalid Std.Duration value '01:00'
