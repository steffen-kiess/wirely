// LIBRARIES: std, schedule, timer, memory

// TEST: time boolean output value
node trigger: Schedule.TriggerAt {
  Time: "12:00",
  OutputType: boolean,
  OutputValue: 0, // E: Invalid boolean value
}

// TEST: memory integer output value
node trigger: Memory.ToggleFlipFlopTrigger {
  OutputType: uint16,
  OutputValue: false, // E: Invalid int value
}

// TEST: time option output value
node trigger: Schedule.TriggerAt {
  Time: "12:00",
  OutputType: Option[boolean],
  OutputValue: Some(1), // E: Invalid boolean value
}

// TEST: memory option output value
node trigger: Memory.ToggleFlipFlopTrigger {
  OutputType: Option[boolean],
  OutputValue: Some(1), // E: Invalid boolean value
}

// TEST: time forwarded output value type
node type Forward {
  optional parameter Value: uint16;
  node child: Schedule.TriggerAt {
    Time: "12:00",
    OutputType: boolean,
    OutputValue?: optional(Value),
    // ^E: Expected value of type `Option[boolean]`, got `Option[uint16]`
  }
}
node forward: Forward { Value: 0 }

// TEST: memory forwarded output value type
node type Forward {
  optional parameter Value: boolean;
  node child: Memory.ToggleFlipFlopTrigger {
    OutputType: uint16,
    OutputValue?: optional(Value),
    // ^E: Expected value of type `Option[uint16]`, got `Option[boolean]`
  }
}
node forward: Forward { Value: false }

// TEST: missing payload invariant
node type Output {
  parameter Type: type;
  optional parameter Value: Type;
  assert Type == unit || optional(Value).IsSome;
  // ^E: Compile-time assertion failed
}
node output: Output { Type: boolean } // H: While instantiating `output`

// TEST: unit default with missing non-unit payload
node type DefaultOutput {
  parameter Type: type = unit;
  parameter Value: Type = (); // E: Invalid boolean value
}
node output: DefaultOutput { Type: boolean }
