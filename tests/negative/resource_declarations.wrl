// TEST: resource_unknown
node type Client {
  input Service: resource Missing; // E: Cannot find resource type `Missing`
}

// TEST: resource_unknown_qualified
namespace Fixture {
  resource type Handle;
}

node type Invalid {
  input Service: resource Fixture.Missing; // E: Cannot find resource type `Fixture.Missing`
}

// TEST: resource_data_type
node type Invalid {
  input Service: resource boolean; // E: Cannot find resource type `boolean`
}

// TEST: resource_duplicate
// SH: Previous resource type was here
// SE: Duplicate resource type `Handle`
namespace Fixture {
  resource type Handle; // H: Previous resource type was here
}

namespace Fixture {
  resource type Handle; // E: Duplicate resource type `Handle`
}

// TEST: resource_inside_node
node type Container {
  resource type Handle; // E: Resource type declaration not allowed inside node type
}

// TEST: resource_node_collision
// SH: Previous
// SE: `Service` conflicts with
namespace Fixture {
  resource type Service; // H: Previous resource type was here
  node type Service {
  } // ^E: Node type `Service` conflicts with resource type
}

// TEST: node_resource_collision
// SH: Previous
// SE: `Service` conflicts with
namespace Fixture {
  node type Service {
  } // ^H: Previous node type was here
  resource type Service; // E: Resource type `Service` conflicts with node type
}

// TEST: resource_node_collision_reopened
// SH: Previous
// SE: `Service` conflicts with
namespace Fixture.Deep {
  resource type Service; // H: Previous resource type was here
}

namespace Fixture {
  namespace Deep {
    node type Service {
    } // ^E: Node type `Service` conflicts with resource type
  }
}

// TEST: node_resource_collision_reopened
// SH: Previous
// SE: `Service` conflicts with
namespace Fixture {
  namespace Deep {
    node type Service {
    } // ^H: Previous node type was here
  }
}

namespace Fixture.Deep {
  resource type Service; // E: Resource type `Service` conflicts with node type
}

// TEST: resource_node_collision_global
// SH: Previous
// SE: `Service` conflicts with
resource type Service; // H: Previous resource type was here
node type Service {
} // ^E: Node type `Service` conflicts with resource type

// TEST: node_resource_collision_global
// SH: Previous
// SE: `Service` conflicts with
node type Service {
} // ^H: Previous node type was here
resource type Service; // E: Resource type `Service` conflicts with node type

// TEST: resource_list_output
resource type Handle;

node type Invalid {
  default output: multi resource Handle; // E: Got multi specifier for non-input
}

// TEST: legacy_knx_bus_syntax
node type Legacy {
  default output: knx_bus; // E: Syntax error
}

// TEST: legacy_mqtt_server_syntax
node type Legacy {
  default output: mqtt_server; // E: Syntax error
}

// TEST: legacy_two_n_device_syntax
node type Legacy {
  default output: two_n_device; // E: Syntax error
}

// TEST: named_multi_resource_input_unused
resource type Handle;
node type Invalid {
  input Handles: multi resource Handle; // E: Multi resource inputs are not supported
}

// TEST: default_multi_resource_input_unused
resource type Handle;
node type Invalid {
  default input: multi resource Handle; // E: Multi resource inputs are not supported
}

// TEST: typed_multi_resource_procedure_unused
resource type Handle;
node type Invalid {
  native procedure run
    depends on handles: multi resource Handle; // E: Multi resource inputs are not supported
}

// TEST: typed_multi_resource_body_unused
resource type Handle;
node type Invalid {
  procedure run
    depends on handles: multi resource Handle // E: Multi resource inputs are not supported
  {}
}

// TEST: typed_multi_resource_initializer_unused
resource type Handle;
native node type Invalid {
  native initializer
    depends on handles: multi resource Handle; // E: Multi resource inputs are not supported
}

// TEST: typed_multi_resource_output
resource type Handle;
node type Invalid {
  native procedure run
    produces handles: multi resource Handle; // E: Got multi specifier for non-input
}

// TEST: resource_duplicate_native_name
// SH: Previous declaration was here
// SE: Duplicate native name `Fixture.Handle`
namespace Fixture {
  resource type Handle; // H: Previous declaration was here
  resource type Link as "Fixture.Handle"; // E: Duplicate native name `Fixture.Handle`
}

// TEST: local_resource_without_source
resource type Handle;
node type Invalid {
  binding state: resource Handle; // E: Binding `state` has no source
}

// TEST: local_resource_unknown_type
native node type Invalid {
  binding state: resource Missing; // E: Cannot find resource type `Missing`
  native initializer produces state as "state";
}

// TEST: local_resource_duplicate_name
// SH: Previous declaration was here
// SE: Duplicate name `state`
resource type Handle;
native node type Invalid {
  binding state: value boolean; // H: Previous declaration was here
  binding state: resource Handle; // E: Duplicate name `state`
  native initializer;
}

// TEST: local_resource_produced_twice
// SH: Previous output was here
// SE: Duplicate initializer output
resource type Handle;
native node type Invalid {
  binding state: resource Handle;
  native initializer produces state as "first", // H: Previous output was here
    state as "second"; // E: Duplicate initializer output
}

// TEST: local_resource_second_source
resource type Handle;
node type Invalid {
  input First: resource Handle;
  input Second: resource Handle;
  binding service: resource Handle;
  connect First -> service; // H: Previous connection was here
  connect Second -> service; // E: Binding `service` already has a source
}

// TEST: local_resource_produced_and_connected
resource type Handle;
native node type Invalid {
  input Service: resource Handle;
  binding state: resource Handle;
  native initializer produces state as "state"; // H: Produced by the native initializer here
  connect Service -> state; // E: Binding `state` is both produced and connected
}

// TEST: local_resource_cycle
// SH: Cycle continues here
// SE: Circular connection
resource type Handle;
node type Invalid {
  binding first: resource Handle;
  binding second: resource Handle;
  connect first -> second; // H: Cycle continues here
  connect second -> first; // E: Circular connection
}

// TEST: local_resource_initializer_dependency
resource type Handle;
native node type Invalid {
  binding state: resource Handle;
  native initializer depends on state as "input" // E: Circular native initializer dependency
    produces state as "state";
}
node invalid: Invalid {}

// TEST: local_resource_procedure_output
resource type Handle;
native node type Invalid {
  binding state: resource Handle;
  native initializer produces state as "state";
  native procedure run produces state as "state"; // E: Procedures cannot produce resources
}

// TEST: local_resource_port
resource type Handle;
native node type Invalid {
  binding state: resource Handle;
  native initializer produces state as "state";
  native procedure run depends on state.value as "state"; // E: Binding `state` has no port `value`
}
