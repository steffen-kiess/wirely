// TEST: initializer_outside_node_type
native initializer create; // E: Native initializers must belong to a node type

// TEST: initializer_namespace
namespace Invalid { // H: In this namespace
  native initializer create; // E: Declaration not allowed in namespace
}

// TEST: initializer_duplicate
// SH: Previous initializer was here
// SE: Only one initializer per node type is supported
node type Invalid {
  native initializer create; // H: Previous initializer was here
  native initializer create; // E: Only one initializer per node type is supported
}

// TEST: initializer_value_dependency
node type Invalid {
  input Value: value boolean;
  native initializer create reads Value; // E: Initializer reads must be fixed values or compile-time values
}

// TEST: initializer_state_dependency
node type Invalid {
  state count: uint8 = 0;
  native procedure write writes count;
  native initializer create reads count.old as "old"; // E: Initializer reads must be fixed values or compile-time values
}

// TEST: initializer_unknown_dependency
node type Invalid {
  native initializer create reads Missing; // E: `Missing` is not a port, parameter, or constant; compile-time expressions in reads clauses require an alias
}

// TEST: initializer_implicit_alias
resource type Handle;
node type Invalid {
  default input: fixed Handle;
  native initializer create reads default input; // E: Default ports and complex references require an explicit alias
}

// TEST: initializer_complex_alias
resource type Handle;
node type Source {
  output Handle: fixed Handle;
}
node type Invalid {
  node source: Source {}
  native initializer create reads source.Handle; // E: Default ports and complex references require an explicit alias
}

// TEST: initializer_duplicate_key
// SH: Previous port was here
// SE: Duplicate port name
resource type Handle;
node type Invalid {
  input Service: fixed Handle;
  native initializer create
    reads Service, // H: Previous port was here
      Service; // E: Duplicate port name
}

// TEST: initializer_duplicate_decoded_alias
// SH: Previous port was here
// SE: Duplicate port name
resource type Handle;
node type Invalid {
  input First: fixed Handle;
  input Second: fixed Handle;
  native initializer create
    reads First as "Service", // H: Previous port was here
      Second as "\x53ervice"; // E: Duplicate port name
}

// TEST: initializer_value_output
node type Invalid {
  default output: value boolean;
  native initializer create writes default output as "value"; // E: Initializer writes must be fixed outputs or fixed bindings of the node type
}

// TEST: initializer_typed_output
resource type Handle;
node type Invalid {
  native initializer create writes Service: fixed Handle; // E: Initializer writes must reference fixed outputs
}

// TEST: initializer_implicit_output_alias
resource type Handle;
node type Invalid {
  default output: fixed Handle;
  native initializer create writes default output; // E: Default ports and complex references require an explicit alias
}

// TEST: initializer_duplicate_output_key
// SH: Previous port was here
// SE: Duplicate port name
resource type Handle;
node type Invalid {
  output First: fixed Handle;
  output Second: fixed Handle;
  native initializer create
    writes First as "service", // H: Previous port was here
      Second as "service"; // E: Duplicate port name
}

// TEST: initializer_duplicate_output
// SH: Previous output was here
// SE: Duplicate initializer output
resource type Handle;
node type Invalid {
  default output: fixed Handle;
  native initializer create
    writes default output as "first", // H: Previous output was here
      default output as "second"; // E: Duplicate initializer output
}

// TEST: initializer_missing_output
resource type Handle;
node type Invalid {
  default output: fixed Handle;
  output Named: fixed Handle; // E: Output `Named` has no source
  native initializer create writes default output as "service";
}

// TEST: initializer_missing_default_output
resource type Handle;
node type Invalid {
  default output: fixed Handle; // E: Default output has no source
  native initializer create;
}

// TEST: initializer_produced_and_connected_output
resource type Handle;
node type Source {
  default output: fixed Handle;
  native initializer create writes default output as "service";
}
node type Invalid {
  default output: fixed Handle;
  node source: Source {}
  connect source -> default output; // E: Default output is both written and connected
  native initializer create writes default output as "service"; // H: Written by the native initializer here
}
