// LIBRARIES: std

// TEST: missing_state_phase
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved -> default output; // E: explicitly reference .old or .new
}

// TEST: state_without_source
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false; // E: State 'saved' has no source
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved.new -> default output;
}

// TEST: wrong_value_type
resource type Handle;
node type Sink {
  default input: value uint8; // H: Target was declared here
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false; // H: Source was declared here
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved.old -> sink; // E: source has type
}

// TEST: wrong_connection_kind
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean; // H: Target was declared here
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false; // H: Source was declared here
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved.old -> event_sink; // E: source has kind
}

// TEST: phase_on_temporary
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  binding temporary_value: value boolean;
  procedure write produces saved, temporary_value {
    saved = true;
    temporary_value = true;
  }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect temporary_value.old -> sink; // E: Binding 'temporary_value' has no output port 'old'
}

// TEST: unknown_state
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect missing.old -> sink; // E: Unable to find source node
}

// TEST: state_to_resource
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle; // H: Target was declared here
}
node type Invalid {
  state saved: boolean = false; // H: Source was declared here
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved.old -> resource_sink; // E: Cannot connect resource and data
}

// TEST: target_old_state
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect source -> saved.old; // E: State 'saved' has no input port
}

// TEST: nested_state_reference
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect child.saved.old -> sink; // E: unexpected number of identifiers
}

// TEST: target_new_state
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
