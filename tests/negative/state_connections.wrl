// TEST: unknown_state_phase
resource type Handle;
node type Sink {
  default input: value uint8;
}
node type EventSink {
  default input: event boolean;
}
node type ResourceSink {
  default input: resource Handle;
}
node type Invalid {
  state saved: boolean = false;
  procedure write produces saved { saved = true; }
  default output: value boolean;
  node sink: Sink {}
  node event_sink: EventSink {}
  node resource_sink: ResourceSink {}
  node source: Std.Constant { Type: boolean, Value: true }
  connect saved.other -> default output; // E: explicitly reference .old or .new
}

// TEST: same-step state cycle
state saved: boolean = false;
procedure advance depends on saved.new as current produces saved {
  saved = current;
} // ^^E: Circular procedure dependency

// TEST: later-stage state producer
state saved: boolean = false;
#[Allow(Unused)] binding current: value boolean;
procedure write stage output produces saved { saved = true; }
// ^H: Producer was declared here
procedure read depends on saved.new as value produces current {
  current = value;
} // ^^E: later execution stage

// TEST: state new value fed back
state saved: boolean = false;
connect saved.new -> saved; // E: Circular connection

// TEST: state new value fed back through a temporary
state saved: boolean = false;
binding current: value boolean;
connect saved.new -> current; // H: Cycle continues here
connect current -> saved; // E: Circular connection

// TEST: state new value fed back through a child node
node type Relay {
  default input: value boolean;
  default output: value boolean;
  connect default input -> default output; // H: Cycle continues here
}
node type Holder {
  default output: value boolean;
  state saved: boolean = false;
  node relay: Relay {}
  connect saved.new -> relay; // E: Circular connection
  connect relay -> saved; // H: Cycle continues here
  connect saved.old -> default output;
}
node holder: Holder {}
